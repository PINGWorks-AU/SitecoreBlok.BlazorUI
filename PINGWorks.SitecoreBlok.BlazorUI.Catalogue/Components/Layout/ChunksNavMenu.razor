@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services
@rendermode InteractiveServer

<nav class="w-60 shrink-0 border-r border-border bg-background h-screen sticky top-0 overflow-y-auto">
	<div class="px-4 h-14 flex items-center border-b border-border">
		<a href="/" class="text-base font-bold text-foreground no-underline tracking-tight">Blok Blazor</a>
	</div>

	<div class="px-3 py-4 space-y-1">
		<NavLink href="/" class="flex items-center rounded-md px-3 py-1.5 text-sm hover:bg-neutral-bg no-underline text-foreground" Match="NavLinkMatch.All">
			Home
		</NavLink>
		<NavLink href="/chunks" class="flex items-center rounded-md px-3 py-1.5 text-sm hover:bg-neutral-bg no-underline text-foreground" Match="NavLinkMatch.All">
			All chunks
		</NavLink>

		<div class="pt-2">
			<input type="search" placeholder="Filter chunks…" value="@Filter" @oninput="OnFilterInput"
				class="w-full rounded-md border border-border bg-background px-3 py-1.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring" />
		</div>

		@{
			var anyMatches = false;
		}
		@foreach ( var family in ChunksManifest.Families )
		{
			var familyMatches = ChunksManifest.ByFamily( family ).Where( Matches ).ToArray();
			if ( familyMatches.Length == 0 )
				continue;
			anyMatches = true;
			<div class="space-y-0.5 pt-3">
				<div class="px-3 pb-1 text-xs font-bold text-foreground uppercase tracking-wide">@family</div>
				@foreach ( var entry in familyMatches )
				{
					<NavLink href="@($"chunks/{entry.Slug}")" class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium hover:bg-neutral-bg no-underline text-foreground/70 hover:text-foreground transition-colors" ActiveClass="bg-primary-bg text-primary-fg font-semibold">
						<span class="flex-1 truncate">@entry.Name</span>
					</NavLink>
				}
			</div>
		}
		@if ( !anyMatches )
		{
			<div class="px-3 pt-3 text-xs text-muted-foreground">No matches</div>
		}
	</div>
</nav>

@code {
	private string Filter = string.Empty;

	private bool Matches( ChunksManifest.ChunkEntry entry )
	{
		if ( string.IsNullOrWhiteSpace( Filter ) )
			return true;
		var f = Filter.Trim();
		return entry.Family.Contains( f, StringComparison.OrdinalIgnoreCase )
			|| entry.Name.Contains( f, StringComparison.OrdinalIgnoreCase )
			|| entry.Description.Contains( f, StringComparison.OrdinalIgnoreCase );
	}

	private void OnFilterInput( ChangeEventArgs e )
	{
		Filter = e.Value?.ToString() ?? string.Empty;
	}
}

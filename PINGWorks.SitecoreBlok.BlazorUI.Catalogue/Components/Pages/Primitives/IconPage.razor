		<ComponentExample Title="Different scales" Code="@("<Icon Svg=\"@IconSvg.Check\" Scale=\"0.75\" />\n<Icon Svg=\"@IconSvg.Check\" />\n<Icon Svg=\"@IconSvg.Check\" Scale=\"1.5\" />\n<Icon Svg=\"@IconSvg.Check\" Scale=\"2.0\" />")">

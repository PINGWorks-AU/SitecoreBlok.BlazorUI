		<ComponentExample Title="Various icons" Code="@("<Icon Svg=\"@IconSvg.Account\" />\n<Icon Svg=\"@IconSvg.Check\" />\n<Icon Svg=\"@IconSvg.ChevronDown\" />\n<Icon Svg=\"@IconSvg.AccessPoint\" />")">
			<div class="flex items-center gap-4">
				<Icon Svg="@IconSvg.Account" />

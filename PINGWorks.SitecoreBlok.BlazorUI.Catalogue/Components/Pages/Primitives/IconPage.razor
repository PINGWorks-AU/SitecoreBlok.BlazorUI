	</ExamplesSection>

</ComponentPage>

@code {
	private static readonly ApiElement[] IconElements =
	[
		new ApiElement(
			Name: "Icon",
			Description: "Renders an inline `<svg>` from an MDI-style path string. Sized via `IconSize` or `ClassName` (`size-X`); visually fine-tuned via `Scale`.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Svg",                  "string",                        true,  "SVG path data to render inside the `<path d>`. Pass a constant from `IconSvg` or the `PINGWorks.SitecoreBlok.BlazorUI.Icons` package." ),
				new ApiProperty( "Variant",              "IconVariant",                   false, "Visual tile style. Default: `IconVariant.Default` (no tile, svg is root element). `Subtle` adds a soft tinted background tile; `Filled` adds a solid background tile. Tile variants render a `<span>` wrapper." ),
				new ApiProperty( "ColorScheme",          "IconColorScheme?",              false, "Color token applied to the icon and (for tile variants) the tile background. Default: `null` (inherits color from parent) for `Default` variant; `Primary` for `Subtle`/`Filled`. Values: `Primary`, `Neutral`, `Success`, `Danger`, `Warning`, `Yellow`, `Teal`, `Cyan`, `Blue`, `Purple`, `Pink`." ),
				new ApiProperty( "IconSize",             "IconSize",                      false, "Preset size token. Default: `IconSize.Default` (`size-6`). Other values: `Sm` (`size-4`), `Md` (`size-5`), `Lg` (`size-7`), `Xl` (`size-9`), `Xxl` (`size-11`), `Custom` (emits no size class — control size entirely via `ClassName`)." ),
				new ApiProperty( "Scale",                "double?",                       false, "SVG `transform=\"scale(n)\"` factor. Scales the glyph without changing the containing box — use for visual tweaks." ),
				new ApiProperty( "Fill",                 "string",                        false, "Fill colour for the path. Default: `\"currentColor\"`. Ignored when `AiGradient` is set." ),
				new ApiProperty( "ViewBox",              "string",                        false, "SVG `viewBox`. Default: `\"0 0 24 24\"` (MDI canvas)." ),
				new ApiProperty( "Title",                "string?",                       false, "Accessible label. Rendered as a `<title>` element and applied to `aria-label`." ),
				new ApiProperty( "AiGradient",           "AiGradient?",                   false, "When set, replaces the fill with a purple-to-red linear gradient at the given palette step (e.g. `G500`)." ),
				new ApiProperty( "ResetClassName",       "bool",                          false, "Opts out of the layout defaults (`inline-block align-middle shrink-0`) on the `Default` variant. Does NOT strip the size class. Default: `false`." ),
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes. For `Default` variant appended to the `<svg>`; for `Subtle`/`Filled` variants appended to the outer `<span>`." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the `<svg>` in all variants." ),
			]
		),
	];
}

				new ApiProperty( "ChildContent",         "RenderFragment?",               false, "Group content." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the group wrapper." ),
			]
		),

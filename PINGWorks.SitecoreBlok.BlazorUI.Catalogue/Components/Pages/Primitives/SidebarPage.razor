			Name: "SidebarGroupContent",
			Description: "Body of a `SidebarGroup`. Host for `SidebarMenu`.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes appended to the content wrapper." ),
				new ApiProperty( "ChildContent",         "RenderFragment?",               false, "Group body — usually a `SidebarMenu`." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the wrapper." ),
			]
		),
		new ApiElement(
			Name: "SidebarMenu",
			Description: "Vertical `<ul>` of navigation items inside a `SidebarGroupContent`.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes appended to the `<ul>`." ),
				new ApiProperty( "ChildContent",         "RenderFragment?",               false, "One or more `SidebarMenuItem`s." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the `<ul>`." ),
			]
		),
		new ApiElement(
			Name: "SidebarMenuItem",
			Description: "`<li>` row hosting one `SidebarMenuButton` plus optional `SidebarMenuBadge`, `SidebarMenuAction`, or `SidebarMenuSub`.",

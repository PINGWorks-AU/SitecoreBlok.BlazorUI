				new ApiProperty( "ChildContent",         "RenderFragment?",               false, "Label text or inline markup." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the label container." ),
			]
		),
		new ApiElement(
			Name: "SidebarGroupAction",
			Description: "Small icon button positioned at the top-right of a `SidebarGroup`. Hidden when the sidebar is collapsed to icon mode.",
			Depth: 2,
			Properties:

		new ApiElement(
			Name: "SidebarMenuButton",
			Description: "The primary clickable row of a `SidebarMenuItem`. Place an `Icon` + `<span>` label inside; the icon stays visible when the sidebar collapses to icon mode.",
			Depth: 2,
			Properties:

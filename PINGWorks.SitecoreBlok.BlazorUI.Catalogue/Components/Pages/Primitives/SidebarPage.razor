@code {
	private static readonly ApiElement[] SidebarElements =
	[
		new ApiElement(
			Name: "SidebarProvider",
			Description: "Outermost wrapper. Cascades itself so child `Sidebar`, `SidebarTrigger`, and `SidebarRail` components can read and toggle the open state. Sets the `--sidebar-width` and `--sidebar-width-icon` CSS variables consumed by `Sidebar`.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "DefaultOpen",          "bool",                          false, "Initial open state. Default: `true`." ),
				new ApiProperty( "OpenChanged",          "EventCallback<bool>",           false, "Fires whenever the user toggles the sidebar. Use this to persist state yourself — Blok's cookie persistence is not ported." ),
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes appended to the provider wrapper." ),
				new ApiProperty( "ChildContent",         "RenderFragment?",               false, "Should contain a `Sidebar` and a sibling `SidebarInset`." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the wrapper `div`." ),
			]
		),
		new ApiElement(
			Name: "Sidebar",
			Description: "The collapsible navigation rail. Reads its open state from the cascading `SidebarProvider` and swaps between full-width, icon-only, or off-canvas layouts via the `Collapsible` parameter.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Side",                 "SidebarSide",                   false, "Screen edge to dock against. Default: `SidebarSide.Left`. Other value: `Right`." ),
				new ApiProperty( "Variant",              "SidebarVariant",                false, "Visual treatment. Default: `SidebarVariant.Sidebar`. Other values: `Floating` (rounded + shadow), `Inset` (inset main content)." ),
				new ApiProperty( "Collapsible",          "SidebarCollapsible",            false, "Collapse behaviour. Default: `SidebarCollapsible.Offcanvas` (slides off-screen). Other values: `Icon` (collapses to icon-only rail), `None` (fixed width, no collapse)." ),
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes appended to the sidebar container." ),
				new ApiProperty( "ChildContent",         "RenderFragment?",               false, "Sidebar body — typically one or more `SidebarGroup`s inside a `SidebarContent`." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the sidebar container." ),
			]
		),
		new ApiElement(
			Name: "SidebarInset",
			Description: "Main-content `<main>` region that sits alongside the `Sidebar`. When the `Sidebar` is `SidebarVariant.Inset`, this element gains the inset margin and rounded corner styling.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes appended to the `<main>` element." ),
				new ApiProperty( "ChildContent",         "RenderFragment?",               false, "Page content rendered next to the sidebar." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the `<main>` element." ),
			]
		),
		new ApiElement(
			Name: "SidebarTrigger",
			Description: "Pre-styled icon button that toggles the nearest `SidebarProvider`. Place it in your page header to let users collapse / expand the sidebar.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "OnClicked",            "EventCallback",                 false, "Fires on click, before the provider toggles. Use for analytics or extra side effects." ),
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes appended to the button." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the underlying `Button`." ),
			]
		),
		new ApiElement(
			Name: "SidebarRail",
			Description: "Thin vertical hit-area at the outer edge of the sidebar that also toggles the provider. Useful for drag-to-collapse style interactions.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes appended to the rail button." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the rail `<button>`." ),
			]
		),
		new ApiElement(
			Name: "SidebarInput",
			Description: "Standard `Input` wired up with the sidebar input styling. Useful for inline filters at the top of a sidebar group.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Value",                "string?",                       false, "Current input value. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged",         "EventCallback<string?>",        false, "Fires on input change. Part of the `@bind-Value` pair." ),
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes appended to the inner `Input`." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the inner `Input`." ),
			]
		),
		new ApiElement(
			Name: "SidebarSeparator",
			Description: "Horizontal `Separator` with sidebar-specific spacing and background colour.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes appended to the separator." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the separator." ),
			]
		),
		new ApiElement(
			Name: "SidebarContent",
			Description: "Scrollable body area of the sidebar. Place `SidebarGroup`s here; overflow becomes scrollable.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes appended to the content container." ),
				new ApiProperty( "ChildContent",         "RenderFragment?",               false, "Should contain one or more `SidebarGroup`s." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the content container." ),
			]
		),
		new ApiElement(
			Name: "SidebarGroup",

@page "/primitives/timepicker"
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services
@rendermode InteractiveServer

<ComponentPage Title="TimePicker" Description="A time selection input" Interactivity="ComponentInteractivity.Interactive" ApiElements="@TimePickerElements">

	<DivergenceNote>
		<p><strong>This is a native <code>&lt;input type="time"&gt;</code>, not a port of Blok's composite picker.</strong> Blok builds its TimePicker from a <code>Popover</code> containing three <code>Select</code> dropdowns (Hour, Minute, Period) plus Clear and Done buttons, behind a trigger button that shows the formatted time. We render a single native time input instead, so the browser supplies the spinner, keyboard entry, and platform time-entry UI. The rendered DOM, the sub-component surface, and the interaction model all differ from Blok &mdash; there are no Blok-equivalent sub-components to compose.</p>
		<p><strong>Value type is <code>TimeSpan?</code> (24-hour), not Blok's <code>TimeValue &#123; hour, minute, period: AM/PM &#125;</code>.</strong> Blok models time as a structured object with an AM/PM period flag. <code>TimeSpan</code> is naturally 24-hour and is what the native input round-trips. Consumers migrating from Blok need to convert their <code>TimeValue</code> to a <code>TimeSpan</code> on binding; the period is implied by the hour. Display formatting follows the browser locale for <code>input type="time"</code> &mdash; this component exposes no format parameter.</p>
	</DivergenceNote>

	<ExamplesSection>

		<ComponentExample Title="Default" Code="@("<TimePicker @bind-Value=\"selectedTime\" />")">
			<div class="space-y-4">
				<TimePicker @bind-Value="SelectedTime" />
				@if ( SelectedTime is not null )
				{
					<p class="text-sm text-muted-foreground">Selected: @SelectedTime.Value.ToString(@"hh\:mm")</p>
				}
			</div>
		</ComponentExample>

		<ComponentExample Title="Disabled" Code="@("<TimePicker Disabled=\"true\" />")">
			<TimePicker Disabled="true" />
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private TimeSpan? SelectedTime;

	private static readonly ApiElement[] TimePickerElements =
	[
		new ApiElement(
			Name: "TimePicker",
			Description: "Wraps a native `<input type=\"time\">` styled to match Blok. Two-way bindable via `@bind-Value` to a `TimeSpan?`.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Value",                "TimeSpan?",                     false, "Selected time as a 24-hour `TimeSpan`. Null when unset or the underlying input is cleared." ),
				new ApiProperty( "ValueChanged",         "EventCallback<TimeSpan?>",      false, "Invoked when the user edits the time." ),
				new ApiProperty( "Disabled",             "bool",                          false, "When true, the input is read-only and visually muted. Default: `false`." ),
				new ApiProperty( "ClassName",            "string?",                       false, "Extra CSS classes appended to the outer wrapper." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",   false, "Captured unmatched attributes, forwarded to the underlying `<input>`." ),
			]
		),
	];
}

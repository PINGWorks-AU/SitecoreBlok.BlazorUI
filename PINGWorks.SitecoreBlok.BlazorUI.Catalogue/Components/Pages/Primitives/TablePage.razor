@code {
	private static readonly ApiElement[] TableElements =
	[
		new ApiElement(
			Name: "Table",
			Description: "Container that provides the scroll wrapper, `data-table-size` and a cascading `Table` reference for children. Use with `TableHeader` / `TableBody` / `TableFooter` plus `TableRow` / `TableHead` / `TableCell`.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Size",               "TableSize",       false, "Row-height preset. Default: `TableSize.Md`. Other values: `Sm`, `Lg`." ),
				new ApiProperty( "StickyHeader",       "bool",            false, "When true (default) and `MaxHeight` is set, the `TableHeader` sticks to the top during scroll. Default: `true`." ),
				new ApiProperty( "MaxHeight",          "string?",         false, "Optional CSS height (e.g. `\"300px\"`) that turns the container into a vertically scrollable region and enables `StickyHeader`." ),
				new ApiProperty( "MaxWidth",           "string?",         false, "Optional CSS max-width that enables horizontal scrolling for pinned-column layouts." ),
				new ApiProperty( "ClassName",          "string?",         false, "Extra CSS classes appended to the inner `<table>`." ),
				new ApiProperty( "ContainerClassName", "string?",         false, "Extra CSS classes appended to the outer scroll container." ),
				new ApiProperty( "ChildContent",       "RenderFragment?", false, "The table's header, body, footer and rows." ),
			]
		),
		new ApiElement(
			Name: "TableHeader",
			Description: "Renders `<thead>`. Applies sticky-header styling automatically when the parent `Table` has `MaxHeight` set and `StickyHeader` is true.",
			Depth: 1,
			Properties:
			[
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the `<thead>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?", false, "One or more `TableRow` entries containing `TableHead` cells." ),
			]
		),
		new ApiElement(
			Name: "TableBody",
			Description: "Renders `<tbody>` with row-border styling. Typically wraps a set of `TableRow` children.",
			Depth: 1,
			Properties:
			[
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the `<tbody>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?", false, "`TableRow` children." ),
			]
		),
		new ApiElement(
			Name: "TableFooter",
			Description: "Renders `<tfoot>` with muted background and top border, suitable for totals rows.",
			Depth: 1,
			Properties:
			[
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the `<tfoot>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?", false, "`TableRow` children for the footer." ),
			]
		),
		new ApiElement(
			Name: "TableRow",
			Description: "Renders a `<tr>` with the default hover/selected styling.",
			Depth: 1,
			Properties:
			[
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the `<tr>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?", false, "`TableHead` or `TableCell` children." ),
			]
		),
		new ApiElement(
			Name: "TableHead",
			Description: "Renders a `<th>` with header typography. Pulls row-height padding from the parent `Table`'s `Size`.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "Pinned",       "bool",            false, "When true, the column pins to the left (`position: sticky`). Pair with `TableCell Pinned=\"true\"` in each row's first cell. Default: `false`." ),
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the `<th>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?", false, "Header text or inline markup." ),
			]
		),
		new ApiElement(
			Name: "TableCell",
			Description: "Renders a `<td>` with body typography. Pulls row-height padding from the parent `Table`'s `Size`.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "Pinned",       "bool",            false, "When true, the cell pins to the left (`position: sticky`). Use on the first cell of each row when the corresponding `TableHead` is pinned. Default: `false`." ),
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the `<td>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?", false, "Cell content." ),
			]
		),
		new ApiElement(
			Name: "TableCaption",
			Description: "Renders a `<caption>` beneath the table with muted styling. Optional.",
			Depth: 1,
			Properties:
			[
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the `<caption>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?", false, "Caption text." ),
			]
		),
	];
}

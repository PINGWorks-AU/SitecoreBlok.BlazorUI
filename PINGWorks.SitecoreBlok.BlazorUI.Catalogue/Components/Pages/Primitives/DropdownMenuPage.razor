@page "/primitives/dropdownmenu"
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services
@rendermode InteractiveServer

<ComponentPage Title="DropdownMenu" Description="A menu that appears on click, typically used for contextual actions" Interactivity="ComponentInteractivity.Interactive" ApiElements="@DropdownMenuElements">

	<DivergenceNote>
		<p><strong>Reduced sub-component set compared to Blok's Radix-based menu.</strong> Blok exports <code>DropdownMenuCheckboxItem</code>, <code>DropdownMenuRadioGroup</code>, <code>DropdownMenuRadioItem</code>, and <code>DropdownMenuPortal</code> in addition to the standard items. We don't currently ship these — use a regular <code>DropdownMenuItem</code> with your own check/radio state management if you need toggle behaviour. The core pieces (<code>DropdownMenuTrigger</code>, <code>DropdownMenuContent</code>, <code>DropdownMenuItem</code>, <code>DropdownMenuLabel</code>, <code>DropdownMenuGroup</code>, <code>DropdownMenuSeparator</code>, <code>DropdownMenuShortcut</code>, and nested <code>DropdownMenuSub</code>/<code>DropdownMenuSubTrigger</code>/<code>DropdownMenuSubContent</code>) all match Blok's composition. No keyboard navigation (arrows / <kbd>Enter</kbd> / <kbd>Esc</kbd>) — Blok gets that via Radix.</p>
	</DivergenceNote>

	<ExamplesSection>

		<ComponentExample Title="Default" Code="@("<DropdownMenu>\n    <DropdownMenuTrigger>\n        <Button Variant=\"ButtonVariant.Outline\" ColorScheme=\"ButtonColor.Neutral\">Open Menu</Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent>\n        <DropdownMenuLabel>Actions</DropdownMenuLabel>\n        <DropdownMenuGroup>\n            <DropdownMenuItem>Edit</DropdownMenuItem>\n            <DropdownMenuItem>Duplicate</DropdownMenuItem>\n        </DropdownMenuGroup>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem Variant=\"DropdownMenuItemVariant.Destructive\">Delete</DropdownMenuItem>\n    </DropdownMenuContent>\n</DropdownMenu>")">
			<DropdownMenu>
				<DropdownMenuTrigger>
					<Button Variant="ButtonVariant.Outline" ColorScheme="ButtonColor.Neutral">Open Menu</Button>
				</DropdownMenuTrigger>
				<DropdownMenuContent>
					<DropdownMenuLabel>Actions</DropdownMenuLabel>
					<DropdownMenuGroup>
						<DropdownMenuItem>Edit</DropdownMenuItem>
						<DropdownMenuItem>Duplicate</DropdownMenuItem>
					</DropdownMenuGroup>
					<DropdownMenuSeparator />
					<DropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">Delete</DropdownMenuItem>
				</DropdownMenuContent>
			</DropdownMenu>
		</ComponentExample>

		<ComponentExample Title="With click handlers" Code="@("<DropdownMenu>\n    <DropdownMenuTrigger>\n        <Button Variant=\"ButtonVariant.Outline\" ColorScheme=\"ButtonColor.Neutral\">Actions</Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent>\n        <DropdownMenuLabel>My Account</DropdownMenuLabel>\n        <DropdownMenuGroup>\n            <DropdownMenuItem OnClick=\"@(() => lastAction = \"Profile\")\">Profile</DropdownMenuItem>\n            <DropdownMenuItem OnClick=\"@(() => lastAction = \"Settings\")\">Settings</DropdownMenuItem>\n        </DropdownMenuGroup>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem Variant=\"DropdownMenuItemVariant.Destructive\" OnClick=\"@(() => lastAction = \"Log out\")\">Log out</DropdownMenuItem>\n    </DropdownMenuContent>\n</DropdownMenu>")">
			<div class="flex items-center gap-4">
				<DropdownMenu>
					<DropdownMenuTrigger>
						<Button Variant="ButtonVariant.Outline" ColorScheme="ButtonColor.Neutral">Actions</Button>
					</DropdownMenuTrigger>
					<DropdownMenuContent>
						<DropdownMenuLabel>My Account</DropdownMenuLabel>
						<DropdownMenuGroup>
							<DropdownMenuItem OnClick="@(() => LastAction = "Profile")">Profile</DropdownMenuItem>
							<DropdownMenuItem OnClick="@(() => LastAction = "Settings")">Settings</DropdownMenuItem>
						</DropdownMenuGroup>
						<DropdownMenuSeparator />
						<DropdownMenuItem Variant="DropdownMenuItemVariant.Destructive" OnClick="@(() => LastAction = "Log out")">Log out</DropdownMenuItem>
					</DropdownMenuContent>
				</DropdownMenu>
				@if ( LastAction is not null )
				{
					<span class="text-sm text-muted-foreground">Last action: @LastAction</span>
				}
			</div>
		</ComponentExample>

		<ComponentExample Title="With Submenu" Code="@("<DropdownMenu>\n    <DropdownMenuTrigger><Button>File</Button></DropdownMenuTrigger>\n    <DropdownMenuContent>\n        <DropdownMenuItem>New File</DropdownMenuItem>\n        <DropdownMenuSeparator />\n        <DropdownMenuSub>\n            <DropdownMenuSubTrigger>Share</DropdownMenuSubTrigger>\n            <DropdownMenuSubContent>\n                <DropdownMenuItem>Email</DropdownMenuItem>\n                <DropdownMenuItem>Slack</DropdownMenuItem>\n            </DropdownMenuSubContent>\n        </DropdownMenuSub>\n        <DropdownMenuSub>\n            <DropdownMenuSubTrigger>Export as</DropdownMenuSubTrigger>\n            <DropdownMenuSubContent>\n                <DropdownMenuItem>PDF</DropdownMenuItem>\n                <DropdownMenuItem>CSV</DropdownMenuItem>\n            </DropdownMenuSubContent>\n        </DropdownMenuSub>\n    </DropdownMenuContent>\n</DropdownMenu>")">
			<div class="flex items-center gap-4">
				<DropdownMenu>
					<DropdownMenuTrigger>
						<Button Variant="ButtonVariant.Outline" ColorScheme="ButtonColor.Neutral">File</Button>
					</DropdownMenuTrigger>
					<DropdownMenuContent>
						<DropdownMenuItem OnClick="@(() => LastAction = "New File")">New File</DropdownMenuItem>
						<DropdownMenuItem OnClick="@(() => LastAction = "Open")">Open</DropdownMenuItem>
						<DropdownMenuSeparator />
						<DropdownMenuSub>
							<DropdownMenuSubTrigger>Share</DropdownMenuSubTrigger>
							<DropdownMenuSubContent>
								<DropdownMenuItem OnClick="@(() => LastAction = "Share via Email")">Email</DropdownMenuItem>
								<DropdownMenuItem OnClick="@(() => LastAction = "Share via Slack")">Slack</DropdownMenuItem>
								<DropdownMenuItem OnClick="@(() => LastAction = "Share via Teams")">Teams</DropdownMenuItem>
							</DropdownMenuSubContent>
						</DropdownMenuSub>
						<DropdownMenuSub>
							<DropdownMenuSubTrigger>Export as</DropdownMenuSubTrigger>
							<DropdownMenuSubContent>
								<DropdownMenuItem OnClick="@(() => LastAction = "Export PDF")">PDF</DropdownMenuItem>
								<DropdownMenuItem OnClick="@(() => LastAction = "Export CSV")">CSV</DropdownMenuItem>
								<DropdownMenuItem OnClick="@(() => LastAction = "Export JSON")">JSON</DropdownMenuItem>
							</DropdownMenuSubContent>
						</DropdownMenuSub>
						<DropdownMenuSeparator />
						<DropdownMenuItem Variant="DropdownMenuItemVariant.Destructive" OnClick="@(() => LastAction = "Delete")">Delete</DropdownMenuItem>
					</DropdownMenuContent>
				</DropdownMenu>
				@if ( LastAction is not null )
				{
					<span class="text-sm text-muted-foreground">Last action: @LastAction</span>
				}
			</div>
		</ComponentExample>

		<ComponentExample Title="With Shortcuts and Icons" Code="@("<DropdownMenu>\n    <DropdownMenuTrigger><Button>Edit</Button></DropdownMenuTrigger>\n    <DropdownMenuContent>\n        <DropdownMenuItem>\n            <Icon Svg=\"@@IconSvg.ContentCut\" ClassName=\"size-4\" /> Cut\n            <DropdownMenuShortcut>Ctrl+X</DropdownMenuShortcut>\n        </DropdownMenuItem>\n        <DropdownMenuItem>\n            <Icon Svg=\"@@IconSvg.ContentCopy\" ClassName=\"size-4\" /> Copy\n            <DropdownMenuShortcut>Ctrl+C</DropdownMenuShortcut>\n        </DropdownMenuItem>\n    </DropdownMenuContent>\n</DropdownMenu>")">
			<DropdownMenu>
				<DropdownMenuTrigger>
					<Button Variant="ButtonVariant.Outline" ColorScheme="ButtonColor.Neutral">Edit</Button>
				</DropdownMenuTrigger>
				<DropdownMenuContent>
					<DropdownMenuGroup>
						<DropdownMenuItem>
							<Icon Svg="@IconSvg.ContentCut" ClassName="size-4" /> Cut
							<DropdownMenuShortcut>Ctrl+X</DropdownMenuShortcut>
						</DropdownMenuItem>
						<DropdownMenuItem>
							<Icon Svg="@IconSvg.ContentCopy" ClassName="size-4" /> Copy
							<DropdownMenuShortcut>Ctrl+C</DropdownMenuShortcut>
						</DropdownMenuItem>
						<DropdownMenuItem>
							<Icon Svg="@IconSvg.ContentPaste" ClassName="size-4" /> Paste
							<DropdownMenuShortcut>Ctrl+V</DropdownMenuShortcut>
						</DropdownMenuItem>
					</DropdownMenuGroup>
				</DropdownMenuContent>
			</DropdownMenu>
		</ComponentExample>

		<ComponentExample Title="Checkbox items" Code="@("<DropdownMenu>\n    <DropdownMenuTrigger><Button>View</Button></DropdownMenuTrigger>\n    <DropdownMenuContent>\n        <DropdownMenuLabel>Panels</DropdownMenuLabel>\n        <DropdownMenuCheckboxItem @bind-Checked=\"showSidebar\">Sidebar</DropdownMenuCheckboxItem>\n        <DropdownMenuCheckboxItem @bind-Checked=\"showToolbar\">Toolbar</DropdownMenuCheckboxItem>\n        <DropdownMenuCheckboxItem @bind-Checked=\"showStatusBar\" Disabled=\"true\">Status bar</DropdownMenuCheckboxItem>\n    </DropdownMenuContent>\n</DropdownMenu>")">
			<div class="space-y-3">
				<DropdownMenu>
					<DropdownMenuTrigger>
						<Button Variant="ButtonVariant.Outline" ColorScheme="ButtonColor.Neutral">View</Button>
					</DropdownMenuTrigger>
					<DropdownMenuContent>
						<DropdownMenuLabel>Panels</DropdownMenuLabel>
						<DropdownMenuCheckboxItem @bind-Checked="ShowSidebar">Sidebar</DropdownMenuCheckboxItem>
						<DropdownMenuCheckboxItem @bind-Checked="ShowToolbar">Toolbar</DropdownMenuCheckboxItem>
						<DropdownMenuCheckboxItem @bind-Checked="ShowStatusBar" Disabled="true">Status bar</DropdownMenuCheckboxItem>
					</DropdownMenuContent>
				</DropdownMenu>
				<p class="text-sm text-muted-foreground">Sidebar: <strong>@ShowSidebar</strong> · Toolbar: <strong>@ShowToolbar</strong></p>
			</div>
		</ComponentExample>

		<ComponentExample Title="Radio group" Code="@("<DropdownMenu>\n    <DropdownMenuTrigger><Button>Sort</Button></DropdownMenuTrigger>\n    <DropdownMenuContent>\n        <DropdownMenuLabel>Sort by</DropdownMenuLabel>\n        <DropdownMenuRadioGroup @bind-Value=\"sortBy\">\n            <DropdownMenuRadioItem Value=\"name\">Name</DropdownMenuRadioItem>\n            <DropdownMenuRadioItem Value=\"date\">Date modified</DropdownMenuRadioItem>\n            <DropdownMenuRadioItem Value=\"size\">Size</DropdownMenuRadioItem>\n        </DropdownMenuRadioGroup>\n    </DropdownMenuContent>\n</DropdownMenu>")">
			<div class="space-y-3">
				<DropdownMenu>
					<DropdownMenuTrigger>
						<Button Variant="ButtonVariant.Outline" ColorScheme="ButtonColor.Neutral">Sort</Button>
					</DropdownMenuTrigger>
					<DropdownMenuContent>
						<DropdownMenuLabel>Sort by</DropdownMenuLabel>
						<DropdownMenuRadioGroup @bind-Value="SortBy">
							<DropdownMenuRadioItem Value="name">Name</DropdownMenuRadioItem>
							<DropdownMenuRadioItem Value="date">Date modified</DropdownMenuRadioItem>
							<DropdownMenuRadioItem Value="size">Size</DropdownMenuRadioItem>
						</DropdownMenuRadioGroup>
					</DropdownMenuContent>
				</DropdownMenu>
				<p class="text-sm text-muted-foreground">Sorting by: <strong>@( SortBy ?? "(none)" )</strong></p>
			</div>
		</ComponentExample>

		<ComponentExample Title="Two-line items" Code="@("<DropdownMenuItem>\n    <DropdownMenuItemText>\n        <DropdownMenuItemTitle>Personal</DropdownMenuItemTitle>\n        <DropdownMenuItemDescription>you@example.com</DropdownMenuItemDescription>\n    </DropdownMenuItemText>\n</DropdownMenuItem>")">
			<DropdownMenu>
				<DropdownMenuTrigger>
					<Button Variant="ButtonVariant.Outline" ColorScheme="ButtonColor.Neutral">Switch account</Button>
				</DropdownMenuTrigger>
				<DropdownMenuContent>
					<DropdownMenuItem>
						<DropdownMenuItemText>
							<DropdownMenuItemTitle>Personal</DropdownMenuItemTitle>
							<DropdownMenuItemDescription>you@example.com</DropdownMenuItemDescription>
						</DropdownMenuItemText>
					</DropdownMenuItem>
					<DropdownMenuItem>
						<DropdownMenuItemText>
							<DropdownMenuItemTitle>Work</DropdownMenuItemTitle>
							<DropdownMenuItemDescription>you@ping-works.com.au</DropdownMenuItemDescription>
						</DropdownMenuItemText>
					</DropdownMenuItem>
				</DropdownMenuContent>
			</DropdownMenu>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private string? LastAction;
	private bool ShowSidebar = true;
	private bool ShowToolbar;
	private bool ShowStatusBar;
	private string? SortBy = "name";

	private static readonly ApiElement[] DropdownMenuElements =
	[
		new ApiElement(
			Name: "DropdownMenu",
			Description: "Root state container. Tracks open state and the anchor coordinate so `DropdownMenuContent` can render below the trigger button.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "ChildContent", "RenderFragment?", false, "Should contain one `DropdownMenuTrigger` and one `DropdownMenuContent`." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuTrigger",
			Description: "Click target that toggles the parent menu. Registers its bounding rect so the content can position itself below.",
			Depth: 1,
			Properties:
			[
				new ApiProperty( "ClassName",            "string?",                    false, "Extra CSS classes appended to the `<button>`." ),
				new ApiProperty( "ChildContent",         "RenderFragment?",            false, "Trigger content — typically a `Button`." ),
				new ApiProperty( "AdditionalAttributes", "Dictionary<string, object>?",false, "Captured unmatched attributes, forwarded to the underlying `<button>`." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuContent",
			Description: "Positioned menu surface. Renders relative to the trigger using smart collision-avoidance (matching Blok's Radix `avoidCollisions` default). A full-viewport backdrop closes the menu on outside click.",
			Depth: 1,
			Properties:
			[
				new ApiProperty( "Side",         "DropdownMenuSide",  false, "Preferred opening side relative to the trigger. Default: `Bottom`. Flips to the opposite side when the preferred side overflows the viewport. Other values: `Top`, `Left`, `Right`." ),
				new ApiProperty( "Align",        "DropdownMenuAlign", false, "Alignment of the menu along the trigger's cross-axis. Default: `Start`. Other values: `Center`, `End`." ),
				new ApiProperty( "SideOffset",   "double",            false, "Gap in pixels between trigger and menu surface. Default: `4` (matches Blok's explicit default)." ),
				new ApiProperty( "ClassName",    "string?",           false, "Extra CSS classes appended to the menu surface." ),
				new ApiProperty( "ChildContent", "RenderFragment?",   false, "Menu items — `DropdownMenuItem`, `DropdownMenuLabel`, `DropdownMenuGroup`, `DropdownMenuSeparator`, nested `DropdownMenuSub`." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuLabel",
			Description: "Non-interactive heading row inside a menu. Rendered in uppercase muted text.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the label `<div>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?", false, "Heading text." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuGroup",
			Description: "Logical grouping wrapper around a set of items. Renders a `role=\"group\"` `<div>` with no visual separator — use `DropdownMenuSeparator` for that.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the group `<div>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?", false, "`DropdownMenuItem` children belonging to this group." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuItem",
			Description: "Clickable menu row. On click, fires `OnClick` and then closes every ancestor menu (including `DropdownMenuSub` and `ContextMenu`) so the whole chain dismisses.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "Variant",      "DropdownMenuItemVariant", false, "Visual style. Default: `DropdownMenuItemVariant.Default`. Other value: `Destructive` (red hover + destructive bg tint)." ),
				new ApiProperty( "Disabled",     "bool",                    false, "When true, the item is muted and ignores clicks. Default: `false`." ),
				new ApiProperty( "OnClick",        "EventCallback",           false, "Invoked when the item is clicked, before the menu chain closes." ),
				new ApiProperty( "ClassName",    "string?",                 false, "Extra CSS classes appended to the item `<div>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?",         false, "Item label and optional `Icon` / `DropdownMenuShortcut` children." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuCheckboxItem",
			Description: "Menu item with a checkmark indicator. Two-way bind `Checked`. Selecting one dismisses the whole menu chain, matching Blok and Radix's default.",
			Depth: 1,
			Properties:
			[
				new ApiProperty( "Checked",        "bool",                 false, "Whether the item is checked. Supports two-way binding via `@bind-Checked`. Default: `false`." ),
				new ApiProperty( "CheckedChanged", "EventCallback<bool>",  false, "Fires with the new state when the item is toggled." ),
				new ApiProperty( "Disabled",       "bool",                 false, "When true, the item is non-interactive and dimmed. Default: `false`." ),
				new ApiProperty( "ChildContent",   "RenderFragment?",      false, "Item content — the label, and optionally a `DropdownMenuShortcut`." ),
				new ApiProperty( "ClassName",      "string?",              false, "Extra CSS classes appended to the item." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuRadioGroup",
			Description: "Groups `DropdownMenuRadioItem`s and owns the selected value. Blok's equivalent is a bare passthrough because Radix holds the value; this one holds it and cascades to its items.",
			Depth: 1,
			Properties:
			[
				new ApiProperty( "Value",        "string?",                  false, "Value of the selected item. Supports two-way binding via `@bind-Value`." ),
				new ApiProperty( "ValueChanged", "EventCallback<string?>",   false, "Fires with the newly selected value." ),
				new ApiProperty( "ChildContent", "RenderFragment?",          false, "The `DropdownMenuRadioItem`s." ),
				new ApiProperty( "ClassName",    "string?",                  false, "Extra CSS classes appended to the group wrapper." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuRadioItem",
			Description: "A single option inside a `DropdownMenuRadioGroup`. Shows a dot when its `Value` matches the group's, and selects itself on click.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "Value",        "string?",          true,  "Value this item represents. Compared against the parent `DropdownMenuRadioGroup`'s `Value` to decide the checked state." ),
				new ApiProperty( "Disabled",     "bool",             false, "When true, the item is non-interactive and dimmed. Default: `false`." ),
				new ApiProperty( "ChildContent", "RenderFragment?",  false, "Item label." ),
				new ApiProperty( "ClassName",    "string?",          false, "Extra CSS classes appended to the item." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuItemText",
			Description: "Stacks a `DropdownMenuItemTitle` and `DropdownMenuItemDescription` into a two-line item body. Use inside a `DropdownMenuItem`.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "ChildContent", "RenderFragment?", false, "Typically a `DropdownMenuItemTitle` followed by a `DropdownMenuItemDescription`." ),
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the wrapper." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuItemTitle",
			Description: "The primary line of a two-line menu item.",
			Depth: 3,
			Properties:
			[
				new ApiProperty( "ChildContent", "RenderFragment?", false, "Title text." ),
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the title." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuItemDescription",
			Description: "The muted secondary line of a two-line menu item.",
			Depth: 3,
			Properties:
			[
				new ApiProperty( "ChildContent", "RenderFragment?", false, "Description text." ),
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the description." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuSeparator",
			Description: "1px horizontal divider between groups or individual items.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "ClassName", "string?", false, "Extra CSS classes appended to the separator `<div>`." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuShortcut",
			Description: "Right-aligned keyboard-hint label placed inside a `DropdownMenuItem`. Rendered in small, tracked, muted text.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the `<span>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?", false, "Shortcut text (e.g. `Ctrl+X`)." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuSub",
			Description: "Nested submenu state container. Tracks hover open/close and the trigger bounds so `DropdownMenuSubContent` can position itself with collision avoidance.",
			Depth: 2,
			Properties:
			[
				new ApiProperty( "ChildContent", "RenderFragment?", false, "Should contain one `DropdownMenuSubTrigger` and one `DropdownMenuSubContent`." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuSubTrigger",
			Description: "Hover-activated submenu opener. Displays a right chevron and opens the parent `DropdownMenuSub` on mouseenter.",
			Depth: 3,
			Properties:
			[
				new ApiProperty( "ClassName",    "string?",         false, "Extra CSS classes appended to the trigger `<div>`." ),
				new ApiProperty( "ChildContent", "RenderFragment?", false, "Trigger label." ),
			]
		),
		new ApiElement(
			Name: "DropdownMenuSubContent",
			Description: "Submenu surface. Renders relative to its trigger with collision avoidance; closes on mouseleave.",
			Depth: 3,
			Properties:
			[
				new ApiProperty( "Side",         "DropdownMenuSide",  false, "Preferred opening side relative to the subtrigger. Default: `Right`. Flips to `Left` when the right side overflows. Other values: `Top`, `Bottom`, `Left`." ),
				new ApiProperty( "Align",        "DropdownMenuAlign", false, "Alignment along the trigger's cross-axis. Default: `Start`. Other values: `Center`, `End`." ),
				new ApiProperty( "SideOffset",   "double",            false, "Gap in pixels between subtrigger and submenu surface. Default: `0`." ),
				new ApiProperty( "ClassName",    "string?",           false, "Extra CSS classes appended to the submenu surface." ),
				new ApiProperty( "ChildContent", "RenderFragment?",   false, "Submenu items." ),
			]
		),
	];
}

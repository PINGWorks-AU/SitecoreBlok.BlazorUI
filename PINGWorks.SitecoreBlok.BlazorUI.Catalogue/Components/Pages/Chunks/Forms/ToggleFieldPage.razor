@page "/chunks/toggle-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="ToggleField" Description="Labelled toggle field with inline layout — wraps the Toggle primitive with a right-side label and optional help text" Interactivity="ComponentInteractivity.Interactive" ApiElements="@ToggleFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default toggle field"
			Code="@("<ToggleField Label=\"Bold text\" IconSvg=\"@IconSvg.FormatBold\" @bind-Value=\"Bold\" />")"
			Primitives="@("<div class=\"flex items-start gap-3\">\n    <div class=\"pt-0.5\"><button data-slot=\"toggle\" type=\"button\" class=\"...\"><svg class=\"size-4\"><!-- format-bold --></svg></button></div>\n    <div class=\"flex flex-col gap-1\">\n        <label class=\"text-sm font-medium text-foreground ...\">Bold text</label>\n    </div>\n</div>")">
			<ToggleField Label="Bold text" IconSvg="@IconSvg.FormatBold" @bind-Value="Bold" />
		</ComponentExample>

		<ComponentExample Title="Toggle field with help text"
			Code="@("<ToggleField Label=\"Auto-save\" IconSvg=\"@IconSvg.ContentSave\" HelpText=\"Automatically save changes as you type.\" @bind-Value=\"AutoSave\" />")"
			Primitives="@("<div class=\"flex items-start gap-3\">\n    <div class=\"pt-0.5\"><button data-slot=\"toggle\" type=\"button\" class=\"...\"><svg class=\"size-4\"><!-- content-save --></svg></button></div>\n    <div class=\"flex flex-col gap-1\">\n        <label class=\"text-sm font-medium text-foreground ...\">Auto-save</label>\n        <p class=\"text-xs text-muted-foreground\">Automatically save changes as you type.</p>\n    </div>\n</div>")">
			<ToggleField Label="Auto-save" IconSvg="@IconSvg.ContentSave" HelpText="Automatically save changes as you type." @bind-Value="AutoSave" />
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private bool Bold;
	private bool AutoSave;

	private static readonly ApiElement[] ToggleFieldElements =
	[
		new ApiElement(
			Name: "ToggleField",
			Description: "A labelled toggle field chunk with inline layout. The toggle button sits on the left; the label and optional help text stack to the right. Wraps the `Toggle` primitive. The `Toggle` primitive is designed to host an icon glyph — pass `IconSvg` for the common case of icon-bearing toggles.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",         "string?",             false, "Label text rendered to the right of the toggle via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "IconSvg",       "string?",             false, "Optional SVG path rendered as `<Icon Svg=\"...\" ClassName=\"size-4\" />` inside the toggle button. The `Toggle` primitive is designed to host icon glyphs, so most consumers will want to pass one (e.g. `IconSvg.FormatBold`)." ),
				new ApiProperty( "HelpText",      "string?",             false, "Helper text rendered below the label. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",         "bool",                false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",      "bool",                false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",      "bool",                false, "Disables the underlying toggle. Default: `false`." ),
				new ApiProperty( "Id",            "string",              false, "HTML `id` wired to the label's `for` attribute. Auto-generated by default." ),
				new ApiProperty( "Value",         "bool",                false, "Whether the toggle is active (pressed). Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged",  "EventCallback<bool>", false, "Fires when the pressed state changes. Part of the `@bind-Value` pair." ),
			]
		),
	];
}

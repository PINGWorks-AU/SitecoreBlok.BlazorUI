@page "/chunks/text-area-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="TextAreaField" Description="Labelled multi-line textarea — wraps the Textarea primitive with label, help text, and configurable row count" Interactivity="ComponentInteractivity.Interactive" ApiElements="@TextAreaFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default textarea field"
			Code="@("<TextAreaField Label=\"Bio\" Placeholder=\"Tell us about yourself...\" @bind-Value=\"Bio\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">Bio</label>\n    <textarea placeholder=\"Tell us about yourself...\" rows=\"3\" class=\"...\"></textarea>\n</div>")">
			<div class="max-w-sm">
				<TextAreaField Label="Bio" Placeholder="Tell us about yourself..." @bind-Value="Bio" />
			</div>
		</ComponentExample>

		<ComponentExample Title="Tall textarea with help text, required, and error"
			Code="@("<TextAreaField Label=\"Rejection reason\" Placeholder=\"Describe the issue in detail...\" Rows=\"6\" Required=\"true\" Error=\"true\" HelpText=\"This field is required before you can decline.\" @bind-Value=\"Reason\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-danger-fg ...\">Rejection reason<span class=\"text-danger-fg\">*</span></label>\n    <textarea placeholder=\"Describe the issue in detail...\" rows=\"6\" class=\"...\"></textarea>\n    <p class=\"text-xs text-danger-fg\">This field is required before you can decline.</p>\n</div>")">
			<div class="max-w-sm">
				<TextAreaField Label="Rejection reason" Placeholder="Describe the issue in detail..." Rows="6" Required="true" Error="true" HelpText="This field is required before you can decline." @bind-Value="Reason" />
			</div>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private string? Bio;
	private string? Reason;

	private static readonly ApiElement[] TextAreaFieldElements =
	[
		new ApiElement(
			Name: "TextAreaField",
			Description: "A labelled multi-line textarea chunk. Wraps the `Textarea` primitive inside a `space-y-1.5` envelope with an optional `FormLabel`, the textarea, and optional help text. Use `Rows` to control the initial visible height.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",        "string?",                 false, "Label text rendered above the textarea via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "HelpText",     "string?",                 false, "Helper text rendered below the textarea. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",        "bool",                    false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",     "bool",                    false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",     "bool",                    false, "Disables the underlying textarea. Default: `false`." ),
				new ApiProperty( "Id",           "string",                  false, "HTML `id` for the textarea — wired to the label's `for` attribute. Auto-generated by default." ),
				new ApiProperty( "Value",        "string?",                 false, "Current textarea value. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged", "EventCallback<string?>",  false, "Fires when the value changes. Part of the `@bind-Value` pair." ),
				new ApiProperty( "Placeholder",  "string?",                 false, "Placeholder text shown in the empty textarea." ),
				new ApiProperty( "Rows",         "int",                     false, "Number of visible text rows. Default: `3`." ),
			]
		),
	];
}

@page "/chunks/checkbox-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="CheckboxField" Description="Labelled checkbox field with inline layout — wraps the Checkbox primitive with a right-side label and optional help text" Interactivity="ComponentInteractivity.Interactive" ApiElements="@CheckboxFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default checkbox field"
			Code="@("<CheckboxField Label=\"I agree to the terms and conditions\" @bind-Value=\"Agreed\" />")"
			Primitives="@("<div class=\"flex items-start gap-3\">\n    <div class=\"pt-0.5\"><button role=\"checkbox\" class=\"...\" /></div>\n    <div class=\"flex flex-col gap-1\">\n        <label class=\"text-sm font-medium text-foreground ...\">I agree to the terms and conditions</label>\n    </div>\n</div>")">
			<CheckboxField Label="I agree to the terms and conditions" @bind-Value="Agreed" />
		</ComponentExample>

		<ComponentExample Title="Checkbox field with help text"
			Code="@("<CheckboxField Label=\"Subscribe to newsletter\" HelpText=\"Receive weekly product updates and tips.\" @bind-Value=\"Subscribed\" />")"
			Primitives="@("<div class=\"flex items-start gap-3\">\n    <div class=\"pt-0.5\"><button role=\"checkbox\" class=\"...\" /></div>\n    <div class=\"flex flex-col gap-1\">\n        <label class=\"text-sm font-medium text-foreground ...\">Subscribe to newsletter</label>\n        <p class=\"text-xs text-muted-foreground\">Receive weekly product updates and tips.</p>\n    </div>\n</div>")">
			<CheckboxField Label="Subscribe to newsletter" HelpText="Receive weekly product updates and tips." @bind-Value="Subscribed" />
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private bool Agreed;
	private bool Subscribed;

	private static readonly ApiElement[] CheckboxFieldElements =
	[
		new ApiElement(
			Name: "CheckboxField",
			Description: "A labelled checkbox field chunk with inline layout. The checkbox sits on the left; the label and optional help text stack to the right. Wraps the `Checkbox` primitive.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",         "string?",             false, "Label text rendered to the right of the checkbox via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "HelpText",      "string?",             false, "Helper text rendered below the label. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",         "bool",                false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",      "bool",                false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",      "bool",                false, "Disables the underlying checkbox. Default: `false`." ),
				new ApiProperty( "Id",            "string",              false, "HTML `id` for the checkbox — wired to the label's `for` attribute. Auto-generated by default." ),
				new ApiProperty( "Value",         "bool",                false, "Whether the checkbox is checked. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged",  "EventCallback<bool>", false, "Fires when the checked state changes. Part of the `@bind-Value` pair." ),
			]
		),
	];
}

@page "/chunks/search-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="SearchField" Description="Labelled search input — wraps the SearchInput primitive family with a magnify icon, clear button, label, and help text" Interactivity="ComponentInteractivity.Interactive" ApiElements="@SearchFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default search field"
			Code="@("<SearchField Label=\"Search\" Placeholder=\"Search...\" @bind-Value=\"Query\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">Search</label>\n    <div data-slot=\"search-input\" role=\"group\" class=\"relative flex w-full items-center rounded-md border border-input h-10 ...\">\n        <div data-slot=\"search-input-left-element\" class=\"...\"><!-- icon --></div>\n        <input data-slot=\"search-input-control\" type=\"text\" placeholder=\"Search...\" class=\"...\" />\n        <div data-slot=\"search-input-right-element\" class=\"...\"><!-- clear button --></div>\n    </div>\n</div>")">
			<div class="max-w-sm">
				<SearchField Label="Search" Placeholder="Search..." @bind-Value="Query" />
				@if ( !string.IsNullOrEmpty( Query ) )
				{
					<p class="text-sm text-muted-foreground mt-2">Searching: @Query</p>
				}
			</div>
		</ComponentExample>

		<ComponentExample Title="With help text"
			Code="@("<SearchField Label=\"Find a user\" Placeholder=\"Name or email...\" HelpText=\"Search across all active users.\" @bind-Value=\"UserQuery\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">Find a user</label>\n    <div data-slot=\"search-input\" role=\"group\" class=\"relative flex w-full items-center rounded-md border border-input h-10 ...\">\n        <div data-slot=\"search-input-left-element\" class=\"...\"><!-- icon --></div>\n        <input data-slot=\"search-input-control\" type=\"text\" placeholder=\"Name or email...\" class=\"...\" />\n    </div>\n    <p class=\"text-xs text-muted-foreground\">Search across all active users.</p>\n</div>")">
			<div class="max-w-sm">
				<SearchField Label="Find a user" Placeholder="Name or email..." HelpText="Search across all active users." @bind-Value="UserQuery" />
			</div>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private string? Query;
	private string? UserQuery;

	private static readonly ApiElement[] SearchFieldElements =
	[
		new ApiElement(
			Name: "SearchField",
			Description: "A labelled search input chunk. Composes `SearchInput`, `SearchInputLeftElement` (with a magnify icon), `SearchInputField`, and a conditionally rendered `SearchInputClearButton` inside a `space-y-1.5` envelope. The clear button appears only when `Value` is non-empty. Clearing the value fires `ValueChanged` with `null`.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",         "string?",                 false, "Label text rendered above the search input via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "HelpText",      "string?",                 false, "Helper text rendered below the input. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",         "bool",                    false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",      "bool",                    false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",      "bool",                    false, "Disables the underlying search input. Default: `false`." ),
				new ApiProperty( "Id",            "string",                  false, "HTML `id` for the search input field — wired to the label's `for` attribute. Auto-generated by default." ),
				new ApiProperty( "Value",         "string?",                 false, "Current search query value. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged",  "EventCallback<string?>",  false, "Fires when the query changes, or with `null` when the clear button is pressed. Part of the `@bind-Value` pair." ),
				new ApiProperty( "Placeholder",   "string?",                 false, "Placeholder text shown in the empty search input." ),
			]
		),
	];
}

@page "/chunks/radio-group-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="RadioGroupField" Description="Labelled radio group field — wraps the RadioGroup primitive with a label above and one item per option" Interactivity="ComponentInteractivity.Interactive" ApiElements="@RadioGroupFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default radio group field"
			Code="@("<RadioGroupField Label=\"Notification preference\" Options=\"@NotifyOptions\" @bind-Value=\"Notify\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">Notification preference</label>\n    <div role=\"radiogroup\" class=\"grid gap-3\">\n        <div class=\"flex items-center gap-2\"><button role=\"radio\" class=\"...\" /><span>Email</span></div>\n        <div class=\"flex items-center gap-2\"><button role=\"radio\" class=\"...\" /><span>SMS</span></div>\n        <div class=\"flex items-center gap-2\"><button role=\"radio\" class=\"...\" /><span>Push</span></div>\n    </div>\n</div>")">
			<div class="max-w-sm">
				<RadioGroupField Label="Notification preference" Options="@NotifyOptions" @bind-Value="Notify" />
			</div>
		</ComponentExample>

		<ComponentExample Title="Radio group field with help text and error state"
			Code="@("<RadioGroupField Label=\"Billing cycle\" Required=\"true\" Error=\"true\" HelpText=\"Please select a billing cycle.\" Options=\"@BillingOptions\" @bind-Value=\"Billing\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-danger-fg ...\">Billing cycle<span class=\"text-danger-fg\">*</span></label>\n    <div role=\"radiogroup\" class=\"grid gap-3\">\n        <div class=\"flex items-center gap-2\"><button role=\"radio\" class=\"...\" /><span>Monthly</span></div>\n        <div class=\"flex items-center gap-2\"><button role=\"radio\" class=\"...\" /><span>Annually</span></div>\n    </div>\n    <p class=\"text-xs text-danger-fg\">Please select a billing cycle.</p>\n</div>")">
			<div class="max-w-sm">
				<RadioGroupField Label="Billing cycle" Required="true" Error="true" HelpText="Please select a billing cycle." Options="@BillingOptions" @bind-Value="Billing" />
			</div>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private string? Notify;
	private string? Billing;

	private static readonly List<RadioGroupField.RadioFieldOption> NotifyOptions =
	[
		new( "email", "Email" ),
		new( "sms", "SMS" ),
		new( "push", "Push notification" ),
	];

	private static readonly List<RadioGroupField.RadioFieldOption> BillingOptions =
	[
		new( "monthly", "Monthly" ),
		new( "annually", "Annually" ),
	];

	private static readonly ApiElement[] RadioGroupFieldElements =
	[
		new ApiElement(
			Name: "RadioGroupField",
			Description: "A labelled radio group field chunk. Renders a `FormLabel` above a vertical `RadioGroup` with one `RadioGroupItem` per option. Wraps the `RadioGroup` and `RadioGroupItem` primitives.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",        "string?",                               false, "Label text rendered above the radio group via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "HelpText",     "string?",                               false, "Helper text rendered below the group. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",        "bool",                                  false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",     "bool",                                  false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",     "bool",                                  false, "Disables the underlying radio group. Default: `false`." ),
				new ApiProperty( "Id",           "string",                                false, "HTML `id` — auto-generated by default." ),
				new ApiProperty( "Value",        "string?",                               false, "Currently selected option value. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged", "EventCallback<string?>",                false, "Fires when the selected value changes. Part of the `@bind-Value` pair." ),
				new ApiProperty( "Options",      "IList<RadioGroupField.RadioFieldOption>?", false, "The list of radio options to render. Each option has `Value` and `Label` properties." ),
			]
		),
	];
}

@page "/chunks/password-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="PasswordField" Description="Labelled password input with show/hide toggle — wraps the Input primitive with a plaintext reveal button" Interactivity="ComponentInteractivity.Interactive" ApiElements="@PasswordFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default password field"
			Code="@("<PasswordField Label=\"Password\" Placeholder=\"Enter your password\" @bind-Value=\"Password\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">Password</label>\n    <div class=\"relative\">\n        <input type=\"password\" placeholder=\"Enter your password\" class=\"...\" />\n        <button type=\"button\" class=\"absolute right-2 top-1/2 -translate-y-1/2 ...\"><!-- eye icon --></button>\n    </div>\n</div>")">
			<div class="max-w-sm">
				<PasswordField Label="Password" Placeholder="Enter your password" @bind-Value="Password" />
			</div>
		</ComponentExample>

		<ComponentExample Title="With help text"
			Code="@("<PasswordField Label=\"New password\" Placeholder=\"At least 8 characters\" HelpText=\"Use a mix of letters, numbers, and symbols.\" @bind-Value=\"NewPassword\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">New password</label>\n    <div class=\"relative\">\n        <input type=\"password\" placeholder=\"At least 8 characters\" class=\"...\" />\n        <button type=\"button\" class=\"absolute right-2 top-1/2 -translate-y-1/2 ...\"><!-- eye icon --></button>\n    </div>\n    <p class=\"text-xs text-muted-foreground\">Use a mix of letters, numbers, and symbols.</p>\n</div>")">
			<div class="max-w-sm">
				<PasswordField Label="New password" Placeholder="At least 8 characters" HelpText="Use a mix of letters, numbers, and symbols." @bind-Value="NewPassword" />
			</div>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private string? Password;
	private string? NewPassword;

	private static readonly ApiElement[] PasswordFieldElements =
	[
		new ApiElement(
			Name: "PasswordField",
			Description: "A labelled password input chunk. Wraps the `Input` primitive with `type=password` and a show/hide toggle button positioned inside the input using `relative`/`absolute` positioning. Clicking the toggle reveals or masks the value.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",        "string?",                 false, "Label text rendered above the input via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "HelpText",     "string?",                 false, "Helper text rendered below the input. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",        "bool",                    false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",     "bool",                    false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",     "bool",                    false, "Disables the underlying input. Default: `false`." ),
				new ApiProperty( "Id",           "string",                  false, "HTML `id` for the input — wired to the label's `for` attribute. Auto-generated by default." ),
				new ApiProperty( "Value",        "string?",                 false, "Current password value. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged", "EventCallback<string?>",  false, "Fires when the value changes. Part of the `@bind-Value` pair." ),
				new ApiProperty( "Placeholder",  "string?",                 false, "Placeholder text shown in the empty input." ),
			]
		),
	];
}

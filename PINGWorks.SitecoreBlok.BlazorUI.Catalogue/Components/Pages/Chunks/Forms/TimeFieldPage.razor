@page "/chunks/time-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="TimeField" Description="Labelled time-picker field — wraps the TimePicker primitive with a label above and optional help text" Interactivity="ComponentInteractivity.Interactive" ApiElements="@TimeFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default time field"
			Code="@("<TimeField Label=\"Meeting time\" @bind-Value=\"MeetingTime\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">Meeting time</label>\n    <div data-slot=\"time-picker\" class=\"inline-flex\">\n        <input type=\"time\" class=\"border-input bg-background rounded-md border px-3 py-2 text-sm ...\" />\n    </div>\n</div>")">
			<div class="max-w-sm">
				<TimeField Label="Meeting time" @bind-Value="MeetingTime" />
			</div>
		</ComponentExample>

		<ComponentExample Title="Time field with help text and error state"
			Code="@("<TimeField Label=\"Closing time\" Required=\"true\" Error=\"true\" HelpText=\"Closing time is required.\" @bind-Value=\"ClosingTime\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-danger-fg ...\">Closing time<span class=\"text-danger-fg\">*</span></label>\n    <div data-slot=\"time-picker\" class=\"inline-flex\">\n        <input type=\"time\" class=\"border-input bg-background rounded-md border px-3 py-2 text-sm ...\" />\n    </div>\n    <p class=\"text-xs text-danger-fg\">Closing time is required.</p>\n</div>")">
			<div class="max-w-sm">
				<TimeField Label="Closing time" Required="true" Error="true" HelpText="Closing time is required." @bind-Value="ClosingTime" />
			</div>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private TimeSpan? MeetingTime;
	private TimeSpan? ClosingTime;

	private static readonly ApiElement[] TimeFieldElements =
	[
		new ApiElement(
			Name: "TimeField",
			Description: "A labelled time-picker field chunk. Renders a `FormLabel` above a `TimePicker` input. Wraps the `TimePicker` primitive.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",        "string?",                  false, "Label text rendered above the time picker via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "HelpText",     "string?",                  false, "Helper text rendered below the picker. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",        "bool",                     false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",     "bool",                     false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",     "bool",                     false, "Disables the underlying time picker. Default: `false`." ),
				new ApiProperty( "Id",           "string",                   false, "HTML `id` — auto-generated by default." ),
				new ApiProperty( "Value",        "TimeSpan?",                false, "Currently selected time. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged", "EventCallback<TimeSpan?>", false, "Fires when the selected time changes. Part of the `@bind-Value` pair." ),
			]
		),
	];
}

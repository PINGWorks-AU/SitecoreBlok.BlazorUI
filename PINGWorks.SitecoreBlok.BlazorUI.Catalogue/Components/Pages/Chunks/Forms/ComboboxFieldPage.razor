@page "/chunks/combobox-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="ComboboxField" Description="Labelled searchable combobox field — wraps the Combobox primitive cluster with a label, help text, and error state" Interactivity="ComponentInteractivity.Interactive" ApiElements="@ComboboxFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default combobox field"
			Code="@("<ComboboxField Label=\"Framework\" Placeholder=\"Search frameworks...\" Items=\"@Frameworks\" @bind-Value=\"Framework\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">Framework</label>\n    <Combobox>\n        <ComboboxInput Placeholder=\"Search frameworks...\" />\n        <ComboboxContent>\n            <ComboboxList>\n                <ComboboxItem Value=\"blazor\" Label=\"Blazor\" />\n                ...\n                <ComboboxEmpty>No results found.</ComboboxEmpty>\n            </ComboboxList>\n        </ComboboxContent>\n    </Combobox>\n</div>")">
			<div class="max-w-sm">
				<ComboboxField Label="Framework" Placeholder="Search frameworks..." Items="@Frameworks" @bind-Value="Framework" />
			</div>
		</ComponentExample>

		<ComponentExample Title="Combobox field with help text and error state"
			Code="@("<ComboboxField Label=\"Team member\" Placeholder=\"Search members...\" Required=\"true\" Error=\"true\" HelpText=\"Please assign a team member.\" Items=\"@Members\" @bind-Value=\"Member\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-danger-fg ...\">Team member<span class=\"text-danger-fg\">*</span></label>\n    <Combobox>\n        <ComboboxInput Placeholder=\"Search members...\" />\n        <ComboboxContent>\n            <ComboboxList>\n                <ComboboxItem Value=\"alice\" Label=\"Alice\" />\n                ...\n                <ComboboxEmpty>No results found.</ComboboxEmpty>\n            </ComboboxList>\n        </ComboboxContent>\n    </Combobox>\n    <p class=\"text-xs text-danger-fg\">Please assign a team member.</p>\n</div>")">
			<div class="max-w-sm">
				<ComboboxField Label="Team member" Placeholder="Search members..." Required="true" Error="true" HelpText="Please assign a team member." Items="@Members" @bind-Value="Member" />
			</div>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private string? Framework;
	private string? Member;

	private static readonly List<ComboboxField.ComboboxFieldItem> Frameworks =
	[
		new( "blazor", "Blazor" ),
		new( "react", "React" ),
		new( "vue", "Vue" ),
		new( "angular", "Angular" ),
		new( "svelte", "Svelte" ),
	];

	private static readonly List<ComboboxField.ComboboxFieldItem> Members =
	[
		new( "alice", "Alice" ),
		new( "bob", "Bob" ),
		new( "carol", "Carol" ),
		new( "dave", "Dave" ),
	];

	private static readonly ApiElement[] ComboboxFieldElements =
	[
		new ApiElement(
			Name: "ComboboxField",
			Description: "A labelled searchable combobox field chunk. Wraps the `Combobox` primitive cluster inside a `space-y-1.5` envelope with an optional `FormLabel`, the combobox input and items with filter support, and optional help text.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",        "string?",                               false, "Label text rendered above the combobox via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "HelpText",     "string?",                               false, "Helper text rendered below the combobox. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",        "bool",                                  false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",     "bool",                                  false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",     "bool",                                  false, "Disables the underlying combobox. Default: `false`." ),
				new ApiProperty( "Id",           "string",                                false, "HTML `id` wired to the label's `for` attribute. Auto-generated by default." ),
				new ApiProperty( "Value",        "string?",                               false, "Currently selected value. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged", "EventCallback<string?>",                false, "Fires when the selected value changes. Part of the `@bind-Value` pair." ),
				new ApiProperty( "Placeholder",  "string?",                               false, "Placeholder text shown in the search input when empty." ),
				new ApiProperty( "Items",        "IList<ComboboxField.ComboboxFieldItem>?", false, "The list of options to render. Each item has `Value` and `Label` properties. Items are filtered by the user's typed text." ),
			]
		),
	];
}

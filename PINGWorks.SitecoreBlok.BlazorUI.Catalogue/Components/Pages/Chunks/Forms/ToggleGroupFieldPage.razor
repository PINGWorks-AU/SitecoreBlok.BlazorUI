@page "/chunks/toggle-group-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="ToggleGroupField" Description="Labelled toggle-group field — wraps the ToggleGroup primitive with a label above and one button per option" Interactivity="ComponentInteractivity.Interactive" ApiElements="@ToggleGroupFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default toggle group field (icon options)"
			Code="@("<ToggleGroupField Label=\"Text alignment\" Options=\"@AlignOptions\" @bind-Value=\"Align\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">Text alignment</label>\n    <div data-slot=\"toggle-group\" role=\"group\" class=\"group/toggle-group flex w-fit items-center rounded-md\">\n        <button data-slot=\"toggle-group-item\" type=\"button\" class=\"...\"><svg class=\"size-4\"><!-- format-align-left --></svg></button>\n        <button data-slot=\"toggle-group-item\" type=\"button\" class=\"...\"><svg class=\"size-4\"><!-- format-align-center --></svg></button>\n        <button data-slot=\"toggle-group-item\" type=\"button\" class=\"...\"><svg class=\"size-4\"><!-- format-align-right --></svg></button>\n    </div>\n</div>")">
			<div class="max-w-sm">
				<ToggleGroupField Label="Text alignment" Options="@AlignOptions" @bind-Value="Align" />
			</div>
		</ComponentExample>

		<ComponentExample Title="Toggle group field with help text, error state, and icon options"
			Code="@("<ToggleGroupField Label=\"Priority\" Required=\"true\" Error=\"true\" HelpText=\"Please select a priority level.\" Options=\"@PriorityOptions\" @bind-Value=\"Priority\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-danger-fg ...\">Priority<span class=\"text-danger-fg\">*</span></label>\n    <div data-slot=\"toggle-group\" role=\"group\" class=\"group/toggle-group flex w-fit items-center rounded-md\">\n        <button data-slot=\"toggle-group-item\" type=\"button\" class=\"...\"><svg class=\"size-4\"><!-- arrow-down --></svg></button>\n        <button data-slot=\"toggle-group-item\" type=\"button\" class=\"...\"><svg class=\"size-4\"><!-- minus --></svg></button>\n        <button data-slot=\"toggle-group-item\" type=\"button\" class=\"...\"><svg class=\"size-4\"><!-- arrow-up --></svg></button>\n    </div>\n    <p class=\"text-xs text-danger-fg\">Please select a priority level.</p>\n</div>")">
			<div class="max-w-sm">
				<ToggleGroupField Label="Priority" Required="true" Error="true" HelpText="Please select a priority level." Options="@PriorityOptions" @bind-Value="Priority" />
			</div>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private string? Align;
	private string? Priority;

	private static readonly List<ToggleGroupField.ToggleGroupOption> AlignOptions =
	[
		new( "left",   "Left",   IconSvg: IconSvg.FormatAlignLeft ),
		new( "center", "Center", IconSvg: IconSvg.FormatAlignCenter ),
		new( "right",  "Right",  IconSvg: IconSvg.FormatAlignRight ),
	];

	private static readonly List<ToggleGroupField.ToggleGroupOption> PriorityOptions =
	[
		new( "low",    "Low",    IconSvg: IconSvg.ArrowDown ),
		new( "medium", "Medium", IconSvg: IconSvg.Minus ),
		new( "high",   "High",   IconSvg: IconSvg.ArrowUp ),
	];

	private static readonly ApiElement[] ToggleGroupFieldElements =
	[
		new ApiElement(
			Name: "ToggleGroupField",
			Description: "A labelled toggle-group field chunk. Renders a `FormLabel` above a horizontal `ToggleGroup` with one `ToggleGroupItem` per option. When an option provides `IconSvg`, the icon is rendered inside the button instead of the label string — ideal for icon-only toolbars such as alignment or formatting selectors. Wraps the `ToggleGroup` and `ToggleGroupItem` primitives.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",        "string?",                                  false, "Label text rendered above the toggle group via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "HelpText",     "string?",                                  false, "Helper text rendered below the group. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",        "bool",                                     false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",     "bool",                                     false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",     "bool",                                     false, "Disables the underlying toggle group. Default: `false`." ),
				new ApiProperty( "Id",           "string",                                   false, "HTML `id` — auto-generated by default." ),
				new ApiProperty( "Value",        "string?",                                  false, "Currently active option value. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged", "EventCallback<string?>",                   false, "Fires when the active value changes. Part of the `@bind-Value` pair." ),
				new ApiProperty( "Options",      "IList<ToggleGroupField.ToggleGroupOption>?", false, "The list of toggle options to render. Each option is a record with `Value`, `Label`, and an optional `IconSvg` property." ),
				new ApiProperty( "Gap",          "Size",                                     false, "Inter-button spacing on the underlying `ToggleGroup`. Mapped through `SizeClasses.Gap` (e.g. `Size.Xs` → `gap-2`, `Size.Sm` → `gap-3`). Default: `Size.Xs3`." ),
			]
		),
		new ApiElement(
			Name: "ToggleGroupField.ToggleGroupOption",
			Description: "Record describing a single option in the toggle group.",
			Depth: 1,
			Properties:
			[
				new ApiProperty( "Value",   "string",  true,  "The value emitted when this option is selected. Matched against `ToggleGroupField.Value`." ),
				new ApiProperty( "Label",   "string",  true,  "Display label. Rendered as the button text when `IconSvg` is null." ),
				new ApiProperty( "IconSvg", "string?", false, "Optional SVG path (e.g. `IconSvg.FormatAlignLeft`). When provided, renders `<Icon Svg=\"...\" ClassName=\"size-4\" />` inside the button instead of the label string." ),
			]
		),
	];
}

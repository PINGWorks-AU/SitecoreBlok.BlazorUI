@page "/chunks/select-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="SelectField" Description="Labelled select-dropdown field — wraps the Select primitive cluster with a label, help text, and error state" Interactivity="ComponentInteractivity.Interactive" ApiElements="@SelectFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default select field"
			Code="@("<SelectField Label=\"Country\" Placeholder=\"Pick a country\" Items=\"@Countries\" @bind-Value=\"Country\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">Country</label>\n    <Select>\n        <SelectTrigger><SelectValue Placeholder=\"Pick a country\" /></SelectTrigger>\n        <SelectContent>\n            <SelectItem Value=\"au\" Label=\"Australia\" />\n            ...\n        </SelectContent>\n    </Select>\n</div>")">
			<div class="max-w-sm">
				<SelectField Label="Country" Placeholder="Pick a country" Items="@Countries" @bind-Value="Country" />
			</div>
		</ComponentExample>

		<ComponentExample Title="Select field with help text and error state"
			Code="@("<SelectField Label=\"Priority\" Placeholder=\"Select priority\" Required=\"true\" Error=\"true\" HelpText=\"Priority is required.\" Items=\"@Priorities\" @bind-Value=\"Priority\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-danger-fg ...\">Priority<span class=\"text-danger-fg\">*</span></label>\n    <Select>\n        <SelectTrigger><SelectValue Placeholder=\"Select priority\" /></SelectTrigger>\n        <SelectContent>\n            <SelectItem Value=\"low\" Label=\"Low\" />\n            ...\n        </SelectContent>\n    </Select>\n    <p class=\"text-xs text-danger-fg\">Priority is required.</p>\n</div>")">
			<div class="max-w-sm">
				<SelectField Label="Priority" Placeholder="Select priority" Required="true" Error="true" HelpText="Priority is required." Items="@Priorities" @bind-Value="Priority" />
			</div>
		</ComponentExample>

		<ComponentExample Title="Select field with a value already set"
			Code="@("<SelectField Label=\"Country\" Placeholder=\"Pick a country\" Items=\"@Countries\" @bind-Value=\"PresetCountry\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">Country</label>\n    <Select Value=\"au\" ValueLabel=\"Australia\">\n        <SelectTrigger><SelectValue Placeholder=\"Pick a country\" /></SelectTrigger>\n        <SelectContent>\n            <SelectItem Value=\"au\" Label=\"Australia\" />\n            ...\n        </SelectContent>\n    </Select>\n</div>")">
			<div class="max-w-sm">
				<SelectField Label="Country" Placeholder="Pick a country" Items="@Countries" @bind-Value="PresetCountry" />
			</div>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private string? Country;
	private string? Priority;

	/// <summary>A value set before the field is first opened, for the preset-value example.</summary>
	private string? PresetCountry = "au";

	private static readonly List<SelectField.SelectFieldItem> Countries =
	[
		new( "au", "Australia" ),
		new( "us", "United States" ),
		new( "uk", "United Kingdom" ),
		new( "ca", "Canada" ),
	];

	private static readonly List<SelectField.SelectFieldItem> Priorities =
	[
		new( "low", "Low" ),
		new( "medium", "Medium" ),
		new( "high", "High" ),
		new( "critical", "Critical" ),
	];

	private static readonly ApiElement[] SelectFieldElements =
	[
		new ApiElement(
			Name: "SelectField",
			Description: "A labelled select-dropdown field chunk. Wraps the `Select` primitive cluster inside a `space-y-1.5` envelope with an optional `FormLabel`, the select trigger and items, and optional help text.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",        "string?",                           false, "Label text rendered above the select via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "HelpText",     "string?",                           false, "Helper text rendered below the select. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",        "bool",                              false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",     "bool",                              false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",     "bool",                              false, "Disables the underlying select. Default: `false`." ),
				new ApiProperty( "Id",           "string",                            false, "HTML `id` wired to the label's `for` attribute. Auto-generated by default." ),
				new ApiProperty( "Value",        "string?",                           false, "Currently selected value. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged", "EventCallback<string?>",            false, "Fires when the selected value changes. Part of the `@bind-Value` pair." ),
				new ApiProperty( "Placeholder",  "string?",                           false, "Placeholder text shown in the trigger when no value is selected." ),
				new ApiProperty( "Items",        "IList<SelectField.SelectFieldItem>?", false, "The list of options to render. Each item has `Value` and `Label` properties." ),
			]
		),
	];
}

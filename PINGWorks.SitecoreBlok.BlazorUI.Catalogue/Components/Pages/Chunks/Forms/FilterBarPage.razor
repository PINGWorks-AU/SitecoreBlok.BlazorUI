@page "/chunks/filter-bar"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="FilterBar" Description="Horizontal filter-chip row with an optional trailing clear-all action" Interactivity="ComponentInteractivity.Interactive" ApiElements="@FilterBarElements">

	<ExamplesSection>

		<ComponentExample Title="Filter bar with active chips"
			Code="@("<FilterBar>\n    <Filters>\n        @foreach ( var filter in BasicFilters )\n        {\n            var name = filter;\n            <FilterChip Label=\"@name\" OnRemove=\"@(() => BasicFilters.Remove( name ))\" />\n        }\n    </Filters>\n</FilterBar>")"
			Primitives="@("<div class=\"flex items-center gap-2 flex-wrap\">\n    <span class=\"inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1 text-xs\"><span>Status: Active</span><button aria-label=\"Remove\">×</button></span>\n    <span class=\"inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1 text-xs\"><span>Type: Admin</span><button aria-label=\"Remove\">×</button></span>\n</div>")">
			<div class="space-y-2">
				<FilterBar>
					<Filters>
						@foreach ( var filter in BasicFilters )
						{
							var name = filter;
							<FilterChip Label="@name" OnRemove="@(() => BasicFilters.Remove( name ))" />
						}
					</Filters>
				</FilterBar>
				@if ( BasicFilters.Count == 0 )
				{
					<Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="ResetBasicFilters">Reset</Button>
				}
			</div>
		</ComponentExample>

		<ComponentExample Title="Filter bar with clear-all action"
			Code="@("<FilterBar>\n    <Filters>\n        @foreach ( var filter in ClearableFilters )\n        {\n            var name = filter;\n            <FilterChip Label=\"@name\" OnRemove=\"@(() => ClearableFilters.Remove( name ))\" />\n        }\n    </Filters>\n    <ClearAction>\n        <Button Variant=\"ButtonVariant.Ghost\" Size=\"ButtonSize.Sm\" @onclick=\"@(() => ClearableFilters.Clear())\">Clear filters</Button>\n    </ClearAction>\n</FilterBar>")"
			Primitives="@("<div class=\"flex items-center gap-2 flex-wrap\">\n    <span class=\"inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1 text-xs\"><span>Region: APAC</span><button aria-label=\"Remove\">×</button></span>\n    <span class=\"inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1 text-xs\"><span>Role: Editor</span><button aria-label=\"Remove\">×</button></span>\n    <span class=\"inline-flex items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1 text-xs\"><span>Status: Active</span><button aria-label=\"Remove\">×</button></span>\n    <div class=\"ml-auto\">\n        <button class=\"...\">Clear filters</button>\n    </div>\n</div>")">
			<div class="space-y-2">
				<FilterBar>
					<Filters>
						@foreach ( var filter in ClearableFilters )
						{
							var name = filter;
							<FilterChip Label="@name" OnRemove="@(() => ClearableFilters.Remove( name ))" />
						}
					</Filters>
					<ClearAction>
						<Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" @onclick="@(() => ClearableFilters.Clear())">Clear filters</Button>
					</ClearAction>
				</FilterBar>
				@if ( ClearableFilters.Count == 0 )
				{
					<Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="ResetClearableFilters">Reset</Button>
				}
			</div>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private List<string> BasicFilters = ["Status: Active", "Type: Admin"];

	private List<string> ClearableFilters = ["Region: APAC", "Role: Editor", "Status: Active"];

	private void ResetBasicFilters()
		=> BasicFilters = ["Status: Active", "Type: Admin"];

	private void ResetClearableFilters()
		=> ClearableFilters = ["Region: APAC", "Role: Editor", "Status: Active"];

	private static readonly ApiElement[] FilterBarElements =
	[
		new ApiElement(
			Name: "FilterBar",
			Description: "A horizontal filter-chip row. Renders a `flex items-center gap-2 flex-wrap` container. The `Filters` slot holds `FilterChip` chunks or other badge elements; the optional `ClearAction` slot renders at the trailing end (e.g. a ghost \"Clear filters\" button). Wire each `FilterChip`'s `OnRemove` to remove the corresponding filter from state.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Filters",     "RenderFragment?", false, "`FilterChip` elements rendered in a wrapping flex row." ),
				new ApiProperty( "ClearAction", "RenderFragment?", false, "Optional trailing slot for a clear-all action. Pinned to the end with `ml-auto`." ),
			]
		),
	];
}

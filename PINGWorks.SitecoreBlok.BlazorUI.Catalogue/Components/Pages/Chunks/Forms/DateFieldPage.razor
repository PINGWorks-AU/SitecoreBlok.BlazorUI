@page "/chunks/date-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="DateField" Description="Labelled date-picker field — wraps the DatePicker primitive with a label above and optional help text" Interactivity="ComponentInteractivity.Interactive" ApiElements="@DateFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default date field"
			Code="@("<DateField Label=\"Date of birth\" @bind-Value=\"DateOfBirth\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-foreground ...\">Date of birth</label>\n    <div data-slot=\"date-picker\" class=\"relative inline-block\">\n        <button class=\"...\"><svg ... />Pick a date</button>\n    </div>\n</div>")">
			<div class="max-w-sm">
				<DateField Label="Date of birth" @bind-Value="DateOfBirth" />
			</div>
		</ComponentExample>

		<ComponentExample Title="Date field with help text and error state"
			Code="@("<DateField Label=\"Contract start date\" Required=\"true\" Error=\"true\" HelpText=\"Start date is required.\" @bind-Value=\"ContractStart\" />")"
			Primitives="@("<div class=\"space-y-1.5\">\n    <label class=\"text-sm font-medium text-danger-fg ...\">Contract start date<span class=\"text-danger-fg\">*</span></label>\n    <div data-slot=\"date-picker\" class=\"relative inline-block\">\n        <button class=\"...\"><svg ... />Pick a date</button>\n    </div>\n    <p class=\"text-xs text-danger-fg\">Start date is required.</p>\n</div>")">
			<div class="max-w-sm">
				<DateField Label="Contract start date" Required="true" Error="true" HelpText="Start date is required." @bind-Value="ContractStart" />
			</div>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private DateTime? DateOfBirth;
	private DateTime? ContractStart;

	private static readonly ApiElement[] DateFieldElements =
	[
		new ApiElement(
			Name: "DateField",
			Description: "A labelled date-picker field chunk. Renders a `FormLabel` above a `DatePicker` popover button. Wraps the `DatePicker` primitive.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",        "string?",                false, "Label text rendered above the date picker via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "HelpText",     "string?",                false, "Helper text rendered below the picker. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",        "bool",                   false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",     "bool",                   false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",     "bool",                   false, "Disables the underlying date picker. Default: `false`." ),
				new ApiProperty( "Id",           "string",                 false, "HTML `id` — auto-generated by default." ),
				new ApiProperty( "Value",        "DateTime?",              false, "Currently selected date. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged", "EventCallback<DateTime?>", false, "Fires when the selected date changes. Part of the `@bind-Value` pair." ),
			]
		),
	];
}

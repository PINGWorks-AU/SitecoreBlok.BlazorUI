@page "/chunks/switch-field"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="SwitchField" Description="Labelled switch field with inline layout — wraps the Switch primitive with a right-side label and optional help text" Interactivity="ComponentInteractivity.Interactive" ApiElements="@SwitchFieldElements">

	<ExamplesSection>

		<ComponentExample Title="Default switch field"
			Code="@("<SwitchField Label=\"Enable notifications\" @bind-Value=\"NotificationsOn\" />")"
			Primitives="@("<div class=\"flex items-start gap-3\">\n    <div class=\"pt-0.5\"><button role=\"switch\" class=\"...\" /></div>\n    <div class=\"flex flex-col gap-1\">\n        <label class=\"text-sm font-medium text-foreground ...\">Enable notifications</label>\n    </div>\n</div>")">
			<SwitchField Label="Enable notifications" @bind-Value="NotificationsOn" />
		</ComponentExample>

		<ComponentExample Title="Switch field with help text"
			Code="@("<SwitchField Label=\"Dark mode\" HelpText=\"Switch between light and dark interface theme.\" @bind-Value=\"DarkMode\" />")"
			Primitives="@("<div class=\"flex items-start gap-3\">\n    <div class=\"pt-0.5\"><button role=\"switch\" class=\"...\" /></div>\n    <div class=\"flex flex-col gap-1\">\n        <label class=\"text-sm font-medium text-foreground ...\">Dark mode</label>\n        <p class=\"text-xs text-muted-foreground\">Switch between light and dark interface theme.</p>\n    </div>\n</div>")">
			<SwitchField Label="Dark mode" HelpText="Switch between light and dark interface theme." @bind-Value="DarkMode" />
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private bool NotificationsOn;
	private bool DarkMode;

	private static readonly ApiElement[] SwitchFieldElements =
	[
		new ApiElement(
			Name: "SwitchField",
			Description: "A labelled switch field chunk with inline layout. The switch sits on the left; the label and optional help text stack to the right. Wraps the `Switch` primitive.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",         "string?",             false, "Label text rendered to the right of the switch via `FormLabel`. Omit to hide the label." ),
				new ApiProperty( "HelpText",      "string?",             false, "Helper text rendered below the label. Shown in `text-danger-fg` when `Error` is true, otherwise `text-muted-foreground`." ),
				new ApiProperty( "Error",         "bool",                false, "Applies error styling to the label and help text. Default: `false`." ),
				new ApiProperty( "Required",      "bool",                false, "Appends a red asterisk to the label via `FormLabel`. Default: `false`." ),
				new ApiProperty( "Disabled",      "bool",                false, "Disables the underlying switch. Default: `false`." ),
				new ApiProperty( "Id",            "string",              false, "HTML `id` wired to the label's `for` attribute. Auto-generated by default." ),
				new ApiProperty( "Value",         "bool",                false, "Whether the switch is on. Use `@bind-Value` for two-way binding." ),
				new ApiProperty( "ValueChanged",  "EventCallback<bool>", false, "Fires when the switch state changes. Part of the `@bind-Value` pair." ),
			]
		),
	];
}

@page "/chunks/stat-card"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="StatCard" Description="Card-based KPI variant with optional Sparkline and Actions slots" Interactivity="ComponentInteractivity.Ssr" ApiElements="@StatCardElements">

	<ExamplesSection>

		<ComponentExample Title="Minimal — label, value and trend"
			Code="@("<StatCard Label=\"Active subscriptions\" Value=\"2,340\" Trend=\"Trend.Up\" />")"
			Primitives="@("<div class=\"flex flex-col border border-border rounded-lg bg-background p-4 gap-3\">\n    <div class=\"flex items-start justify-between gap-2\">\n        <div class=\"flex flex-col gap-1\">\n            <span class=\"text-sm text-muted-foreground\">Active subscriptions</span>\n            <span class=\"text-2xl font-bold tracking-tight text-foreground\">2,340</span>\n        </div>\n        <div class=\"inline-flex items-center justify-center size-7 rounded-full bg-success-bg text-success-fg\">\n            <svg ...><!-- up arrow --></svg>\n        </div>\n    </div>\n</div>")">
			<StatCard Label="Active subscriptions" Value="2,340" Trend="Trend.Up" />
		</ComponentExample>

		<ComponentExample Title="With Sparkline slot"
			Code="@("<StatCard Label=\"Weekly revenue\" Value=\"$18,540\" Trend=\"Trend.Up\">\n    <Sparkline>\n        <svg viewBox=\"0 0 100 30\" class=\"w-full h-full text-success-fg\">\n            <polyline fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" points=\"0,20 25,15 50,18 75,8 100,5\" />\n        </svg>\n    </Sparkline>\n</StatCard>")"
			Primitives="@("<div class=\"flex flex-col border border-border rounded-lg bg-background p-4 gap-3\">\n    <div class=\"flex items-start justify-between gap-2\">\n        <div class=\"flex flex-col gap-1\">\n            <span class=\"text-sm text-muted-foreground\">Weekly revenue</span>\n            <span class=\"text-2xl font-bold tracking-tight text-foreground\">$18,540</span>\n        </div>\n        <div class=\"inline-flex items-center justify-center size-7 rounded-full bg-success-bg text-success-fg\">\n            <svg ...><!-- up arrow --></svg>\n        </div>\n    </div>\n    <div class=\"h-12\">\n        <svg viewBox=\"0 0 100 30\" class=\"w-full h-full text-success-fg\">\n            <polyline fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" points=\"0,20 25,15 50,18 75,8 100,5\" />\n        </svg>\n    </div>\n</div>")">
			<StatCard Label="Weekly revenue" Value="$18,540" Trend="Trend.Up">
				<Sparkline>
					<svg viewBox="0 0 100 30" class="w-full h-full text-success-fg">
						<polyline fill="none" stroke="currentColor" stroke-width="2" points="0,20 25,15 50,18 75,8 100,5" />
					</svg>
				</Sparkline>
			</StatCard>
		</ComponentExample>

		<ComponentExample Title="With Actions slot"
			Code="@("<StatCard Label=\"Failed jobs\" Value=\"7\" Trend=\"Trend.Down\">\n    <Actions>\n        <Button Variant=\"ButtonVariant.Outline\" Size=\"ButtonSize.Sm\">View logs</Button>\n    </Actions>\n</StatCard>")"
			Primitives="@("<div class=\"flex flex-col border border-border rounded-lg bg-background p-4 gap-3\">\n    <div class=\"flex items-start justify-between gap-2\">\n        <div class=\"flex flex-col gap-1\">\n            <span class=\"text-sm text-muted-foreground\">Failed jobs</span>\n            <span class=\"text-2xl font-bold tracking-tight text-foreground\">7</span>\n        </div>\n        <div class=\"inline-flex items-center justify-center size-7 rounded-full bg-danger-bg text-danger-fg\">\n            <svg ...><!-- down arrow --></svg>\n        </div>\n    </div>\n    <div class=\"flex items-center gap-2 mt-auto pt-2 border-t border-border\">\n        <button class=\"...\">View logs</button>\n    </div>\n</div>")">
			<StatCard Label="Failed jobs" Value="7" Trend="Trend.Down">
				<Actions>
					<Button Variant="ButtonVariant.Outline" Size="ButtonSize.Sm">View logs</Button>
				</Actions>
			</StatCard>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private static readonly ApiElement[] StatCardElements =
	[
		new ApiElement(
			Name: "StatCard",
			Description: "A card-based KPI variant that pairs a label and bold value with a tonal trend badge. Supports an optional Sparkline slot for inline charts and an Actions slot for contextual buttons or links. Wrapper-styling.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",    "string",          false, "Descriptive label shown above the value in `text-sm text-muted-foreground`. Default: empty string." ),
				new ApiProperty( "Value",    "string",          false, "The primary metric value, rendered large and bold. Default: empty string." ),
				new ApiProperty( "Trend",    "Trend",           false, "Controls the tonal badge colour and icon direction. `Up` = success, `Down` = danger, `Neutral` = neutral. Default: `Trend.Neutral`." ),
				new ApiProperty( "Sparkline", "RenderFragment?", false, "Optional slot for an inline chart or sparkline SVG. Rendered inside a `h-12` container. Omit to suppress." ),
				new ApiProperty( "Actions",  "RenderFragment?", false, "Optional slot for buttons or links, rendered below a top border at the card's foot. Omit to suppress." ),
				new ApiProperty( "Borders",  "bool",            false, "Toggles `border border-border rounded-lg`. Default: `true`." ),
				new ApiProperty( "BgFilled", "bool",            false, "Toggles `bg-background`. Default: `true`." ),
				new ApiProperty( "Gutters",  "bool",            false, "Toggles `p-4 gap-3` on the card wrapper. Default: `true`." ),
			]
		),
	];
}

@page "/chunks/kpi-tile"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="KpiTile" Description="Single big-number stat tile for dashboards and summary panels" Interactivity="ComponentInteractivity.Ssr" ApiElements="@KpiTileElements">

	<ExamplesSection>

		<ComponentExample Title="Minimal — label and value"
			Code="@("<KpiTile Label=\"Total revenue\" Value=\"$84,320\" />")"
			Primitives="@("<div class=\"flex flex-col border border-border rounded-lg bg-background p-4 gap-1\">\n    <div class=\"flex items-start justify-between gap-2\">\n        <span class=\"text-sm text-muted-foreground\">Total revenue</span>\n    </div>\n    <div class=\"text-2xl font-bold tracking-tight text-foreground\">$84,320</div>\n</div>")">
			<KpiTile Label="Total revenue" Value="$84,320" />
		</ComponentExample>

		<ComponentExample Title="Positive delta (Trend.Up)"
			Code="@("<KpiTile Label=\"Monthly users\" Value=\"12,480\" Delta=\"+8.4% vs last month\" Trend=\"Trend.Up\" />")"
			Primitives="@("<div class=\"flex flex-col border border-border rounded-lg bg-background p-4 gap-1\">\n    <div class=\"flex items-start justify-between gap-2\">\n        <span class=\"text-sm text-muted-foreground\">Monthly users</span>\n    </div>\n    <div class=\"text-2xl font-bold tracking-tight text-foreground\">12,480</div>\n    <div class=\"flex items-center gap-1 text-sm text-success-fg\">\n        <svg ...><!-- up arrow --></svg>\n        <span>+8.4% vs last month</span>\n    </div>\n</div>")">
			<KpiTile Label="Monthly users" Value="12,480" Delta="+8.4% vs last month" Trend="Trend.Up" />
		</ComponentExample>

		<ComponentExample Title="Negative delta with icon (Trend.Down)"
			Code="@("<KpiTile Label=\"Bounce rate\" Value=\"54.2%\" Delta=\"-3.1% vs last month\" Trend=\"Trend.Down\" IconSvg=\"@IconSvg.TrendingDown\" />")"
			Primitives="@("<div class=\"flex flex-col border border-border rounded-lg bg-background p-4 gap-1\">\n    <div class=\"flex items-start justify-between gap-2\">\n        <span class=\"text-sm text-muted-foreground\">Bounce rate</span>\n        <svg ...><!-- trending-down icon --></svg>\n    </div>\n    <div class=\"text-2xl font-bold tracking-tight text-foreground\">54.2%</div>\n    <div class=\"flex items-center gap-1 text-sm text-danger-fg\">\n        <svg ...><!-- down arrow --></svg>\n        <span>-3.1% vs last month</span>\n    </div>\n</div>")">
			<KpiTile Label="Bounce rate" Value="54.2%" Delta="-3.1% vs last month" Trend="Trend.Down" IconSvg="@IconSvg.TrendingDown" />
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private static readonly ApiElement[] KpiTileElements =
	[
		new ApiElement(
			Name: "KpiTile",
			Description: "A compact stat tile that displays a label, a prominent numeric value, and an optional delta indicator with a directional trend arrow. Designed for dashboards, summary panels, and metric grids. Wrapper-styling.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Label",    "string",  false, "Descriptive label shown above the value in `text-sm text-muted-foreground`. Default: empty string." ),
				new ApiProperty( "Value",    "string",  false, "The primary metric value, rendered large and bold. Default: empty string." ),
				new ApiProperty( "Delta",    "string?", false, "Optional change string (e.g. `+8.4%`). Renders below the value with a trend arrow. Omit to suppress." ),
				new ApiProperty( "Trend",    "Trend",   false, "Controls the colour and direction of the delta arrow. `Up` = success-fg, `Down` = danger-fg, `Neutral` = muted-foreground. Default: `Trend.Neutral`." ),
				new ApiProperty( "IconSvg",  "string?", false, "Optional SVG path string for a trailing icon on the label row. Rendered at `size-4 text-muted-foreground`. Omit to suppress." ),
				new ApiProperty( "Borders",  "bool",    false, "Toggles `border border-border rounded-lg`. Default: `true`. Set to `false` when nesting inside a MetricGroup." ),
				new ApiProperty( "BgFilled", "bool",    false, "Toggles `bg-background`. Default: `true`." ),
				new ApiProperty( "Gutters",  "bool",    false, "Toggles `p-4 gap-1` on the tile wrapper. Default: `true`." ),
			]
		),
	];
}

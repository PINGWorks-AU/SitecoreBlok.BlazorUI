@page "/chunks/page-shell"
@rendermode InteractiveServer
@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

<ComponentPage Title="PageShell" Description="In-app page envelope sitting inside AppShell.Content" Interactivity="ComponentInteractivity.Ssr" ApiElements="@PageShellElements">

	<ExamplesSection>

		<ComponentExample Title="Aside on right (default)"
			Code="@("<PageShell AsidePlacement=\"Placement.Right\">\n    <Header>\n        <Text Kind=\"TextKind.Span\" SemiBold>Header</Text>\n    </Header>\n    <Body>\n        Body\n    </Body>\n    <Aside>\n        <Text Kind=\"TextKind.Span\" Size=\"Size.Sm\">Aside</Text>\n    </Aside>\n</PageShell>")"
			Primitives="@("<div class=\"flex flex-col h-full min-h-0\">\n    <div class=\"flex-shrink-0 border-b border-border\">\n        <div class=\"flex items-center p-4\">\n            <span class=\"font-semibold\">Header</span>\n        </div>\n    </div>\n    <div class=\"flex flex-row flex-1 min-h-0\">\n        <div class=\"flex-1 min-w-0 overflow-y-auto p-4\">\n            Body\n        </div>\n        <aside class=\"shrink-0 h-full overflow-y-auto w-48 order-last bg-background border-l border-border p-4\">\n            <span class=\"text-sm\">Aside</span>\n        </aside>\n    </div>\n</div>")">
			<div class="h-80 border rounded-lg overflow-hidden">
				<PageShell AsidePlacement="Placement.Right">
					<Header><Text Kind="TextKind.Span" SemiBold>Header</Text></Header>
					<Body>Body</Body>
					<Aside><Text Kind="TextKind.Span" Size="Size.Sm">Aside</Text></Aside>
				</PageShell>
			</div>
		</ComponentExample>

		<ComponentExample Title="Aside on left"
			Code="@("<PageShell AsidePlacement=\"Placement.Left\">\n    <Header>\n        <Text Kind=\"TextKind.Span\" SemiBold>Header</Text>\n    </Header>\n    <Body>\n        Body\n    </Body>\n    <Aside>\n        <Text Kind=\"TextKind.Span\" Size=\"Size.Sm\">Aside</Text>\n    </Aside>\n</PageShell>")"
			Primitives="@("<div class=\"flex flex-col h-full min-h-0\">\n    <div class=\"flex-shrink-0 border-b border-border\">\n        <div class=\"flex items-center p-4\">\n            <span class=\"font-semibold\">Header</span>\n        </div>\n    </div>\n    <div class=\"flex flex-row flex-1 min-h-0\">\n        <div class=\"flex-1 min-w-0 overflow-y-auto p-4\">\n            Body\n        </div>\n        <aside class=\"shrink-0 h-full overflow-y-auto w-48 order-first bg-background border-r border-border p-4\">\n            <span class=\"text-sm\">Aside</span>\n        </aside>\n    </div>\n</div>")">
			<div class="h-80 border rounded-lg overflow-hidden">
				<PageShell AsidePlacement="Placement.Left">
					<Header><Text Kind="TextKind.Span" SemiBold>Header</Text></Header>
					<Body>Body</Body>
					<Aside><Text Kind="TextKind.Span" Size="Size.Sm">Aside</Text></Aside>
				</PageShell>
			</div>
		</ComponentExample>

		<ComponentExample Title="No aside"
			Code="@("<PageShell AsidePlacement=\"Placement.None\">\n    <Header>\n        <Text Kind=\"TextKind.Span\" SemiBold>Header</Text>\n    </Header>\n    <Body>\n        Body fills remaining width\n    </Body>\n</PageShell>")"
			Primitives="@("<div class=\"flex flex-col h-full min-h-0\">\n    <div class=\"flex-shrink-0 border-b border-border\">\n        <div class=\"flex items-center p-4\">\n            <span class=\"font-semibold\">Header</span>\n        </div>\n    </div>\n    <div class=\"flex flex-row flex-1 min-h-0\">\n        <div class=\"flex-1 min-w-0 overflow-y-auto p-4\">\n            Body fills remaining width\n        </div>\n    </div>\n</div>")">
			<div class="h-80 border rounded-lg overflow-hidden">
				<PageShell AsidePlacement="Placement.None">
					<Header><Text Kind="TextKind.Span" SemiBold>Header</Text></Header>
					<Body>Body fills remaining width</Body>
				</PageShell>
			</div>
		</ComponentExample>

		<ComponentExample Title="No borders, wide aside"
			Code="@("<PageShell AsidePlacement=\"Placement.Right\"\n           Borders=\"false\"\n           Gutters=\"true\"\n           AsideWidth=\"Size.Lg\"\n           AsideBgFilled=\"false\">\n    <Header>\n        <Text Kind=\"TextKind.Span\" SemiBold>Header (no borders)</Text>\n    </Header>\n    <Body>\n        Body\n    </Body>\n    <Aside>\n        <Text Kind=\"TextKind.Span\" Size=\"Size.Sm\" Muted>Wide unfilled aside</Text>\n    </Aside>\n</PageShell>")"
			Primitives="@("<div class=\"flex flex-col h-full min-h-0\">\n    <div class=\"flex-shrink-0\">\n        <div class=\"flex items-center p-4\">\n            <span class=\"font-semibold\">Header (no borders)</span>\n        </div>\n    </div>\n    <div class=\"flex flex-row flex-1 min-h-0\">\n        <div class=\"flex-1 min-w-0 overflow-y-auto p-4\">\n            Body\n        </div>\n        <aside class=\"shrink-0 h-full overflow-y-auto w-72 order-last p-4\">\n            <span class=\"text-sm text-muted-foreground\">Wide unfilled aside</span>\n        </aside>\n    </div>\n</div>")">
			<div class="h-80 border rounded-lg overflow-hidden">
				<PageShell AsidePlacement="Placement.Right" Borders="false" AsideWidth="Size.Lg" AsideBgFilled="false">
					<Header><Text Kind="TextKind.Span" SemiBold>Header (no borders)</Text></Header>
					<Body>Body</Body>
					<Aside><Text Kind="TextKind.Span" Size="Size.Sm" Muted>Wide unfilled aside</Text></Aside>
				</PageShell>
			</div>
		</ComponentExample>

	</ExamplesSection>

</ComponentPage>

@code {
	private static readonly ApiElement[] PageShellElements =
	[
		new ApiElement(
			Name: "PageShell",
			Description: "In-app page envelope. Sits inside `AppShell.Content` (or directly inside a Blazor host page) and arranges a header band, scrollable body, optional aside rail, and optional footer band into one composable surface. Wrapper-styling: chunk absorbs common layout decisions (borders, padding, alignment, aside width and fill) so consumers don't write Tailwind in slot content.",
			Depth: 0,
			Properties:
			[
				new ApiProperty( "Header",          "RenderFragment?",  false, "Top band slot. Renders inside a `flex-shrink-0` wrapper whose border / alignment / padding is controlled by `Borders`, `HeaderAlignment`, `Gutters`. Strict-shape slot." ),
				new ApiProperty( "Body",            "RenderFragment?",  false, "Main scrollable area. `flex-1 min-w-0 overflow-y-auto` baseline; padding via `Gutters`." ),
				new ApiProperty( "Aside",           "RenderFragment?",  false, "Side rail slot. Width / fill / border / padding controlled by `AsideWidth`, `AsideBgFilled`, `Borders`, `Gutters`. Hidden when `AsidePlacement = Placement.None`." ),
				new ApiProperty( "Footer",          "RenderFragment?",  false, "Bottom band slot. Border / padding via `Borders` and `Gutters`." ),
				new ApiProperty( "AsidePlacement",  "Placement",        false, "Where the Aside renders. Default: `Placement.Right`. Other values: `Left`, `None`. Shared `Placement` enum." ),
				new ApiProperty( "Borders",         "bool",             false, "Toggles `border-b` on Header, `border-l/r` on Aside (matching `AsidePlacement`), `border-t` on Footer. Default: `true`." ),
				new ApiProperty( "Gutters",         "bool",             false, "Toggles `p-4` inside each region wrapper. Default: `false` — consumers style inside slots if `Gutters=false`." ),
				new ApiProperty( "HeaderAlignment", "Alignment",        false, "Flex `items-*` value on the Header content row. Default: `Alignment.Center`. Shared `Alignment` enum." ),
				new ApiProperty( "AsideWidth",      "Size",             false, "Aside fixed width via the shared `Size` enum (mapped through `SizeClasses.Width`). Default: `Size.Sm` (`w-48`). Common values: `Sm` (`w-48`), `Md` (`w-56`), `Lg` (`w-72`)." ),
				new ApiProperty( "AsideBgFilled",     "bool",             false, "Toggles `bg-background` on the Aside wrapper. Default: `true`." ),
			]
		),
	];
}

@page "/graphics/theming/colors"
@rendermode InteractiveServer

<ComponentPage Title="Colors" Description="Primary, danger, success, warning, and neutral color palettes defined as CSS custom properties.">

	<div class="pt-2 pb-4">
		<a href="/graphics/theming" class="text-sm text-muted-foreground no-underline hover:text-foreground transition-colors">&larr; Theming</a>
	</div>

	<div class="space-y-10">
		@foreach (var group in ColorGroups)
		{
			<div>
				<h3 class="text-lg font-semibold mb-3">@group.Name</h3>
				<Table Size="TableSize.Sm">
					<TableHeader>
						<TableRow>
							<TableHead>Swatch</TableHead>
							<TableHead>Token</TableHead>
							<TableHead>CSS Variable</TableHead>
						</TableRow>
					</TableHeader>
					<TableBody>
						@foreach (var token in group.Tokens)
						{
							<TableRow>
								<TableCell>
									<div class="w-8 h-8 rounded-md border border-border" style="@($"background-color:var({token})")"></div>
								</TableCell>
								<TableCell>
									<span class="font-medium">@TokenLabel(token)</span>
								</TableCell>
								<TableCell>
									<code class="text-xs text-muted-foreground">var(@token)</code>
								</TableCell>
							</TableRow>
						}
					</TableBody>
				</Table>
			</div>
		}
	</div>

</ComponentPage>

@code {
	private record ColorGroup(string Name, string[] Tokens);

	private static readonly ColorGroup[] ColorGroups =
	[
		new("Primary", [
			"--primary",
			"--color-primary-100", "--color-primary-200", "--color-primary-300",
			"--color-primary-400", "--color-primary-500", "--color-primary-600", "--color-primary-700",
		]),
		new("Danger", [
			"--color-danger-100", "--color-danger-200", "--color-danger-300",
			"--color-danger-400", "--color-danger-500", "--color-danger-600", "--color-danger-700",
		]),
		new("Success", [
			"--color-success-100", "--color-success-200", "--color-success-300",
			"--color-success-400", "--color-success-500", "--color-success-600", "--color-success-700",
		]),
		new("Warning", [
			"--color-warning-100", "--color-warning-200", "--color-warning-300",
			"--color-warning-400", "--color-warning-500", "--color-warning-600", "--color-warning-700",
		]),
		new("Neutral", [
			"--color-blackAlpha-50", "--color-blackAlpha-100", "--color-blackAlpha-200",
			"--color-blackAlpha-300", "--color-blackAlpha-400", "--color-blackAlpha-500",
			"--color-blackAlpha-600", "--color-blackAlpha-700", "--color-blackAlpha-800", "--color-blackAlpha-900",
		]),
	];

	private static string TokenLabel(string token) => token.TrimStart('-');
}

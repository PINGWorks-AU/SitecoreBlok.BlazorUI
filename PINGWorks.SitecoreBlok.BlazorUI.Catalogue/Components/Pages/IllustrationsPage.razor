@page "/graphics/illustrations"
@rendermode InteractiveServer
@using Icons = PINGWorks.SitecoreBlok.BlazorUI.Icons

<ComponentPage Title="Illustrations" Description="Color and neutral SVG illustrations bundled for offline use. Access via IllustrationSvg.Color.* and IllustrationSvg.Neutral.*.">

	<Table>
		<TableHeader>
			<TableRow>
				<TableHead>Color</TableHead>
				<TableHead>Neutral</TableHead>
				<TableHead>Name</TableHead>
			</TableRow>
		</TableHeader>
		<TableBody>
			@foreach ( var item in Items )
			{
				<TableRow>
					<TableCell>
						<div class="w-16 h-16 [&>svg]:w-full [&>svg]:h-full">
							@((MarkupString)item.Color)
						</div>
					</TableCell>
					<TableCell>
						<div class="w-16 h-16 [&>svg]:w-full [&>svg]:h-full">
							@((MarkupString)item.Neutral)
						</div>
					</TableCell>
					<TableCell>
						<code class="text-sm">IllustrationSvg.Color.@item.Name</code>
					</TableCell>
				</TableRow>
			}
		</TableBody>
	</Table>

</ComponentPage>


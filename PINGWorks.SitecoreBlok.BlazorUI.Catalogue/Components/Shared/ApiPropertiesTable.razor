@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services

@if ( Properties.Length == 0 )
{
	<p class="text-sm text-muted-foreground italic mt-2">This element has no public parameters.</p>
}
else
{
	<div class="overflow-x-auto rounded-md border border-border mt-3">
		<table class="w-full text-sm">
			<thead class="bg-muted/40">
				<tr>
					<th class="text-left font-semibold text-foreground px-4 py-2 w-[22%]">Property</th>
					<th class="text-left font-semibold text-foreground px-4 py-2 w-[26%]">Type</th>
					<th class="text-center font-semibold text-foreground px-2 py-2 w-[8%]">Required</th>
					<th class="text-left font-semibold text-foreground px-4 py-2">Description</th>
				</tr>
			</thead>
			<tbody>
				@foreach ( var p in Properties )
				{
					<tr class="border-t border-border align-top">
						<td class="px-4 py-2 font-mono text-foreground">@p.Name</td>
						<td class="px-4 py-2 font-mono text-muted-foreground">@p.Type</td>
						<td class="px-2 py-2 text-center">
							@if ( p.IsRequired )
							{
								<span aria-label="Required" title="Required"
									  class="inline-block w-2 h-2 rounded-full bg-danger"></span>
							}
							else
							{
								<span aria-label="Optional" title="Optional"
									  class="inline-block w-2 h-2 rounded-full border border-border"></span>
							}
						</td>
						<td class="px-4 py-2 text-foreground">
							<DescriptionRenderer Description="@p.Description" KnownElements="@KnownElements" />
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

@code {
	[Parameter, EditorRequired] public required ApiProperty[] Properties { get; set; }
	[Parameter] public ApiElement[]? KnownElements { get; set; }
}

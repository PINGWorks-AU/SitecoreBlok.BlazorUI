@using PINGWorks.SitecoreBlok.BlazorUI.Catalogue.Services
@inject PageTocRegistry Toc

<CascadingValue Value="Section" IsFixed="true">
	<section class="mt-16">
		<h2 id="api" class="text-2xl font-semibold tracking-tight text-foreground scroll-mt-20">API</h2>
		<p class="text-muted-foreground mt-2 text-sm">
			The element family below can be composed together. Click an element to jump to its properties.
		</p>

		<ApiElementsTable Elements="@Elements" />

		@foreach ( var element in Elements )
		{
			<ApiElementDetail Element="@element" KnownElements="@Elements" />
		}
	</section>
</CascadingValue>

@code {
	[Parameter, EditorRequired] public required ApiElement[] Elements { get; set; }

	// See ExamplesSection for notes on why children register through the section.
	private TocSection? Section;

	protected override void OnInitialized()
	{
		Section = Toc.BeginSection( title: "API", anchor: "api" );
	}
}

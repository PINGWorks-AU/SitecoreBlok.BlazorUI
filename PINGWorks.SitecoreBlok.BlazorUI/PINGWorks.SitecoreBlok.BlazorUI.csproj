<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<Version>2.0.0.0</Version>
		<VersionTag>preview-2</VersionTag>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<!-- nuGet package properties -->
	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<PackageId>PINGWorks.SitecoreBlok.BlazorUI</PackageId>
		<Title>PING Works Sitecore Blok Blazor UI</Title>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>
		<Version Condition="'$(VersionTag)' != ''">$(Version)-$(VersionTag)</Version>
		<PackageVersion>$(Version)</PackageVersion>
		<InformationalVersion>$(Version)</InformationalVersion>
		<Authors>PING Works</Authors>
		<Company>PING Works</Company>
		<Product>PING Works dotBRIDGE</Product>
		<Copyright>Copyright (c) 2026 - PING Works, Australia</Copyright>
		<PackageTags>dotnet, sitecore, blok, pingworks, dotbridge</PackageTags>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/PINGWorks-AU/SitecoreBlok.BlazorUI</RepositoryUrl>
		<PackageProjectUrl>https://github.com/PINGWorks-AU/SitecoreBlok.BlazorUI</PackageProjectUrl>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Description>PING Works' Blazor UI Kit for working with Sitecore's Marketplace. This is an unofficial port of Sitecore Blok UI kit.</Description>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<EnableNETAnalyzers>True</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>exclamation-logo.png</PackageIcon>
		<PackageIconUrl>https://dl.polyglot-app.com/img/exclamation-logo.png</PackageIconUrl>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>
			v2.0.0
			🚨 **Breaking** - Update Click event to OnClick to better represent the Blazor idiom for Button, PaginationLink, PaginationNext, PaginationPrevious, AlertDialogAction, AlertDialogCancel, ContextMenuItem, DialogClose, DropdownMenuItem, MenuBarItem
			🚨 **Breaking** - Update SplitShell IsResizable to Resizable for library consistency
			🚨 **Breaking** - ToggleSize.Lg is removed; the Toggle and ToggleGroup size scale is realigned to Blok as Default, Sm, Xs
			🚨 **Breaking** - The Chunks FilterBar is renamed to FilterChipBar and moves from the Forms family to Data, freeing the name for the Blok Filter primitive
			🚨 **Breaking** - TimePicker is rebuilt as Blok's composite picker (trigger plus Hour/Minute/Period panel); it is no longer a native input type=time, so native and mobile time entry are gone and a root Popovers component is now required
			🚨 **Breaking** - Calendar month/year dropdowns now use the Select primitive, so Calendar and DatePicker also require a root Popovers component
			🚨 **Breaking** - Toggle now shows a check mark while pressed, as Blok does; an icon-only Toggle that passes its icon as ChildContent is read as text and gains a check beside it, so pass the icon through the Icon parameter instead
			🎉 Add the Filter primitive family - FilterInput, FilterSingleSelect, FilterMultiSelect and FilterBar - completing the port of all 61 Blok primitives
			🎉 Add the InputOtp family - InputOtp, InputOtpGroup, InputOtpSlot and InputOtpSeparator
			🎉 Complete DropdownMenu with the six missing Blok exports - DropdownMenuCheckboxItem, DropdownMenuRadioGroup, DropdownMenuRadioItem, DropdownMenuItemText, DropdownMenuItemTitle and DropdownMenuItemDescription
			🎉 Complete InputGroup with InputGroupButton and InputGroupTextarea, plus Blok's four missing alignment variant groups
			🐛 Fix SplitShell overflow behaviours when Resizable is enabled
			🐛 Fix CodeViewer content reload
			🐛 Fix PopoverItem tearing down the Blazor circuit when disposed, which left the page unresponsive to every click after using a dropdown - affected Select, SelectField, Combobox, DropdownMenu and Tooltip
			🐛 Fix Select showing the raw value instead of the option label for a preselected value before the dropdown had been opened once - adds DisplayLabel and ValueLabel
			🐛 Fix DatePicker ignoring range mode when Range was resolved rather than passed directly
			🐛 Fix SearchInput being unable to shrink in narrow containers, which pushed the clear button outside its bounds
			🐛 Fix Stepper step circles rendering transparent on non-page-coloured surfaces, and step labels wrapping instead of sitting on one line
			🐛 Fix dark-mode text on 24 Chunk surfaces that set bg-background with no text colour, most visibly the layout roots AppShell, PageShell, SplitShell, ListDetailShell, ContextPanelShell, AppSidebar and NavRail
			🐛 Fix ContextMenuItem having no visible highlight when focused from the keyboard
			🐛 Fix Kbd inside a Tooltip rendering as a grey chip with grey text on the dark tooltip surface
			✔️ ClassName override is added to NavListItem
			✔️ Additional formatting options for LocalTime
			✔️ Toggle gains Square and Rounded variants, and an Icon parameter that crossfades to a check mark while pressed
			✔️ Toggle and ToggleGroupItem restyled to Blok - resting text colour, no dimming on hover, 14px text (was 13px), and the Outline variant's dark-mode fill
			✔️ Stepper gains StepperSize, and the horizontal orientation now renders in Blok's muted panel
			✔️ Editable gains EditableError; Calendar gains CalendarAriaLabels for nav and dropdown ARIA overrides
			✔️ Input focus ring narrowed from 3px to 1px to match Blok, affecting every composed input including SearchInput, InputGroup, Combobox and Filter
			✔️ StackNavigation, Accordion, Calendar, DatePicker, Popover, Tooltip, Checkbox, Combobox, NavigationMenu and Sidebar re-audited and realigned to current Blok source

			v1.3.0
			🎉 Add FileUpload chunk in the Forms family with drag-and-drop support and multi-file handling
			🎉 Add LocalTime extra that renders times in the user's local time using the browser offsets
			✔️ Minor updates to Primitives DatePicker, Table to provide some ease-of-use style properties
			✔️ Minor updates to Chunks overriding of default styling, including CardGrid, Container, DateField, FormShell, AppHeader
			✔️ Minor updates to Stack component
			✔️ Add 8XL width support to Container
			🚨 llms.txt and components.json automatically emitted and packaged into the nuGet to allow better discoverability by AI tools

			v1.2.0
			🚨 Chunks feature released, with over 80 new composite components for consistently applying complex arrangements of primitives and CSS style classes with minimal effort
			✔️ Update the Tooltip primitive component to correctly position and render on top of bounding containers, as well as adding arbitrary delay support and class name overrides

			v1.1.0
			⭐ Include Tailwind source theme files to allow use of the theme in consuming sites
			🐛 Remove unused references to Geist font

			v1.0.0
			Initial release
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Resources\PINGWorks.SitecoreBlok.BlazorUI.targets" Pack="true" PackagePath="build\PINGWorks.SitecoreBlok.BlazorUI.targets" />
		<None Include="Resources\wwwroot\blok.css" Pack="true" PackagePath="contentFiles\any\any\wwwroot\css\blok;content\wwwroot\css\blok" />
		<None Include="Resources\wwwroot\colors.css" Pack="true" PackagePath="contentFiles\any\any\wwwroot\css\blok;content\wwwroot\css\blok" />
		<None Include="Resources\wwwroot\tw-animate.css" Pack="true" PackagePath="contentFiles\any\any\wwwroot\css\blok;content\wwwroot\css\blok" />

		<!-- AI agent catalogue artefacts. Generated by the Catalogue project's
		     ExportAiManifest target. Conditional so a first-time build of just
		     BlazorUI (before Catalogue runs) doesn't fail; once the solution has
		     been built end-to-end the artefacts are present and get packed. -->
		<None Include="..\artifacts\ai-manifest\components.json" Pack="true" PackagePath="tools\ai;contentFiles\any\any\tools\ai" Condition="Exists('..\artifacts\ai-manifest\components.json')" />
		<None Include="..\artifacts\ai-manifest\llms.txt"        Pack="true" PackagePath="tools\ai;contentFiles\any\any\tools\ai" Condition="Exists('..\artifacts\ai-manifest\llms.txt')" />
	</ItemGroup>

	<!-- Warn (don't fail) if the AI manifests are missing when packing. CI release
	     pipelines build the solution before packing so the artefacts will be present;
	     local incremental builds may produce an interim nupkg without them. -->
	<Target Name="WarnIfAiManifestMissing" BeforeTargets="GenerateNuspec">
		<Warning Condition="!Exists('..\artifacts\ai-manifest\components.json') OR !Exists('..\artifacts\ai-manifest\llms.txt')"
		         Text="AI manifest artefacts missing from ..\artifacts\ai-manifest\. This nupkg will ship without tools/ai/. Build PINGWorks.SitecoreBlok.BlazorUI.Catalogue once to populate them." />
	</Target>

	<ItemGroup>
		<None Include="Resources\exclamation-logo.png" Pack="true" PackagePath="/" />
		<None Include="README.md" Pack="true" PackagePath="/" />
		<None Include="..\LICENSE" Pack="true" PackagePath="/" />
		<None Include="ThirdPartyNotices\**" Pack="true" PackagePath="ThirdPartyNotices" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
	</ItemGroup>

	<PropertyGroup>
		<TailwindCliFileName>tailwindcss-windows-x64.exe</TailwindCliFileName>
		<TailwindCliPath>$(MSBuildThisFileDirectory)..\$(TailwindCliFileName)</TailwindCliPath>
		<!-- Override TailwindCliUrl to pin a specific version, e.g. https://github.com/tailwindlabs/tailwindcss/releases/download/v4.1.13/tailwindcss-windows-x64.exe -->
		<TailwindCliUrl Condition="'$(TailwindCliUrl)' == ''">https://github.com/tailwindlabs/tailwindcss/releases/latest/download/$(TailwindCliFileName)</TailwindCliUrl>
	</PropertyGroup>

	<Target Name="DownloadTailwindCLI" BeforeTargets="BuildTailwindCSS" Condition="!Exists('$(TailwindCliPath)')">
		<Message Importance="high" Text="Tailwind CLI not found at $(TailwindCliPath). Downloading from $(TailwindCliUrl)..." />
		<DownloadFile SourceUrl="$(TailwindCliUrl)" DestinationFolder="$(MSBuildThisFileDirectory).." DestinationFileName="$(TailwindCliFileName)" />
	</Target>

	<Target Name="BuildTailwindCSS" BeforeTargets="ResolveStaticWebAssetsInputs;Build">
		<Exec Command="&quot;$(TailwindCliPath)&quot; -i wwwroot/css/blok.css -o wwwroot/css/sitecore-blok.css --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

</Project>

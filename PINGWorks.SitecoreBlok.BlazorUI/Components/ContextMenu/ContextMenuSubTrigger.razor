@namespace PINGWorks.SitecoreBlok.BlazorUI

<div @ref="Ref" data-slot="context-menu-sub-trigger"
	 data-inset="@( Inset ? "true" : null )"
	 class="@CssClass"
	 @onmouseenter="OnEnter" @onmouseleave="OnLeave">
	@ChildContent
	<Icon Svg="@IconSvg.ChevronRight" ClassName="ml-auto size-[0.8rem]" />
</div>

@code {
	[CascadingParameter] public required ContextMenuSub Parent { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter] public bool Inset { get; set; }

	private ElementReference Ref;

	private string CssClass => CssClassBuilder.Start(
		"flex cursor-default items-center rounded-sm px-2 py-1.5 text-sm outline-hidden select-none hover:bg-neutral-bg hover:text-foreground",
		"[&_svg]:size-[0.8rem] [&_svg]:text-neutral-fg" )
												.With( "pl-8", Inset )
												.With( "bg-neutral-bg text-foreground", Parent.IsOpen )
												.With( ClassName )
												.Build();

	protected override void OnAfterRender( bool firstRender )
	{
		if ( firstRender )
			Parent.RegisterTriggerRef( Ref );
	}

	private async Task OnEnter() => await Parent.Open();
	private async Task OnLeave() => await Parent.Close();
}

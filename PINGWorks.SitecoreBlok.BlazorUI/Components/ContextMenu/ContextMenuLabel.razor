@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="context-menu-label"
	 data-inset="@( Inset ? "true" : null )"
	 class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter] public bool Inset { get; set; }

	private string CssClass => CssClassBuilder.Start( "text-muted-foreground px-2 py-1.5 text-sm font-semibold uppercase" )
												.With( "pl-8", Inset )
												.With( ClassName )
												.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

<CascadingValue Value="this">
	@ChildContent
</CascadingValue>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }

	internal bool IsOpen { get; private set; }
	internal bool IsPositioned { get; private set; }
	internal double X { get; private set; }
	internal double Y { get; private set; }
	internal double ClickX { get; private set; }
	internal double ClickY { get; private set; }

	internal async Task OpenAt( double x, double y )
	{
		ClickX = x;
		ClickY = y;
		X = x;
		Y = y;
		IsPositioned = false;
		IsOpen = true;
		await InvokeAsync( StateHasChanged );
	}

	internal async Task UpdatePosition( double x, double y )
	{
		X = x;
		Y = y;
		IsPositioned = true;
		await InvokeAsync( StateHasChanged );
	}

	internal async Task Close()
	{
		IsOpen = false;
		IsPositioned = false;
		await InvokeAsync( StateHasChanged );
	}
}

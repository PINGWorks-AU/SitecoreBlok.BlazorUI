@namespace PINGWorks.SitecoreBlok.BlazorUI

<button data-slot="toggle-group-item" type="button"
		aria-pressed="@( IsPressed ? "true" : "false" )"
		data-state="@( IsPressed ? "on" : "off" )"
		disabled="@( Disabled || Parent.Disabled )"
		class="@CssClass" @onclick="Toggle">
	@ChildContent
</button>

@code {
	[CascadingParameter] public required ToggleGroup Parent { get; set; }

	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter, EditorRequired] public required string Value { get; set; }
	[Parameter] public bool Disabled { get; set; }

	private bool IsPressed => Parent.IsItemPressed( Value );

	private string CssClass => CssClassBuilder.Start( "inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors outline-none cursor-pointer",
		"hover:bg-neutral-bg hover:text-muted-foreground",
		"disabled:pointer-events-none disabled:opacity-50",
		"data-[state=on]:bg-primary-bg data-[state=on]:text-primary-fg",
		"[&_svg]:pointer-events-none [&_svg]:shrink-0",
		"min-w-0 flex-1 shrink-0 shadow-none focus:z-10 focus-visible:z-10" )
										.With( "bg-transparent", Parent.Variant is ToggleVariant.Default )
										.With( "border border-input bg-transparent", Parent.Variant is ToggleVariant.Outline )
										.With( "h-9 min-w-9 px-2", Parent.Size is ToggleSize.Default )
										.With( "h-8 min-w-8 px-1.5", Parent.Size is ToggleSize.Sm )
										.With( "h-11 min-w-11 px-3", Parent.Size is ToggleSize.Lg )
										.With( ClassName )
										.Build();

	private async Task Toggle()
	{
		if ( Disabled || Parent.Disabled ) return;
		await Parent.ToggleItem( Value );
	}
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

@if (Context?.IsEditing != true)
{
	<span data-slot="editable-preview"
		  role="@Role"
		  tabindex="@TabIndex"
		  @onclick="HandleClick"
		  @ondblclick="HandleDoubleClick"
		  @onkeydown="HandleKeyDown"
		  class="@CssClass"
		  @attributes="AdditionalAttributes">
		@DisplayValue
	</span>
}

@code {
	[CascadingParameter] private EditableContext? Context { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

	private bool IsEmpty => string.IsNullOrWhiteSpace(Context?.Value);
	private string DisplayValue => IsEmpty ? (Context?.Placeholder ?? "Click to edit...") : (Context?.Value ?? "");
	private string? Role => Context?.IsPreviewFocusable == true && Context?.IsDisabled != true ? "button" : null;
	private string? TabIndex => Context?.IsPreviewFocusable == true && Context?.IsDisabled != true ? "0" : null;

	private async Task HandleClick()
	{
		if (Context is not null && Context.ActivationMode == EditableActivationMode.Click && Context.IsPreviewFocusable && !Context.IsDisabled)
			await Context.StartEdit();
	}

	private async Task HandleDoubleClick()
	{
		if (Context is not null && Context.ActivationMode == EditableActivationMode.Dblclick && Context.IsPreviewFocusable && !Context.IsDisabled)
			await Context.StartEdit();
	}

	private async Task HandleKeyDown(KeyboardEventArgs e)
	{
		if (Context is not null && Context.IsPreviewFocusable && !Context.IsDisabled && (e.Key == "Enter" || e.Key == " "))
			await Context.StartEdit();
	}

	private string CssClass => CssClassBuilder.Start(
			"cursor-text rounded-md px-2 py-1 transition-colors text-foreground",
			"min-h-8 flex items-center whitespace-pre-line break-words")
		.With("hover:bg-neutral-bg", Context?.IsPreviewFocusable != false && Context?.IsDisabled != true)
		.With("cursor-not-allowed opacity-50", Context?.IsDisabled == true)
		.With("cursor-default", Context?.IsPreviewFocusable == false)
		.With(ClassName)
		.Build();
}

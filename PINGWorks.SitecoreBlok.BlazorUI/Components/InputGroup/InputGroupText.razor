@namespace PINGWorks.SitecoreBlok.BlazorUI

<span class="@CssClass">
	@ChildContent
</span>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start("text-muted-foreground flex items-center gap-2 text-sm [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4")
										.With(ClassName)
										.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

<textarea data-slot="input-group-control" placeholder="@Placeholder" disabled="@Disabled" rows="@Rows"
		  class="@CssClass" @oninput="OnInput" @attributes="AdditionalAttributes">@Value</textarea>

@code {
	[Parameter] public string? ClassName { get; set; }
	[Parameter( CaptureUnmatchedValues = true )] public Dictionary<string, object>? AdditionalAttributes { get; set; }

	[Parameter] public string? Value { get; set; }
	[Parameter] public EventCallback<string?> ValueChanged { get; set; }
	[Parameter] public string? Placeholder { get; set; }
	[Parameter] public bool Disabled { get; set; }
	[Parameter] public int Rows { get; set; } = 3;

	private string CssClass => CssClassBuilder.Start( "flex-1 w-full resize-none rounded-none border-0 bg-transparent py-3 shadow-none outline-none text-base md:text-sm placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50 focus-visible:ring-0 dark:bg-transparent px-3" )
										.With( ClassName )
										.Build();

	private async Task OnInput( ChangeEventArgs e )
	{
		Value = e.Value?.ToString();

		if ( ValueChanged.HasDelegate )
			await ValueChanged.InvokeAsync( Value );
	}
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

<div role="group" data-slot="input-group-addon" data-align="@AlignValue" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter] public InputGroupAlign Align { get; set; } = InputGroupAlign.InlineStart;

	private string AlignValue => Align switch
	{
		InputGroupAlign.InlineStart => "inline-start",
		InputGroupAlign.InlineEnd => "inline-end",
		InputGroupAlign.BlockStart => "block-start",
		InputGroupAlign.BlockEnd => "block-end",
		_ => "inline-start"
	};

	private string CssClass => CssClassBuilder.Start(
		"text-muted-foreground flex h-auto cursor-text items-center justify-center gap-2 py-1.5 text-sm font-medium select-none [&>svg:not([class*='size-'])]:size-4 group-data-[disabled=true]/input-group:opacity-50")
										.With("order-first pl-3", Align is InputGroupAlign.InlineStart)
										.With("order-last pr-3", Align is InputGroupAlign.InlineEnd)
										.With("order-first w-full justify-start px-3 pt-3 [.border-b]:pb-3 group-has-[>input]/input-group:pt-2.5", Align is InputGroupAlign.BlockStart)
										.With("order-last w-full justify-start px-3 pb-3 [.border-t]:pt-3 group-has-[>input]/input-group:pb-2.5", Align is InputGroupAlign.BlockEnd)
										.With(ClassName)
										.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

<td data-slot="table-cell" class="@CssClass">
	@ChildContent
</td>

@code {
	[CascadingParameter] public Table? ParentTable { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter] public bool Pinned { get; set; }

	private string CssClass => CssClassBuilder.Start( "whitespace-nowrap align-middle text-foreground",
		"[&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-[2px]" )
										.With( ParentTable?.SizeCellClasses ?? "min-h-[48px] py-2 px-5" )
										// `parity-no-text-pair`: text-foreground is in the Start args; the harness
										// scans per-literal so this conditional needs the marker.
										.With( "sticky left-0 z-20 bg-background parity-no-text-pair", Pinned )
										.With( ClassName )
										.Build();
}

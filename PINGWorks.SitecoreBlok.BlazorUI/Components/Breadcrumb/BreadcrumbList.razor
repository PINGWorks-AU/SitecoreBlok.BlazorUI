@namespace PINGWorks.SitecoreBlok.BlazorUI

<ol data-slot="breadcrumb-list" class="@CssClass">
	@ChildContent
</ol>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "text-muted-foreground flex flex-wrap items-center text-sm break-words" )
										.With( "gap-1.5 sm:gap-2.5", !CssClassBuilder.ContainsAny( ClassName, "gap-" ) )
										.With( ClassName )
										.Build();
}

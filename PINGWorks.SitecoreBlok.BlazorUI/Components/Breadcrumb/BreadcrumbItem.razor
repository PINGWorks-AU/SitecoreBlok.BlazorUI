@namespace PINGWorks.SitecoreBlok.BlazorUI

<li data-slot="breadcrumb-item" class="@CssClass">
	@ChildContent
</li>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "inline-flex items-center" )
										.With( "gap-1.5", !CssClassBuilder.ContainsAny( ClassName, "gap-" ) )
										.With( ClassName )
										.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="input-otp-group" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "flex items-center" )
										.With( ClassName )
										.Build();
}

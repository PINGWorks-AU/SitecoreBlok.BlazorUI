@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	PageHeader — top of an in-page area. Title (h1), Description, plus optional
	Breadcrumbs (above the title), Actions (right-aligned), Status (next to the title).

	Wrapper-styling parameters (per spec §5.13):
		- Borders         (default true)  toggles border-b under the title row.
		- Gutters         (default true)  toggles pb-6 / gap-4 / actions gap-2.
		- HeaderAlignment (default Start) flex items-* on the title row.
		                                  Default Start (not Center) — multi-line title+description
		                                  blocks should top-align with side actions.
*@

<div class="@OuterClass">
	@if ( Breadcrumbs is not null )
	{
		<div>
			@Breadcrumbs
		</div>
	}

	<div class="@RowClass">
		<div class="flex-1 min-w-0 space-y-1">
			<div class="flex items-center gap-3">
				<h1 class="text-2xl font-bold tracking-tight text-foreground">@Title</h1>
				@if ( Status is not null )
				{
					<div>
						@Status
					</div>
				}
			</div>
			@if ( !string.IsNullOrEmpty( Description ) )
			{
				<p class="text-sm text-muted-foreground">@Description</p>
			}
		</div>

		@if ( Actions is not null )
		{
			<div class="@ActionsClass">
				@Actions
			</div>
		}
	</div>
</div>

@code {
	[Parameter] public string Title { get; set; } = "";
	[Parameter] public string? Description { get; set; }
	[Parameter] public RenderFragment? Breadcrumbs { get; set; }
	[Parameter] public RenderFragment? Actions { get; set; }
	[Parameter] public RenderFragment? Status { get; set; }

	[Parameter] public bool Borders { get; set; } = true;
	[Parameter] public bool Gutters { get; set; } = true;
	[Parameter] public Alignment HeaderAlignment { get; set; } = Alignment.Start;

	private string OuterClass
		=> CssClassBuilder.Start( "space-y-3" )
			.With( "pb-6", Gutters )
			.With( "border-b border-border", Borders )
			.Build();

	private string RowClass
		=> CssClassBuilder.Start( "flex" )
			.With( AlignmentClasses.Items( HeaderAlignment ) )
			.With( "gap-4", Gutters )
			.Build();

	private string ActionsClass
		=> CssClassBuilder.Start( "flex-shrink-0 flex items-center" )
			.With( "gap-2", Gutters )
			.Build();
}

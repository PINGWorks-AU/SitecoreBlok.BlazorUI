@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	AppHeader — sticky top bar with backdrop blur. Replaces the Catalogue's hand-built
	header. Slots: Brand (left), Nav (center-left), Actions (right). All RenderFragment?
	per spec §5.1.

	Wrapper-styling parameters (per spec §5.13):
		- Sticky          (default true)  toggles sticky top-0 z-40.
		- Borders         (default true)  toggles border-b on the band.
		- BgFilled        (default true)  toggles bg-background/95 backdrop-blur on the band.
		- Gutters         (default true)  toggles h-14 px-6 gap-4 on the content row.
		                                  Vertical sizing lives on this branch, not the baseline.
		- HeaderAlignment (default Center) flex items-* on the content row.
*@

<header class="@HeaderClass">
	<div class="@HeaderRowClass">
		@if ( Brand is not null )
		{
			<div class="flex items-center">
				@Brand
			</div>
		}

		@if ( Nav is not null )
		{
			<nav class="flex items-center gap-4">
				@Nav
			</nav>
		}

		@if ( Actions is not null )
		{
			<div class="ml-auto flex items-center gap-1">
				@Actions
			</div>
		}
	</div>
</header>

@code {
	[Parameter] public RenderFragment? Brand { get; set; }
	[Parameter] public RenderFragment? Nav { get; set; }
	[Parameter] public RenderFragment? Actions { get; set; }

	[Parameter] public bool Sticky { get; set; } = true;
	[Parameter] public bool Borders { get; set; } = true;
	[Parameter] public bool BgFilled { get; set; } = true;
	[Parameter] public bool Gutters { get; set; } = true;
	[Parameter] public Alignment HeaderAlignment { get; set; } = Alignment.Center;

	private string HeaderClass
		=> CssClassBuilder.Start( "z-40" )
			.With( "sticky top-0", Sticky )
			.With( "border-b border-border", Borders )
			.With( "bg-background/95 backdrop-blur", BgFilled )
			.Build();

	private string HeaderRowClass
		=> CssClassBuilder.Start( "flex" )
			.With( AlignmentClasses.Items( HeaderAlignment ) )
			.With( "h-14 px-6 gap-4", Gutters )
			.Build();
}

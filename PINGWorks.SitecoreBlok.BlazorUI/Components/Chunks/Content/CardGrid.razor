@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	CardGrid — responsive grid of cards. Column count and gap are parameterised.
	Grid breakpoints are handled by ColumnsClasses.Grid so Tailwind scans the
	literal class strings in that file.
*@

<div class="@CssClass">@ChildContent</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public Columns Columns { get; set; } = Columns.Three;
	[Parameter] public Size Gap { get; set; } = Size.Md;
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "grid" )
									.With( ColumnsClasses.Grid( Columns ) )
									.With( SizeClasses.Gap( Gap ) )
									.With( ClassName )
									.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	Container — max-width content centerer. Constrains content width and centres horizontally.

	No wrapper-styling parameters: Container is a single inline element with no toggleable
	border, background, or gutter behaviour. The MaxWidth parameter is the sole API surface.
*@

<div class="@CssClass">@ChildContent</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public Size MaxWidth { get; set; } = Size.Lg;
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "mx-auto" )
								.With( "w-full", !CssClassBuilder.ContainsAny( ClassName, "w-" ) )
								.With( SizeClasses.MaxWidth( MaxWidth ), !CssClassBuilder.ContainsAny( ClassName, "max-w-" ) )
								.With( ClassName )
								.Build();
}

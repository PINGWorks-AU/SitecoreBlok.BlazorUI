@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	MediaCard — thumbnail-first card. The image is always edge-to-edge; Gutters controls only
	the inner content area padding.

	Wrapper-styling parameters (per spec §5.13):
		- Borders   (default true) toggles border border-border rounded-lg.
		- BgFilled  (default true) toggles bg-background.
		- Gutters   (default true) toggles p-4 on the content area below the image.
*@

<div class="@CardClass">
	<div class="relative">
		<img src="@ImageUrl" alt="@ImageAlt" class="w-full aspect-video object-cover" />
		@if ( Overlay is not null )
		{
			<div class="absolute inset-0">@Overlay</div>
		}
	</div>
	<div class="@ContentClass">
		<h3 class="text-base font-semibold tracking-tight text-foreground">@Title</h3>
		@if ( !string.IsNullOrEmpty( Description ) )
		{
			<p class="text-sm text-muted-foreground mt-1">@Description</p>
		}
		@if ( Actions is not null )
		{
			<div class="mt-3 flex items-center gap-2">@Actions</div>
		}
	</div>
</div>

@code {
	[Parameter] public string ImageUrl { get; set; } = "";
	[Parameter] public string ImageAlt { get; set; } = "";
	[Parameter] public string Title { get; set; } = "";
	[Parameter] public string? Description { get; set; }
	[Parameter] public RenderFragment? Actions { get; set; }
	[Parameter] public RenderFragment? Overlay { get; set; }

	[Parameter] public bool Borders { get; set; } = true;
	[Parameter] public bool BgFilled { get; set; } = true;
	[Parameter] public bool Gutters { get; set; } = true;

	private string CardClass
		=> CssClassBuilder.Start( "flex flex-col overflow-hidden" )
			.With( "border border-border rounded-lg", Borders )
			.With( "bg-background", BgFilled )
			.Build();

	private string ContentClass
		=> CssClassBuilder.Start( "flex flex-col" )
			.With( "p-4", Gutters )
			.Build();
}

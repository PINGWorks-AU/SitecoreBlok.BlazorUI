@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	FeatureCard — icon + title + description card for landing and onboarding pages.

	Wrapper-styling parameters (per spec §5.13):
		- Borders   (default true) toggles border border-border rounded-lg.
		- BgFilled  (default true) toggles bg-background.
		- Gutters   (default true) toggles p-6 gap-4.
*@

<div class="@CardClass">
	@if ( !string.IsNullOrEmpty( IconSvg ) )
	{
		<Icon Svg="@IconSvg" ClassName="size-8 text-primary" />
	}
	<div class="flex-1">
		<h3 class="text-base font-semibold tracking-tight text-foreground mb-1">@Title</h3>
		@if ( !string.IsNullOrEmpty( Description ) )
		{
			<p class="text-sm text-muted-foreground">@Description</p>
		}
	</div>
	@if ( Footer is not null )
	{
		<div>@Footer</div>
	}
</div>

@code {
	[Parameter] public string? IconSvg { get; set; }
	[Parameter] public string Title { get; set; } = "";
	[Parameter] public string? Description { get; set; }
	[Parameter] public RenderFragment? Footer { get; set; }

	[Parameter] public bool Borders { get; set; } = true;
	[Parameter] public bool BgFilled { get; set; } = true;
	[Parameter] public bool Gutters { get; set; } = true;

	private string CardClass
		=> CssClassBuilder.Start( "flex flex-col" )
			.With( "border border-border rounded-lg", Borders )
			.With( "bg-background text-foreground", BgFilled )
			.With( "p-6 gap-4", Gutters )
			.Build();
}

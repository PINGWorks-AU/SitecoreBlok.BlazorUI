@namespace PINGWorks.SitecoreBlok.BlazorUI
@typeparam TItem

@*
	ResultsList<T> — generic vertical list with selection + optional pagination + Empty fallback.
*@

@if ( Items is null || Items.Count == 0 )
{
	@if ( Empty is not null )
	{
		@Empty
	}
	else
	{
		<EmptyStatePanel Title="No results" />
	}
}
else
{
	<div class="flex flex-col gap-2">
		@foreach ( var item in Items )
		{
			var isSelected = EqualityComparer<TItem>.Default.Equals( item, Selected );
			<button type="button" @onclick="@(() => HandleSelect( item ))" class="@RowClass( isSelected )">
				@ItemTemplate?.Invoke( item )
			</button>
		}
	</div>

	@if ( Pageable )
	{
		<div class="mt-4">
			<DataPagination Page="@Page" PageChanged="@PageChanged" PageSize="@PageSize" TotalItems="@TotalItems" />
		</div>
	}
}

@code {
	[Parameter] public IList<TItem>? Items { get; set; }
	[Parameter] public TItem? Selected { get; set; }
	[Parameter] public EventCallback<TItem?> SelectedChanged { get; set; }
	[Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }
	[Parameter] public RenderFragment? Empty { get; set; }

	[Parameter] public bool Pageable { get; set; } = false;
	[Parameter] public int Page { get; set; } = 1;
	[Parameter] public EventCallback<int> PageChanged { get; set; }
	[Parameter] public int PageSize { get; set; } = 10;
	[Parameter] public int TotalItems { get; set; } = 0;

	private static string RowClass( bool isSelected )
		=> CssClassBuilder.Start( "w-full text-left rounded-md border transition-colors cursor-pointer p-3" )
			.With( "bg-neutral-bg border-border", isSelected )
			.With( "bg-background border-border hover:bg-subtle-bg", !isSelected )
			.Build();

	private async Task HandleSelect( TItem item )
	{
		if ( SelectedChanged.HasDelegate )
			await SelectedChanged.InvokeAsync( item );
	}
}

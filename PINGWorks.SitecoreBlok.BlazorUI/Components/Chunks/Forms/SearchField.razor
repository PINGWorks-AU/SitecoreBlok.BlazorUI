@inherits FieldBase<string?>
@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	SearchField — labelled search input field chunk.
	Wraps the SearchInput primitive family with a label, help text, and error state.
	The leading icon uses IconSvg.Information as a placeholder (no magnify icon in the internal subset).
*@

<div class="space-y-1.5">
	@if ( !string.IsNullOrEmpty( Label ) )
	{
		<FormLabel For="@Id" Required="@Required" Error="@EffectiveError">@Label</FormLabel>
	}
	<SearchInput>
		<SearchInputLeftElement>
			<Icon Svg="@IconSvg.Information" />
		</SearchInputLeftElement>
		<SearchInputField Id="@Id" Value="@Value" ValueChanged="@( async v => await UpdateValue( v ) )"
		                  Placeholder="@Placeholder" Disabled="@Disabled" @onblur="MarkTouched" />
		@if ( !string.IsNullOrEmpty( Value ) )
		{
			<SearchInputRightElement>
				<SearchInputClearButton OnClear="ClearValue" />
			</SearchInputRightElement>
		}
	</SearchInput>
	@if ( !string.IsNullOrEmpty( HelpText ) )
	{
		<p class="@HelpTextClass">@HelpText</p>
	}
</div>

@code {
	[Parameter] public string? Placeholder { get; set; }

	private async Task ClearValue()
		=> await UpdateValue( null );
}

@inherits FieldBase<DateTime?>
@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	DateField — labelled date-picker field chunk.
	Wraps the DatePicker primitive with a label above and optional help text.
*@

<div class="space-y-1.5">
	@if ( !string.IsNullOrEmpty( Label ) )
	{
		<FormLabel For="@Id" Required="@Required" Error="@EffectiveError">@Label</FormLabel>
	}
	<div @onfocusout="MarkTouched">
		<DatePicker Value="@Value" ValueChanged="@( async v => await UpdateValue( v ) )" Disabled="@Disabled" Range="false" MinDate="MinDate" MaxDate="MaxDate" />
	</div>
	@if ( !string.IsNullOrEmpty( HelpText ) )
	{
		<p class="@HelpTextClass">@HelpText</p>
	}
</div>

@code {
	[Parameter] public DateTime? MinDate { get; set; }
	[Parameter] public DateTime? MaxDate { get; set; }
}

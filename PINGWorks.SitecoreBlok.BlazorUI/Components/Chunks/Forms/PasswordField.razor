@inherits FieldBase<string?>
@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	PasswordField — labelled password input with show/hide toggle.
	Wraps the Input primitive with type=password (or text when revealed).
*@

<div class="space-y-1.5">
	@if ( !string.IsNullOrEmpty( Label ) )
	{
		<FormLabel For="@Id" Required="@Required" Error="@EffectiveError">@Label</FormLabel>
	}
	<div class="relative">
		<Input Id="@Id" Value="@Value" ValueChanged="@( async v => await UpdateValue( v ) )"
		       Type="@( ShowPlaintext ? "text" : "password" )" Placeholder="@Placeholder"
		       Disabled="@Disabled" @onblur="MarkTouched" />
		<button type="button" @onclick="ToggleShow"
		        class="absolute right-2 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground focus:outline-none"
		        tabindex="-1" title="@( ShowPlaintext ? "Hide password" : "Show password" )">
			<Icon Svg="@IconSvg.Information" ClassName="size-4" />
		</button>
	</div>
	@if ( !string.IsNullOrEmpty( HelpText ) )
	{
		<p class="@HelpTextClass">@HelpText</p>
	}
</div>

@code {
	[Parameter] public string? Placeholder { get; set; }

	private bool ShowPlaintext;

	private void ToggleShow() => ShowPlaintext = !ShowPlaintext;
}

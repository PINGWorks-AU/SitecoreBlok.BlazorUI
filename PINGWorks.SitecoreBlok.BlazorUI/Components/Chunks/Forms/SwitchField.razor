@inherits FieldBase<bool>
@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	SwitchField — labelled switch field chunk (inline layout).
	Wraps the Switch primitive with a right-side label and optional help text.
*@

<div class="flex items-start gap-3">
	<div class="pt-0.5">
		<Switch Checked="@Value" CheckedChanged="@( async v => await UpdateValue( v ) )"
		        Disabled="@Disabled" AriaLabel="@Label" @onblur="MarkTouched" />
	</div>
	<div class="flex flex-col gap-1">
		@if ( !string.IsNullOrEmpty( Label ) )
		{
			<FormLabel For="@Id" Required="@Required" Error="@EffectiveError">@Label</FormLabel>
		}
		@if ( !string.IsNullOrEmpty( HelpText ) )
		{
			<p class="@HelpTextClass">@HelpText</p>
		}
	</div>
</div>


@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	FormLabel — form-context wrapper around the Label primitive.
	Adds Required (*) or Optional markers, and an error-state colour override.
*@

<Label ForId="@For" ClassName="@LabelClass">
	@ChildContent
	@if ( Required )
	{
		<span class="text-danger-fg">*</span>
	}
	else if ( Optional )
	{
		<span class="text-muted-foreground text-xs ml-1">(optional)</span>
	}
</Label>

@code {
	[Parameter] public string? For { get; set; }
	[Parameter] public bool Required { get; set; } = false;
	[Parameter] public bool Optional { get; set; } = false;
	[Parameter] public bool Error { get; set; } = false;
	[Parameter] public RenderFragment? ChildContent { get; set; }

	private string LabelClass
		=> CssClassBuilder.Start( "text-sm font-medium text-foreground" )
			.With( "text-danger-fg", Error )
			.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	LoginForm — opinionated email + password login template.
	Composes TextField and PasswordField chunks and a native submit button.
	OnSubmit receives a LoginFormSubmitArgs record with Email and Password.
*@

<form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" class="flex flex-col gap-6 max-w-sm w-full">

	<div>
		<h1 class="text-2xl font-bold tracking-tight text-foreground">@Title</h1>
		@if ( !string.IsNullOrEmpty( Description ) )
		{
			<p class="text-sm text-muted-foreground mt-1">@Description</p>
		}
	</div>

	<TextField Label="Email" Type="TextField.TextFieldType.Email" Value="@Email" ValueChanged="@( e => Email = e )" Required="true" />
	<PasswordField Label="Password" Value="@Password" ValueChanged="@( e => Password = e )" Required="true" />

	<button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap shrink-0 align-middle text-md font-semibold transition-all cursor-pointer disabled:pointer-events-none disabled:opacity-50 outline-none focus-visible:border-primary focus-visible:ring-primary/50 focus-visible:ring-[3px] h-10 min-w-10 px-4 rounded-4xl bg-primary text-inverse-text hover:bg-primary-hover active:bg-primary-active w-full">
		Sign in
	</button>

	@if ( Footer is not null )
	{
		<div class="text-center text-sm">@Footer</div>
	}

</form>

@code {
	[Parameter] public EventCallback<LoginFormSubmitArgs> OnSubmit { get; set; }
	[Parameter] public string? Title { get; set; } = "Sign in";
	[Parameter] public string? Description { get; set; }
	[Parameter] public RenderFragment? Footer { get; set; }

	private string? Email;
	private string? Password;

	private async Task HandleSubmit()
	{
		if ( OnSubmit.HasDelegate )
			await OnSubmit.InvokeAsync( new LoginFormSubmitArgs( Email ?? "", Password ?? "" ) );
	}

	public sealed record LoginFormSubmitArgs( string Email, string Password );
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	CustomFieldShell — shell for the XMC Page Builder Custom Field dialog
	extension point. The host provides a dialog of constrained size; this shell
	arranges Title + Header + Body + Actions inside that area.
*@

<div class="@OuterClass">
	@if ( !string.IsNullOrEmpty( Title ) || Header is not null )
	{
		<div class="@HeaderClass">
			@if ( !string.IsNullOrEmpty( Title ) )
			{
				<h2 class="text-base font-semibold tracking-tight text-foreground">@Title</h2>
			}
			@if ( Header is not null )
			{
				<div>@Header</div>
			}
		</div>
	}
	<div class="@BodyClass">
		@Body
	</div>
	@if ( Actions is not null )
	{
		<div class="@ActionsClass">@Actions</div>
	}
</div>

@code {
	[Parameter] public string? Title { get; set; }
	[Parameter] public RenderFragment? Header { get; set; }
	[Parameter] public RenderFragment? Body { get; set; }
	[Parameter] public RenderFragment? Actions { get; set; }

	[Parameter] public bool Borders { get; set; } = true;
	[Parameter] public bool Gutters { get; set; } = true;
	[Parameter] public bool BgFilled { get; set; } = true;

	private string OuterClass
		=> CssClassBuilder.Start( "flex flex-col w-full h-full" )
			.With( "border border-border rounded-lg", Borders )
			.With( "bg-background", BgFilled )
			.Build();

	private string HeaderClass
		=> CssClassBuilder.Start( "flex-shrink-0 flex items-center gap-3" )
			.With( "border-b border-border", Borders )
			.With( "px-4 py-3", Gutters )
			.Build();

	private string BodyClass
		=> CssClassBuilder.Start( "flex-1 min-h-0 overflow-y-auto" )
			.With( "p-4", Gutters )
			.Build();

	private string ActionsClass
		=> CssClassBuilder.Start( "flex-shrink-0 flex items-center justify-end gap-2" )
			.With( "border-t border-border", Borders )
			.With( "px-4 py-3", Gutters )
			.Build();
}

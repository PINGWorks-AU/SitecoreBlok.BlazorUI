@namespace PINGWorks.SitecoreBlok.BlazorUI

@*
	SplitShell — two-pane master/detail layout.
	Direction uses the shared Orientation enum.
	Resizable=true wraps the panes in ResizablePanelGroup (drag handle); requires an interactive
	context (e.g. @rendermode InteractiveServer) for its JSInterop. Resizable=false (default) renders
	pure markup and is SSR-safe.

	Each pane scrolls its own oversized content (overflow-auto) in BOTH modes — resizing does not
	change content behaviour.

	Wrapper-styling parameters (per spec §5.13):
		- Borders   (default true) toggles the divide-x/divide-y line between panes (static mode; resizable mode uses the drag handle).
		- Gutters   (default true) toggles p-4 on each pane.
		- BgFilled  (default true) toggles bg-background on each pane.
*@

@if ( Resizable )
{
	<ResizablePanelGroup Direction="@( Direction is Orientation.Horizontal ? ResizableDirection.Horizontal : ResizableDirection.Vertical )">
		<ResizablePanel DefaultSize="@( Ratio * 100 )">
			<div class="@ResizablePaneClass">
				@if ( Start is not null ) { @Start }
			</div>
		</ResizablePanel>
		<ResizableHandle />
		<ResizablePanel DefaultSize="@( ( 1 - Ratio ) * 100 )">
			<div class="@ResizablePaneClass">
				@if ( End is not null ) { @End }
			</div>
		</ResizablePanel>
	</ResizablePanelGroup>
}
else
{
	<div class="@RootClass">
		<div class="@PaneClass">
			@if ( Start is not null ) { @Start }
		</div>
		<div class="@PaneClass">
			@if ( End is not null ) { @End }
		</div>
	</div>
}

@code {
	[Parameter] public RenderFragment? Start { get; set; }
	[Parameter] public RenderFragment? End { get; set; }

	[Parameter] public Orientation Direction { get; set; } = Orientation.Horizontal;
	[Parameter] public bool Resizable { get; set; } = false;
	[Parameter] public double Ratio { get; set; } = 0.5;

	[Parameter] public bool Borders { get; set; } = true;
	[Parameter] public bool Gutters { get; set; } = true;
	[Parameter] public bool BgFilled { get; set; } = true;

	private string RootClass
		=> CssClassBuilder.Start( "flex h-full w-full" )
			.With( OrientationClasses.Flex( Direction ) )
			.With( OrientationClasses.Divide( Direction ), Borders )
			.Build();

	private string PaneClass
		=> CssClassBuilder.Start( "flex-1 min-w-0 min-h-0 overflow-auto" )
			.With( "bg-background", BgFilled )
			.With( "p-4", Gutters )
			.Build();

	// ResizablePanel is overflow-hidden and flex-sized; fill it and scroll the content inside.
	private string ResizablePaneClass
		=> CssClassBuilder.Start( "size-full overflow-auto" )
			.With( "bg-background", BgFilled )
			.With( "p-4", Gutters )
			.Build();
}

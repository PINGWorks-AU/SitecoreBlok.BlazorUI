@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="navigation-menu-content" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start("p-2 pr-2.5")
		.With(ClassName)
		.Build();
}

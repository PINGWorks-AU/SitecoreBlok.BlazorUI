@namespace PINGWorks.SitecoreBlok.BlazorUI

@implements IDisposable

@inject PopoverService Pops

@code {
	[Parameter, EditorRequired] public required string Id { get; set; }

	[Parameter] public bool Overlay { get; set; }
	[Parameter] public bool CloseOnBackgroundClick { get; set; } = true;

	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public EventCallback OnClose { get; set; }
	[Parameter] public string? ClassName { get; set; }

	/// <summary>ARIA role for the popup container. Leave null when the content supplies its own role; set to <c>dialog</c> for a popup that is a dialog, paired with <see cref="AriaLabel"/>.</summary>
	[Parameter] public string? Role { get; set; }

	/// <summary><c>aria-label</c> for the popup container. Only meaningful alongside <see cref="Role"/>.</summary>
	[Parameter] public string? AriaLabel { get; set; }

	public ElementReference? Anchor { get; set; }

	override protected void OnInitialized()
	{
		base.OnInitialized();
		Pops.Register( this );
	}

	public void Dispose()
	{
		Pops.Unregister( this.Id );
	}
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

@implements IDisposable

<input data-slot="search-input-control" type="@Type" value="@Value" placeholder="@Placeholder" disabled="@Disabled"
	   class="@CssClass" @oninput="OnInput" @attributes="AdditionalAttributes" />

@code {
	[Parameter] public string? ClassName { get; set; }
	[Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
	[Parameter] public string Type { get; set; } = "text";
	[Parameter] public string? Value { get; set; }
	[Parameter] public EventCallback<string?> ValueChanged { get; set; }
	[Parameter] public string? Placeholder { get; set; }
	[Parameter] public bool Disabled { get; set; }
	[Parameter] public int DebounceMs { get; set; } = 0;

	private CancellationTokenSource? DebounceCts;

	private string CssClass => CssClassBuilder.Start("flex-1 rounded-none border-0 bg-transparent shadow-none outline-none text-base md:text-sm placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50 focus-visible:ring-0 focus:ring-0 dark:bg-transparent pl-2 pr-2")
										.With(ClassName)
										.Build();

	private async Task OnInput(ChangeEventArgs e)
	{
		Value = e.Value?.ToString();

		if ( !ValueChanged.HasDelegate )
			return;

		if ( DebounceMs <= 0 )
		{
			await ValueChanged.InvokeAsync(Value);
			return;
		}

		DebounceCts?.Cancel();
		DebounceCts?.Dispose();
		DebounceCts = new CancellationTokenSource();
		var token = DebounceCts.Token;
		var pending = Value;

		try
		{
			await Task.Delay(DebounceMs, token);
			await ValueChanged.InvokeAsync(pending);
		}
		catch ( TaskCanceledException )
		{
			// Superseded by a later keystroke — ignore.
		}
	}

	public void Dispose()
	{
		DebounceCts?.Cancel();
		DebounceCts?.Dispose();
		DebounceCts = null;
	}
}

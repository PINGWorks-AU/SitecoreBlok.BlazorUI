@namespace PINGWorks.SitecoreBlok.BlazorUI

<button @ref="Ref" type="button" role="menuitem" data-slot="menubar-trigger"
		id="@ParentMenu.TriggerId"
		aria-haspopup="menu"
		aria-expanded="@( ParentMenu.IsOpen ? "true" : "false" )"
		aria-controls="@( ParentMenu.IsOpen ? ParentMenu.ContentId : null )"
		data-state="@( ParentMenu.IsOpen ? "open" : "closed" )"
		class="@CssClass" @onclick="OnClick" @onmouseenter="OnMouseEnter"
		@attributes="AdditionalAttributes">
	@ChildContent
</button>

@code {
	[CascadingParameter] public required Menubar ParentMenubar { get; set; }
	[CascadingParameter] public required MenubarMenu ParentMenu { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter( CaptureUnmatchedValues = true )] public Dictionary<string, object>? AdditionalAttributes { get; set; }

	private ElementReference Ref;

	// relative z-50 keeps triggers above the MenubarContent backdrop (z-40), so clicking a
	// different trigger while a menu is open is a single click — not two (backdrop close, then open).
	private string CssClass => CssClassBuilder.Start(
		"relative z-50 flex select-none items-center rounded-sm px-2 py-1 font-medium text-sm outline-hidden",
		// Blok's --accent equals the dark bar background, so fills use the flipping neutral scale for contrast in both themes.
		"hover:bg-neutral-200 hover:text-accent-foreground focus:bg-neutral-200 focus:text-accent-foreground",
		"data-[state=open]:bg-neutral-300 data-[state=open]:text-accent-foreground" )
											.With( ClassName )
											.Build();

	protected override void OnAfterRender( bool firstRender )
	{
		if ( firstRender )
			ParentMenu.RegisterTriggerRef( Ref );
	}

	// A click with no pointer detail came from Enter or Space, so the first item takes focus.
	private Task OnClick( MouseEventArgs args )
		=> ParentMenu.Toggle( focusFirstItem: args.Detail == 0 );

	private Task OnMouseEnter()
		=> ParentMenubar.HasAnyOpen && !ParentMenu.IsOpen ? ParentMenu.Open() : Task.CompletedTask;
}

@namespace PINGWorks.SitecoreBlok.BlazorUI
@inject IJSRuntime JS
@implements IAsyncDisposable

<CascadingValue Value="this">
	@ChildContent
</CascadingValue>

@code {
	[CascadingParameter] public required Menubar ParentMenubar { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }

	internal bool IsOpen { get; private set; }
	internal bool IsPositioned { get; private set; }
	internal double X { get; private set; }
	internal double Y { get; private set; }
	internal double TriggerLeft { get; private set; }
	internal double TriggerTop { get; private set; }
	internal double TriggerRight { get; private set; }
	internal double TriggerBottom { get; private set; }

	private ElementReference TriggerRef;
	private bool HasTriggerRef;
	private IJSObjectReference? Module;

	protected override void OnInitialized() => ParentMenubar.Register( this );

	internal void RegisterTriggerRef( ElementReference triggerRef )
	{
		TriggerRef = triggerRef;
		HasTriggerRef = true;
	}

	internal async Task Toggle()
	{
		if ( IsOpen )
			await Close();
		else
			await Open();
	}

	internal async Task Open()
	{
		if ( !HasTriggerRef ) return;
		await ParentMenubar.NotifyOpening( this );

		Module ??= await JS.InvokeAsync<IJSObjectReference>( "import", "/_content/PINGWorks.SitecoreBlok.BlazorUI/js/sitecoreUI.js" );
		var rect = await Module.InvokeAsync<ElementRect>( "SitecoreUI.getElementBounds", TriggerRef );

		TriggerLeft = rect.Left;
		TriggerTop = rect.Top;
		TriggerRight = rect.Left + rect.Width;
		TriggerBottom = rect.Top + rect.Height;
		X = TriggerLeft;
		Y = TriggerBottom + 8;
		IsPositioned = false;
		IsOpen = true;

		await InvokeAsync( StateHasChanged );
	}

	internal async Task UpdatePosition( double x, double y )
	{
		X = x;
		Y = y;
		IsPositioned = true;
		await InvokeAsync( StateHasChanged );
	}

	internal async Task Close()
	{
		IsOpen = false;
		IsPositioned = false;
		await InvokeAsync( StateHasChanged );
	}

	public async ValueTask DisposeAsync()
	{
		try
		{
			ParentMenubar.Unregister( this );
			await (Module?.DisposeAsync() ?? ValueTask.CompletedTask);
		}
		catch ( JSDisconnectedException ) { }
	}
}

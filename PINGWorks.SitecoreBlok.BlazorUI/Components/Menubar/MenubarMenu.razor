@namespace PINGWorks.SitecoreBlok.BlazorUI
@implements IDisposable

<CascadingValue Value="this">
	@ChildContent
</CascadingValue>

@code {
	[CascadingParameter] public required Menubar ParentMenubar { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }

	internal bool IsOpen { get; private set; }
	internal bool FocusFirstItemOnOpen { get; private set; }
	internal ElementReference TriggerRef { get; private set; }
	internal string TriggerId { get; } = $"menubar-{Guid.NewGuid():N}"[..17] + "-trigger";
	internal string ContentId
		=> TriggerId.Replace( "-trigger", "-content" );

	protected override void OnInitialized() => ParentMenubar.Register( this );

	internal void RegisterTriggerRef( ElementReference triggerRef )
		=> TriggerRef = triggerRef;

	internal Task Toggle( bool focusFirstItem = false )
		=> IsOpen ? Close() : Open( focusFirstItem );

	// State changes before anything is awaited: hover and click events are handled in order, so the last one always wins.
	internal Task Open( bool focusFirstItem = false )
	{
		var closing = ParentMenubar.NotifyOpening( this );

		FocusFirstItemOnOpen = focusFirstItem;
		IsOpen = true;

		return Task.WhenAll( closing, InvokeAsync( StateHasChanged ) );
	}

	internal Task Close()
	{
		IsOpen = false;

		return InvokeAsync( StateHasChanged );
	}

	public void Dispose()
		=> ParentMenubar.Unregister( this );
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

@if ( ParentMenu.IsOpen )
{
	@* Backdrop catches clicks outside the menu and closes it. *@
	<div class="fixed inset-0 z-40" @onclick="OnBackdropClick"></div>
	@* The style is constant so re-renders leave the position written by the placement script alone. *@
	<div @ref="Ref" id="@ParentMenu.ContentId" role="menu" aria-labelledby="@ParentMenu.TriggerId"
		 data-slot="menubar-content" data-state="open" class="@CssClass"
		 style="left:0;top:0;visibility:hidden;">
		@ChildContent
	</div>
}

@code {
	[CascadingParameter] public required MenubarMenu ParentMenu { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter] public DropdownMenuSide Side { get; set; } = DropdownMenuSide.Bottom;
	[Parameter] public DropdownMenuAlign Align { get; set; } = DropdownMenuAlign.Start;
	[Parameter] public double SideOffset { get; set; } = 8;

	private ElementReference Ref;
	private bool Placed;

	private string CssClass => CssClassBuilder.Start(
		"fixed z-50 min-w-[12rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md" )
											.With( ClassName )
											.Build();

	protected override async Task OnAfterRenderAsync( bool firstRender )
	{
		if ( !ParentMenu.IsOpen )
		{
			Placed = false;
			return;
		}

		if ( Placed )
			return;

		Placed = true;

		try
		{
			var module = await ParentMenu.ParentMenubar.Module();

			await module.InvokeVoidAsync( "place", Ref, ParentMenu.TriggerRef,
				Side.ToString().ToLowerInvariant(),
				Align.ToString().ToLowerInvariant(),
				SideOffset,
				ParentMenu.FocusFirstItemOnOpen );
		}
		catch ( JSDisconnectedException ) { }
	}

	private Task OnBackdropClick()
		=> ParentMenu.Close();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="accordion-item" class="@WrapperClass">
	<CascadingValue Value="this">
		@ChildContent
	</CascadingValue>
</div>

@code {
	[CascadingParameter] public required Accordion Parent { get; set; }
	[Parameter] public bool Disabled { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }

	internal bool IsOpen { get; private set; }
	internal bool EffectiveDisabled => Disabled || Parent.Disabled;

	private string WrapperClass => CssClassBuilder.Start( "border-b last:border-b-0" )
											.With( ClassName )
											.Build();

	protected override void OnInitialized()
	{
		base.OnInitialized();
		Parent.RegisterItem( this );
	}

	internal async Task SetState( bool isOpen )
	{
		IsOpen = isOpen;
		await InvokeAsync( StateHasChanged );
	}

	internal async Task Toggle()
	{
		if ( EffectiveDisabled )
			return;

		await SetState( !IsOpen );

		if ( IsOpen )
			await Parent.NotifyItemOpened( this );
	}
}

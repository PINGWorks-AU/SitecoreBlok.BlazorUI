@namespace PINGWorks.SitecoreBlok.BlazorUI

<div class="flex items-center hover:bg-blackAlpha-50 dark:hover:bg-whiteAlpha-100 transition-colors w-full min-w-0">
	<button type="button" data-slot="accordion-trigger" data-state="@( Parent.IsOpen ? "open" : "closed" )"
			class="@CssClass" disabled="@Parent.EffectiveDisabled" @onclick="Parent.Toggle">
		@ChildContent
		<Icon Svg="@IconSvg.ChevronDown" Scale="0.9" ClassName="transition-transform duration-200 size-6 shrink-0" />
	</button>
	@if ( Actions is not null )
	{
		<div class="flex items-center shrink-0 py-4 px-2" @onclick:stopPropagation>
			@Actions
		</div>
	}
</div>

@code {
	[CascadingParameter] public required AccordionItem Parent { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public RenderFragment? Actions { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "focus-visible:border-ring focus-visible:ring-ring/50 text-md font-normal text-foreground flex flex-1 cursor-pointer items-center justify-between gap-4 text-left transition-all outline-none focus-visible:ring-[3px] disabled:pointer-events-none disabled:opacity-50 [&[data-state=open]>svg]:rotate-180 min-w-0" )
											.With( "px-2", !CssClassBuilder.ContainsAny( ClassName, "px-", "p-" ) )
											.With( "py-4", !CssClassBuilder.ContainsAny( ClassName, "py-", "p-" ) )
											.With( ClassName )
											.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="dialog-footer" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "flex flex-col-reverse gap-2 pt-5 sm:flex-row sm:justify-end" )
										.With( ClassName )
										.Build();
}

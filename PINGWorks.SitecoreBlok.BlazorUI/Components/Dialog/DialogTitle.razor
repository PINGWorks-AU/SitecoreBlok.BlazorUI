@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="dialog-title" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "text-lg font-semibold" )
										.With( ClassName )
										.Build();
}

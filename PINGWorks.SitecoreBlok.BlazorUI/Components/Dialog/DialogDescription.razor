@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="dialog-description" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start("text-muted-foreground text-sm")
										.With(ClassName)
										.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="timeline-separator" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "flex flex-col items-center gap-0" )
											.With( ClassName )
											.Build();
}

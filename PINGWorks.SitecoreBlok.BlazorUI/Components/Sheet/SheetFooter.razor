@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="sheet-footer" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "flex gap-2 justify-end" )
										.With( "p-4", !CssClassBuilder.ContainsAny( ClassName, "p-" ) )
										.With( ClassName )
										.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="sheet-footer" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start("flex gap-2 p-4 justify-end")
										.With(ClassName)
										.Build();
}

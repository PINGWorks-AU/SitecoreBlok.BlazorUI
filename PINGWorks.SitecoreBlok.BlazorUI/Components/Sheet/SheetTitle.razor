@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="sheet-title" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start("font-semibold text-foreground")
										.With(ClassName)
										.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="sheet-header" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start("flex flex-col gap-0.5 p-4")
										.With(ClassName)
										.Build();
}

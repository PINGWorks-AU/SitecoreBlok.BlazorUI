@namespace PINGWorks.SitecoreBlok.BlazorUI

@inject PopoverService Pops

<CascadingValue Value="this">
	@ChildContent
</CascadingValue>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? Value { get; set; }
	[Parameter] public EventCallback<string?> ValueChanged { get; set; }

	/// <summary>
	/// The label for <see cref="Value"/>, supplied by a consumer that holds the options as data. Set it
	/// whenever <see cref="Value"/> may be populated before the dropdown is first opened.
	/// </summary>
	[Parameter] public string? ValueLabel { get; set; }
	[Parameter] public bool Disabled { get; set; }

	internal string SelectId { get; } = Guid.NewGuid().ToString();
	internal bool IsOpen { get; private set; }
	internal ElementReference? TriggerRef { get; private set; }

	/// <summary>
	/// Display labels by value, retained after the items that supplied them are unregistered. Keyed by
	/// value, so a label is only ever returned for the value it was captured against.
	/// </summary>
	private readonly Dictionary<string, string> LabelCache = [];

	private readonly List<ComponentBase> Items = [];

	internal void Register( ComponentBase item )
	{
		if ( !Items.Contains( item ) && item is SelectItem or SelectGroup )
			Items.Add( item );

		if ( item is SelectItem si && si.Value is not null && si.Label is not null )
			LabelCache[si.Value] = si.Label;
	}

	internal void Unregister( ComponentBase item )
	{
		Items.Remove( item );
	}

	/// <summary>
	/// The text the trigger shows for the current value: the cached label, then <see cref="ValueLabel"/>,
	/// then a registered item's label, and finally the raw value.
	/// </summary>
	internal string? GetDisplayLabel()
	{
		if ( Value is null ) return null;
		if ( LabelCache.TryGetValue( Value, out var cached ) ) return cached;
		if ( ValueLabel is not null ) return ValueLabel;

		var item = Items.OfType<SelectItem>().FirstOrDefault( i => i.Value == Value );
		return item?.Label ?? Value;
	}

	internal void RegisterTriggerRef( ElementReference triggerRef )
	{
		TriggerRef = triggerRef;
	}

	internal async Task SetValue( string? value, string? label = null )
	{
		if ( value is not null && label is not null )
			LabelCache[value] = label;

		if ( Value != value )
		{
			Value = value;
			await ValueChanged.InvokeAsync( Value );
		}

		await Pops.Hide( SelectId );
		await Close();
	}

	internal async Task Toggle()
	{
		if ( Disabled )
			return;

		if ( IsOpen )
			await Close();
		else
			await Open();
	}

	internal async Task Close()
	{
		IsOpen = false;
		await InvokeAsync( StateHasChanged );
	}

	internal async Task Open()
	{
		if ( TriggerRef is null ) return;

		IsOpen = true;
		await Pops.Show( SelectId, TriggerRef );
		await InvokeAsync( StateHasChanged );
	}
}

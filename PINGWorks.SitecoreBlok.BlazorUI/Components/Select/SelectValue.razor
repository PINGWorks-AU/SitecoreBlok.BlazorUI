@namespace PINGWorks.SitecoreBlok.BlazorUI

<span data-slot="select-value" style="pointer-events:none">
	@if ( Parent.Value is not null )
	{
		@Parent.GetDisplayLabel()
	}
	else if ( Placeholder is not null )
	{
		@Placeholder
	}
</span>

@code {
	[CascadingParameter] public required Select Parent { get; set; }
	[Parameter] public string? Placeholder { get; set; }
}

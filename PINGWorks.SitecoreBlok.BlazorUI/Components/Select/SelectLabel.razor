@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="select-label" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "text-muted-foreground px-2 py-1.5 text-xs font-semibold uppercase" )
											.With( ClassName )
											.Build();
}

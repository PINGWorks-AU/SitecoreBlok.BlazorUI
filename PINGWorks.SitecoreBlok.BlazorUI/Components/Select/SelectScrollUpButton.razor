@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="select-scroll-up-button" aria-label="Scroll up" class="@CssClass">
	<Icon Svg="@IconSvg.ChevronUp" ClassName="size-6" />
</div>

@code {
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "flex cursor-default items-center justify-center py-1 text-foreground" )
											.With( ClassName )
											.Build();
}

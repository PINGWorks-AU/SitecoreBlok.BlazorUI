@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="alert-dialog-title" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start("pb-5 text-lg font-semibold")
										.With(ClassName)
										.Build();
}

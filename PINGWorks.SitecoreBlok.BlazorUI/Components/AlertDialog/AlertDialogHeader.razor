@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="alert-dialog-header" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start("flex flex-col gap-2 text-center sm:text-left")
										.With(ClassName)
										.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

@if ( !Closed )
{
	<div data-slot="alert" role="alert" class="@CssClass" @attributes="AdditionalAttributes">
		<Icon Svg="@VariantIcon" Scale="1.2" ClassName="text-current" />

		@ChildContent

		@if ( Closeable )
		{
			@* `Closeable` is a Blazor-side addition (not in Blok). Documented on the Catalogue page. *@
			<Button Click="Close" Size="ButtonSize.Xs" ColorScheme="ButtonColor.Neutral" Variant="ButtonVariant.Ghost" ClassName="absolute top-2.5 right-3 h-6 shadow-none" Title="✕" />
		}
	</div>
}

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter( CaptureUnmatchedValues = true )] public Dictionary<string, object>? AdditionalAttributes { get; set; }

	[Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Default;

	/// <summary>
	/// When true, render a close button at the top-right that hides the alert when clicked.
	/// Blazor-only feature; not part of the Blok API.
	/// </summary>
	[Parameter] public bool Closeable { get; set; }

	// NOTE — selectors use descendant combinators (underscore-svg and has-svg),
	// NOT direct-child combinators. Our Icon component wraps the raw svg in a span,
	// so direct-child selectors silently fail to match. If these are changed to
	// direct-child the icon will still render but
	//   (a) the grid-cols layout will collapse to `0_1fr` (no icon column)
	//   (b) the icon colour will drop to `currentColor` only (no variant colouring)
	// Also: `text-foreground` is explicit so the body text stays legible under
	// light/dark theme flips.
	private string CssClass => CssClassBuilder.Start( "relative w-full rounded-md px-4 py-3 text-sm text-foreground grid has-[svg]:grid-cols-[calc(var(--spacing)*4)_1fr] grid-cols-[0_1fr] has-[svg]:gap-x-4 gap-y-0.5 items-center [&_svg]:size-4 [&_svg]:text-current" )
											.With( "bg-primary-bg [&_svg]:text-primary-500 dark:[&_svg]:text-primary-200", Variant is AlertVariant.Default )
											.With( "bg-primary-bg [&_svg]:text-primary-500 dark:[&_svg]:text-primary-200", Variant is AlertVariant.Primary )
											.With( "bg-danger-bg [&_svg]:text-danger-500 dark:[&_svg]:text-danger-200", Variant is AlertVariant.Danger )
											.With( "bg-warning-bg [&_svg]:text-warning-500 dark:[&_svg]:text-warning-200", Variant is AlertVariant.Warning )
											.With( "bg-success-bg [&_svg]:text-success-500 dark:[&_svg]:text-success-200", Variant is AlertVariant.Success )
											.With( ClassName )
											.Build();

	private string VariantIcon => Variant switch
	{
		AlertVariant.Danger => IconSvg.AlertCircle,
		AlertVariant.Warning => IconSvg.AlertCircle,
		AlertVariant.Success => IconSvg.CheckCircle,
		_ => IconSvg.Information,
	};

	private bool Closed;

	public async Task Close()
	{
		Closed = true;
		await InvokeAsync( StateHasChanged );
	}
}

@namespace PINGWorks.SitecoreBlok.BlazorUI
@inherits FilterSelectBase

<div class="@RootCssClass" @onkeydown="OnKeyDown" @attributes="AdditionalAttributes">
	@if ( Name is not null )
	{
		<input type="hidden" name="@Name" value="@string.Join( ",", SelectedValues )" />
	}

	<div class="relative inline-flex w-fit max-w-full" style="@ConstrainedStyle">
		<button @ref="AnchorRef" type="button" data-slot="filter-multi-select-trigger"
				data-state="@( IsOpen ? "open" : "closed" )"
				aria-haspopup="listbox" aria-expanded="@( IsOpen ? "true" : "false" )"
				aria-label="@TriggerLabel" aria-describedby="@DescribedBy"
				disabled="@Disabled" style="@ConstrainedStyle"
				class="@TriggerCssClass" @onclick="Toggle">
			<span class="@TriggerContentCssClass">
				<span class="@( $"font-semibold shrink-0 {StateTextCssClass}" )">@Placeholder</span>

				@if ( HasValues && ShowSelectedCount && DisplayMode is FilterDisplayMode.Text )
				{
					<Badge ColorScheme="BadgeColor.Neutral" Size="BadgeSize.Sm" ClassName="ml-1.5">@SelectedValues.Count</Badge>
				}
				else if ( HasValues && DisplayMode is FilterDisplayMode.Text )
				{
					<span class="@( $"shrink-0 {StateTextCssClass}" )">:</span>
					<span class="@ShownLabelsCssClass" title="@string.Join( ", ", SelectedLabels )">@string.Join( ", ", ShownLabels )</span>
					@if ( OverflowCount > 0 )
					{
						<span class="@( $"shrink-0 font-normal {StateTextCssClass}" )">+@OverflowCount</span>
					}
					<span class="sr-only">@string.Join( ", ", SelectedLabels )</span>
				}
				else if ( HasValues && DisplayMode is FilterDisplayMode.Badge )
				{
					<span class="text-neutral-fg shrink-0">:</span>
					<span class="@BadgeStripCssClass">
						@foreach ( var value in SelectedValues.Take( MaxDisplayItems ) )
						{
							var current = value;
							var label = AllOptions.FirstOrDefault( o => o.Value == current )?.Label;

							@if ( label is not null )
							{
								<Badge ColorScheme="BadgeColor.Neutral" Size="BadgeSize.Sm" ClassName="overflow-visible! shrink-0" style="min-height:1.5rem">
									<span>@label</span>
									<span role="button" tabindex="0" aria-label="@( $"Remove {label}" )"
										  class="cursor-pointer rounded-full p-0 hover:bg-neutral-bg-active flex items-center justify-center -mr-1 pointer-events-auto focus:outline-none focus:ring-1 focus:ring-ring"
										  @onclick="@( () => ToggleValue( current ) )" @onclick:stopPropagation="true"
										  @onkeydown="@( args => OnBadgeKeyDown( args, current ) )">
										<Icon Svg="@IconSvg.Close" Scale="0.6" />
									</span>
								</Badge>
							}
						}
					</span>
					@if ( OverflowCount > 0 )
					{
						<span class="@( $"shrink-0 font-normal {StateTextCssClass}" )">+@OverflowCount</span>
					}
				}
			</span>
			@if ( !( HasValues && ShowClear ) )
			{
				<Icon Svg="@IconSvg.ChevronDown" ClassName="size-4 shrink-0 pointer-events-none text-current" />
			}
		</button>

		@if ( ShowClear && HasValues )
		{
			<Button OnClick="Clear" Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" ColorScheme="ButtonColor.Neutral"
					aria-label="@( AriaLabels?.ClearSelection ?? "Clear selection" )"
					ClassName="absolute right-2 top-1/2 -translate-y-1/2 pointer-events-auto text-neutral-fg hover:bg-neutral-bg-active">
				<Icon Svg="@IconSvg.Close" Scale="0.75" />
			</Button>
		}
	</div>

	@if ( IsOpen )
	{
		<div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>
	}

	@* Anti-revert: see FilterSelectBase — this dropdown is rendered in place with `fixed`, not via
	   PopoverService, because the search box must re-filter the list live. *@
	<div data-slot="filter-multi-select-content" data-state="@( IsOpen ? "open" : "closed" )"
		 class="@DropdownCssClass" style="@DropdownStyle">
		@if ( Searchable && ShowSearch )
		{
			<div class="mb-2">
				<SearchInput ClassName="h-10 border-border has-[[data-slot=search-input-control]:focus-visible]:border-primary">
					<SearchInputLeftElement>
						<Icon Svg="@IconSvg.Magnify" Scale="0.9" ClassName="text-muted-foreground" />
					</SearchInputLeftElement>
					<SearchInputField Value="@SearchQuery" ValueChanged="OnSearchChanged"
									  Placeholder="@SearchPlaceholder" ClassName="placeholder:text-muted-foreground"
									  aria-label="@( AriaLabels?.SearchInput ?? SearchPlaceholder )" />
					@if ( SearchQuery.Length > 0 )
					{
						<SearchInputRightElement>
							<SearchInputClearButton OnClear="@( () => OnSearchChanged( string.Empty ) )" AriaLabel="Clear search" />
						</SearchInputRightElement>
					}
				</SearchInput>
			</div>
		}

		<div class="max-h-80 w-full -mx-1 px-1 overflow-y-auto overflow-x-hidden [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-border"
			 style="scrollbar-width:thin;scrollbar-color:var(--border) transparent;">
			<div class="py-0.5" role="listbox" aria-multiselectable="true" aria-label="@ListboxLabel">
				@if ( FilteredOptions.Count == 0 )
				{
					<div class="py-6 text-center text-sm text-muted-foreground">@NoResultsText</div>
				}
				else if ( Groups is not null )
				{
					@foreach ( var group in FilteredGroups )
					{
						<div class="px-2 py-1 text-xs font-semibold text-muted-foreground">@group.Label</div>
						@foreach ( var option in group.Options )
						{
							@OptionRow( option )
						}
					}
				}
				else
				{
					@foreach ( var option in FilteredOptions )
					{
						@OptionRow( option )
					}
				}
			</div>
		</div>
	</div>

	@if ( HelperText is not null )
	{
		<p id="@HelperId" class="mt-1 text-xs text-muted-foreground">@HelperText</p>
	}
</div>

@code {
	[Parameter] public List<string> Values { get; set; } = [];
	[Parameter] public EventCallback<List<string>> ValuesChanged { get; set; }

	[Parameter] public FilterDisplayMode DisplayMode { get; set; } = FilterDisplayMode.Text;

	/// <summary>How many selected labels (or badges) appear on the trigger before an overflow "+N".</summary>
	[Parameter] public int MaxDisplayItems { get; set; } = 2;

	/// <summary>When true, the trigger shows a count badge instead of the selected labels.</summary>
	[Parameter] public bool ShowSelectedCount { get; set; }

	/// <summary>Optional pixel cap on the trigger width; the selected labels truncate within it.</summary>
	[Parameter] public int? MaxButtonWidth { get; set; }

	/// <summary>Controls the dropdown's open state. Leave unset to let the trigger own it; supports two-way binding via <c>@bind-Open</c>.</summary>
	[Parameter] public bool? Open { get; set; }

	/// <summary>Fires whenever the dropdown opens or closes. Nullable so it pairs with <c>Open</c> under <c>@bind-Open</c>; the value raised is never null.</summary>
	[Parameter] public EventCallback<bool?> OpenChanged { get; set; }

	private List<string> SelectedValues => Values ?? [];

	private bool HasValues => SelectedValues.Count > 0;

	private List<string> SelectedLabels
		=> SelectedValues.Select( v => AllOptions.FirstOrDefault( o => o.Value == v )?.Label )
						.Where( l => l is not null )
						.Select( l => l! )
						.ToList();

	private List<string> ShownLabels => SelectedLabels.Take( MaxDisplayItems ).ToList();

	private int OverflowCount => Math.Max( 0, SelectedLabels.Count - MaxDisplayItems );

	private string StateTextCssClass => IsOpen ? "text-primary-fg" : "text-neutral-fg";

	private string? ConstrainedStyle => MaxButtonWidth is null ? null : $"max-width:{MaxButtonWidth}px";

	/// <summary>Groups with their options filtered by the query, dropping groups left empty.</summary>
	private IReadOnlyList<FilterSelectGroup> FilteredGroups
	{
		get
		{
			if ( Groups is null )
				return [];

			var query = SearchQuery.Trim();

			if ( query.Length == 0 )
				return Groups;

			return Groups.Select( g => g with { Options = g.Options.Where( o => o.Label.Contains( query, StringComparison.OrdinalIgnoreCase ) ).ToList() } )
						.Where( g => g.Options.Count > 0 )
						.ToList();
		}
	}

	protected override void OnParametersSet()
	{
		if ( Open is bool open )
			IsOpen = open;
	}

	protected override async Task NotifyOpenChanged( bool open )
	{
		Open = open;

		if ( OpenChanged.HasDelegate )
			await OpenChanged.InvokeAsync( open );
	}

	protected override void OnAfterRender( bool firstRender )
	{
		if ( firstRender )
			HasAnchorRef = true;
	}

	private RenderFragment OptionRow( FilterOption option ) => @<label class="@OptionCssClass( option )">
		<Checkbox Checked="@SelectedValues.Contains( option.Value )"
				  CheckedChanged="@( _ => ToggleValue( option.Value ) )"
				  Disabled="@option.Disabled" ClassName="pointer-events-auto shrink-0" />
		@if ( RenderOption is not null )
		{
			@RenderOption( option )
		}
		else if ( option.Description is not null )
		{
			<span class="flex flex-col gap-0.5">
				<span>@option.Label</span>
				<span class="text-xs text-muted-foreground">@option.Description</span>
			</span>
		}
		else
		{
			@option.Label
		}
	</label>;

	private string RootCssClass => CssClassBuilder.Start( "relative inline-flex w-fit flex-col" )
										.With( ClassName )
										.Build();

	private string TriggerContentCssClass => CssClassBuilder.Start( "flex items-center gap-0.5 text-left pointer-events-none" )
										.With( "min-w-0 flex-1 overflow-hidden", MaxButtonWidth is not null )
										.Build();

	private string ShownLabelsCssClass => CssClassBuilder.Start( "font-normal" )
										.With( "min-w-0 flex-1 truncate", MaxButtonWidth is not null )
										.With( "shrink-0", MaxButtonWidth is null )
										.With( StateTextCssClass )
										.Build();

	private string BadgeStripCssClass => CssClassBuilder.Start( "flex items-center gap-1.5 flex-nowrap ml-0.5" )
										.With( "min-w-0 flex-1 overflow-hidden", MaxButtonWidth is not null )
										.Build();

	private string TriggerCssClass => CssClassBuilder.Start(
		"border-border text-md text-neutral-fg font-semibold outline-none focus-visible:ring-1 focus-visible:ring-ring/50",
		"aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40",
		"bg-body-bg hover:bg-neutral-bg dark:bg-input/30 dark:hover:bg-input/50",
		"flex w-fit min-w-0 max-w-full items-center justify-between gap-2 rounded-md border-1 px-3 py-2 whitespace-nowrap transition-[color] h-10 cursor-pointer",
		"disabled:cursor-not-allowed disabled:opacity-50",
		"data-[state=open]:border-primary data-[state=open]:border-2 data-[state=open]:bg-primary-bg data-[state=open]:text-primary-fg data-[state=open]:hover:bg-primary-bg",
		"[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 [&>svg]:!text-current [&>svg]:!opacity-100" )
										.With( "pr-8 overflow-hidden", HasValues && ShowClear )
										.Build();

	private string DropdownCssClass => CssClassBuilder.Start(
		"fixed z-50 w-54 min-w-54 rounded-lg border border-border bg-popover text-popover-foreground shadow-md outline-none p-2" )
										.With( DropdownClassName )
										.Build();

	private string DropdownStyle
		=> IsOpen ? $"left:{X}px;top:{Y}px;" : "display:none";

	private string OptionCssClass( FilterOption option ) => CssClassBuilder.Start(
		"flex items-center gap-2 px-2 py-1 text-sm rounded-sm cursor-pointer hover:bg-accent/50" )
										.With( "opacity-50 cursor-not-allowed", option.Disabled )
										.Build();

	private async Task ToggleValue( string value )
	{
		var next = new List<string>( SelectedValues );

		if ( next.Contains( value ) )
			next.Remove( value );
		else
			next.Add( value );

		Values = next;

		if ( ValuesChanged.HasDelegate )
			await ValuesChanged.InvokeAsync( Values );

		await InvokeAsync( StateHasChanged );
	}

	/// <summary>Enter and Space remove the badge, matching the keyboard handler Blok puts on the same control.</summary>
	private async Task OnBadgeKeyDown( KeyboardEventArgs args, string value )
	{
		if ( args.Key is "Enter" or " " )
			await ToggleValue( value );
	}

	private async Task Clear()
	{
		Values = [];

		if ( ValuesChanged.HasDelegate )
			await ValuesChanged.InvokeAsync( Values );

		await InvokeAsync( StateHasChanged );
	}
}

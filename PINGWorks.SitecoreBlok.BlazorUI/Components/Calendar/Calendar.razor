@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="calendar" class="@CssClass">
	<div class="flex gap-4">
		@for ( var mi = 0; mi < NumberOfMonths; mi++ )
		{
			var monthDate = DisplayDate.AddMonths( mi );
			var isFirst = mi == 0;
			var isLast = mi == NumberOfMonths - 1;

			<div class="flex flex-col w-full gap-4">
				<div class="flex items-center justify-between w-full relative px-1">
					@if ( isFirst )
					{
						<button type="button" class="inline-flex items-center justify-center size-8 rounded-md bg-transparent opacity-50 hover:opacity-100 cursor-pointer"
								aria-label="@PreviousMonthLabel" aria-disabled="@PreviousDisabledAttr" tabindex="@PreviousTabIndexAttr"
								@onclick="PreviousMonth">
							<Icon Svg="@IconSvg.ChevronLeft" Scale="0.9" ClassName="text-neutral size-4" ResetClassName />
						</button>
					}
					else
					{
						<div class="size-8"></div>
					}

					@{
						var offset = mi;
					}
					<div class="flex items-center gap-1.5">
						<Select Value="@monthDate.Month.ToString()" ValueLabel="@( monthDate.ToString( "MMM" ) )" ValueChanged="v => OnMonthSelected( v, offset )">
							<SelectTrigger Sm="true" aria-label="@MonthDropdownLabel"
										   ClassName="z-50 px-3 text-sm [&_svg:not([class*='text-'])]:text-accent-foreground bg-transparent dark:bg-transparent dark:hover:bg-transparent">
								<SelectValue />
							</SelectTrigger>
							<SelectContent ClassName="rounded-md p-0 min-w-20">
								@for ( var m = 1; m <= 12; m++ )
								{
									var monthLabel = new DateTime( 2000, m, 1 ).ToString( "MMM" );
									<SelectItem Value="@m.ToString()" Label="@monthLabel" ClassName="cursor-pointer px-3 py-1.5 text-sm" />
								}
							</SelectContent>
						</Select>
						<Select Value="@monthDate.Year.ToString()" ValueLabel="@monthDate.Year.ToString()" ValueChanged="v => OnYearSelected( v, offset )">
							<SelectTrigger Sm="true" aria-label="@YearDropdownLabel"
										   ClassName="z-50 px-3 text-sm [&_svg:not([class*='text-'])]:text-accent-foreground bg-transparent dark:bg-transparent dark:hover:bg-transparent">
								<SelectValue />
							</SelectTrigger>
							<SelectContent ClassName="rounded-md p-0 min-w-20">
								@for ( var y = YearStart; y <= YearEnd; y++ )
								{
									<SelectItem Value="@y.ToString()" Label="@y.ToString()" ClassName="cursor-pointer px-3 py-1.5 text-sm" />
								}
							</SelectContent>
						</Select>
					</div>

					@if ( isLast )
					{
						<button type="button" class="inline-flex items-center justify-center size-8 rounded-md bg-transparent opacity-50 hover:opacity-100 cursor-pointer"
								aria-label="@NextMonthLabel" aria-disabled="@NextDisabledAttr" tabindex="@NextTabIndexAttr"
								@onclick="NextMonth">
							<Icon Svg="@IconSvg.ChevronRight" Scale="0.9" ClassName="text-neutral size-4" ResetClassName />
						</button>
					}
					else
					{
						<div class="size-8"></div>
					}
				</div>

				<div>
					<div class="flex">
						@foreach ( var day in DayNames )
						{
							<div class="text-muted-foreground text-xs font-normal select-none flex-1 text-center rounded-md h-8 flex items-center justify-center">@day</div>
						}
					</div>

					@foreach ( var week in GetWeeksForMonth( monthDate ) )
					{
						<div class="flex w-full mt-0.5">
							@foreach ( var date in week )
							{
								var isCurrent = date.Month == monthDate.Month;
								var isDisabled = IsDateDisabled( date );
								var isToday = date.Date == DateTime.Today;
								var isSelected = !IsRange && Value?.Date == date.Date;
								var isRangeStart = IsRange && RangeStart?.Date == date.Date;
								var isRangeEnd = IsRange && RangeEnd?.Date == date.Date;
								var isRangeMiddle = IsRange && RangeStart.HasValue && RangeEnd.HasValue
									&& date.Date > RangeStart.Value.Date && date.Date < RangeEnd.Value.Date;

								<button type="button" @onclick="() => SelectDate( date )"
										disabled="@( isDisabled )"
										aria-label="@DayAriaLabel( date )"
										aria-pressed="@( isSelected || isRangeStart || isRangeEnd || isRangeMiddle ? "true" : "false" )"
										data-day="@DayIso( date )"
										data-selected="@( isSelected || isRangeStart || isRangeEnd || isRangeMiddle ? "true" : "false" )"
										data-range-start="@( isRangeStart ? "true" : null )"
										data-range-end="@( isRangeEnd ? "true" : null )"
										data-range-middle="@( isRangeMiddle ? "true" : null )"
										class="@DayCssClass( isCurrent, isSelected, isToday, isDisabled, isRangeStart, isRangeEnd, isRangeMiddle )">
									@date.Day
								</button>
							}
						</div>
					}
				</div>
			</div>
		}
	</div>
</div>

@code {
	[Parameter] public string? ClassName { get; set; }
	[Parameter] public DateTime? Value { get; set; }
	[Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
	[Parameter] public DateTime? RangeStart { get; set; }
	[Parameter] public EventCallback<DateTime?> RangeStartChanged { get; set; }
	[Parameter] public DateTime? RangeEnd { get; set; }
	[Parameter] public EventCallback<DateTime?> RangeEndChanged { get; set; }
	[Parameter] public DateTime? MinDate { get; set; }
	[Parameter] public DateTime? MaxDate { get; set; }
	[Parameter] public int YearRangeStart { get; set; } = DateTime.Today.Year - 10;
	[Parameter] public int YearRangeEnd { get; set; } = DateTime.Today.Year + 10;
	[Parameter] public int NumberOfMonths { get; set; } = 1;
	[Parameter] public bool? Range { get; set; }
	[Parameter] public CalendarAriaLabels? AriaLabels { get; set; }

	private string PreviousMonthLabel => AriaLabels?.PreviousMonth ?? "Go to previous month";
	private string NextMonthLabel => AriaLabels?.NextMonth ?? "Go to next month";
	private string MonthDropdownLabel => AriaLabels?.MonthDropdown ?? "Choose the month";
	private string YearDropdownLabel => AriaLabels?.YearDropdown ?? "Choose the year";

	private string? PreviousDisabledAttr => CanGoPrevious ? null : "true";
	private string? NextDisabledAttr => CanGoNext ? null : "true";
	private string? PreviousTabIndexAttr => CanGoPrevious ? null : "-1";
	private string? NextTabIndexAttr => CanGoNext ? null : "-1";

	private bool CanGoPrevious
	{
		get
		{
			if ( !MinDate.HasValue )
				return true;

			var lastDayOfPreviousMonth = DisplayDate.AddDays( -1 );
			return lastDayOfPreviousMonth.Date >= MinDate.Value.Date;
		}
	}

	private bool CanGoNext
	{
		get
		{
			if ( !MaxDate.HasValue )
				return true;

			var firstDayAfterLastPanel = DisplayDate.AddMonths( NumberOfMonths );
			return firstDayAfterLastPanel.Date <= MaxDate.Value.Date;
		}
	}

	private static string DayAriaLabel( DateTime date ) => $"Select {date:D}";

	private static string DayIso( DateTime date ) => date.ToString( "yyyy-MM-dd" );

	private bool IsRange => Range.HasValue ? Range.Value : ( RangeStartChanged.HasDelegate || RangeEndChanged.HasDelegate );

	private DateTime DisplayDate;

	private static readonly string[] DayNames = [ "Su", "Mo", "Tu", "We", "Th", "Fr", "Sa" ];
	private int YearStart => MinDate?.Year ?? YearRangeStart;
	private int YearEnd => MaxDate?.Year ?? YearRangeEnd;

	protected override void OnInitialized()
	{
		DisplayDate = Value ?? RangeStart ?? DateTime.Today;
		DisplayDate = new DateTime( DisplayDate.Year, DisplayDate.Month, 1 );
	}

	private string CssClass => CssClassBuilder.Start( "p-3 bg-card text-card-foreground rounded-lg border border-border shadow-sm w-fit" )
										.With( ClassName )
										.Build();

	// `text-white` (literal) — NOT `text-inverse-text` — on the selected/range day
	// cells. The surface is a fixed `bg-primary-500` (medium blue, doesn't flip in
	// dark mode), so `text-inverse-text` would resolve to dark in dark mode and
	// produce dark-on-medium-blue (low contrast / unreadable). Selected days
	// always need white text against the primary-500 surface in both modes.
	// Caught by harness Check 5; do not revert.
	private static string DayCssClass( bool isCurrentMonth, bool isSelected, bool isToday, bool isDisabled,
									   bool isRangeStart, bool isRangeEnd, bool isRangeMiddle )
	{
		return CssClassBuilder.Start( "inline-flex items-center justify-center size-8 text-sm font-normal flex-1 border border-solid border-transparent cursor-pointer" )
										.With( "bg-primary-500 text-white hover:bg-primary-600 rounded-md", isSelected )
										.With( "bg-primary-500 text-white hover:bg-primary-600 rounded-l-md rounded-r-none", isRangeStart && !isRangeEnd )
										.With( "bg-primary-500 text-white hover:bg-primary-600 rounded-md", isRangeStart && isRangeEnd )
										.With( "bg-primary-500 text-white hover:bg-primary-600 rounded-r-md rounded-l-none", isRangeEnd && !isRangeStart )
										.With( "bg-primary-bg text-primary-fg hover:bg-primary hover:text-inverse-text rounded-none", isRangeMiddle )
										.With( "hover:bg-primary hover:text-inverse-text rounded-md", !isSelected && !isRangeStart && !isRangeEnd && !isRangeMiddle && isCurrentMonth && !isDisabled )
										.With( "bg-accent text-accent-foreground rounded-md", isToday && !isSelected && !isRangeStart && !isRangeEnd && !isRangeMiddle && isCurrentMonth )
										.With( "text-muted-foreground", !isCurrentMonth )
										.With( "text-muted-foreground opacity-50 cursor-not-allowed pointer-events-none", isDisabled )
										.Build();
	}

	private bool IsDateDisabled( DateTime date )
		=> ( MinDate.HasValue && date.Date < MinDate.Value.Date ) || ( MaxDate.HasValue && date.Date > MaxDate.Value.Date );

	private async Task SelectDate( DateTime date )
	{
		if ( IsDateDisabled( date ) ) return;

		if ( IsRange )
		{
			if ( !RangeStart.HasValue || ( RangeStart.HasValue && RangeEnd.HasValue ) )
			{
				RangeStart = date;
				RangeEnd = null;

				if ( RangeStartChanged.HasDelegate )
					await RangeStartChanged.InvokeAsync( RangeStart );

				if ( RangeEndChanged.HasDelegate )
					await RangeEndChanged.InvokeAsync( null );
			}
			else
			{
				if ( date < RangeStart )
				{
					RangeEnd = RangeStart;
					RangeStart = date;
				}
				else
				{
					RangeEnd = date;
				}

				if ( RangeStartChanged.HasDelegate )
					await RangeStartChanged.InvokeAsync( RangeStart );

				if ( RangeEndChanged.HasDelegate )
					await RangeEndChanged.InvokeAsync( RangeEnd );

				EnsureRangeEndVisible();
			}
		}
		else
		{
			Value = date;
			DisplayDate = new DateTime( date.Year, date.Month, 1 );

			if ( ValueChanged.HasDelegate )
				await ValueChanged.InvokeAsync( Value );
		}
	}

	private void EnsureRangeEndVisible()
	{
		if ( !RangeEnd.HasValue ) return;

		var lastVisibleMonth = DisplayDate.AddMonths( NumberOfMonths - 1 );

		if ( RangeEnd.Value.Year > lastVisibleMonth.Year ||
			 ( RangeEnd.Value.Year == lastVisibleMonth.Year && RangeEnd.Value.Month > lastVisibleMonth.Month ) )
		{
			var endMonth = new DateTime( RangeEnd.Value.Year, RangeEnd.Value.Month, 1 );
			DisplayDate = endMonth.AddMonths( -( NumberOfMonths - 1 ) );
		}
	}

	private void OnMonthSelected( string? value, int panelOffset )
	{
		if ( !int.TryParse( value, out var month ) )
			return;

		var panelDate = DisplayDate.AddMonths( panelOffset );
		var targetDate = new DateTime( panelDate.Year, month, 1 );
		DisplayDate = targetDate.AddMonths( -panelOffset );
	}

	private void OnYearSelected( string? value, int panelOffset )
	{
		if ( !int.TryParse( value, out var year ) )
			return;

		var panelDate = DisplayDate.AddMonths( panelOffset );
		var targetDate = new DateTime( year, panelDate.Month, 1 );
		DisplayDate = targetDate.AddMonths( -panelOffset );
	}

	private void PreviousMonth()
	{
		if ( !CanGoPrevious )
			return;

		DisplayDate = DisplayDate.AddMonths( -1 );
	}

	private void NextMonth()
	{
		if ( !CanGoNext )
			return;

		DisplayDate = DisplayDate.AddMonths( 1 );
	}

	private static List<DateTime[]> GetWeeksForMonth( DateTime monthDate )
	{
		var weeks = new List<DateTime[]>();
		var firstOfMonth = new DateTime( monthDate.Year, monthDate.Month, 1 );
		var start = firstOfMonth.AddDays( -(int)firstOfMonth.DayOfWeek );

		for ( var w = 0; w < 6; w++ )
		{
			var week = new DateTime[7];

			for ( var d = 0; d < 7; d++ )
				week[d] = start.AddDays( w * 7 + d );

			weeks.Add( week );
		}

		return weeks;
	}
}

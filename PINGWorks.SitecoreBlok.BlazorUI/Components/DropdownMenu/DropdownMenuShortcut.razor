@namespace PINGWorks.SitecoreBlok.BlazorUI

<span data-slot="dropdown-menu-shortcut" class="@CssClass">
	@ChildContent
</span>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "text-muted-foreground ml-auto text-xs tracking-widest" )
										.With( ClassName )
										.Build();
}

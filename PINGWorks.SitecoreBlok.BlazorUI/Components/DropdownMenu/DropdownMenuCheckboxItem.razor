@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="dropdown-menu-checkbox-item" role="menuitemcheckbox"
	 aria-checked="@( Checked ? "true" : "false" )"
	 data-state="@( Checked ? "checked" : "unchecked" )"
	 data-disabled="@( Disabled ? "" : null )"
	 class="@CssClass" @onclick="HandleClick">
	<span class="pointer-events-none absolute left-2 flex size-3.5 items-center justify-center">
		@if ( Checked )
		{
			<Icon Svg="@IconSvg.Check" Scale="0.9" ResetClassName />
		}
	</span>
	@ChildContent
</div>

@code {
	@* Same ancestor set as DropdownMenuItem — a checkbox item can sit in a top-level menu, a
	   ContextMenu, or a Sub, and selecting one dismisses the whole chain (Radix's default;
	   Blok does not preventDefault). *@
	[CascadingParameter] public DropdownMenu? ParentDropdownMenu { get; set; }
	[CascadingParameter] public ContextMenu? ParentContextMenu { get; set; }
	[CascadingParameter] public DropdownMenuSub? ParentSub { get; set; }

	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter] public bool Checked { get; set; }
	[Parameter] public EventCallback<bool> CheckedChanged { get; set; }
	[Parameter] public bool Disabled { get; set; }

	private string CssClass => CssClassBuilder.Start(
		"focus:bg-accent focus:text-accent-foreground relative flex cursor-pointer items-center gap-2 rounded-sm py-1.5 pr-2 pl-8 text-sm outline-hidden select-none",
		"hover:bg-neutral-bg",
		"data-[disabled]:pointer-events-none data-[disabled]:opacity-50",
		"[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg]:text-neutral-600 [&_svg:not([class*='size-'])]:size-[0.7rem]" )
										.With( ClassName )
										.Build();

	private async Task HandleClick()
	{
		if ( Disabled )
			return;

		Checked = !Checked;

		if ( CheckedChanged.HasDelegate )
			await CheckedChanged.InvokeAsync( Checked );

		if ( ParentSub is not null )
			await ParentSub.Close();
		if ( ParentDropdownMenu is not null )
			await ParentDropdownMenu.Close();
		if ( ParentContextMenu is not null )
			await ParentContextMenu.Close();
	}
}

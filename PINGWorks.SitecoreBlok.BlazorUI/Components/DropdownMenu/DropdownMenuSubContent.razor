@namespace PINGWorks.SitecoreBlok.BlazorUI
@implements IAsyncDisposable
@inject IJSRuntime JS

@if ( Parent.IsOpen )
{
	<div @ref="Ref" data-slot="dropdown-menu-sub-content" class="@CssClass"
		 style="left:@(Parent.Left)px;top:@(Parent.Top)px;@( Parent.IsPositioned ? null : "visibility:hidden;" )"
		 @onmouseenter="OnEnter" @onmouseleave="OnLeave">
		@ChildContent
	</div>
}

@code {
	[CascadingParameter] public required DropdownMenuSub Parent { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter] public DropdownMenuSide Side { get; set; } = DropdownMenuSide.Right;
	[Parameter] public DropdownMenuAlign Align { get; set; } = DropdownMenuAlign.Start;
	[Parameter] public double SideOffset { get; set; } = 0;

	private ElementReference Ref;
	private IJSObjectReference? Module;

	private string CssClass => CssClassBuilder.Start( "fixed z-[60] min-w-[8rem] rounded-md border bg-popover p-1 text-popover-foreground shadow-lg" )
											.With( ClassName )
											.Build();

	protected override async Task OnAfterRenderAsync( bool firstRender )
	{
		if ( Parent.IsOpen && !Parent.IsPositioned )
		{
			Module ??= await JS.InvokeAsync<IJSObjectReference>( "import", "/_content/PINGWorks.SitecoreBlok.BlazorUI/js/sitecoreUI.js" );
			var pos = await Module.InvokeAsync<DropdownSubPosition>(
				"SitecoreUI.calcDropdownPosition",
				Ref,
				Parent.TriggerLeft, Parent.TriggerTop, Parent.TriggerRight, Parent.TriggerBottom,
				Side.ToString().ToLowerInvariant(),
				Align.ToString().ToLowerInvariant(),
				SideOffset );
			await Parent.UpdatePosition( pos.X, pos.Y );
		}
	}

	private async Task OnEnter() => await Parent.Open();
	private async Task OnLeave() => await Parent.Close();

	private record DropdownSubPosition( double X, double Y );

	public async ValueTask DisposeAsync()
	{
		try
		{
			await (Module?.DisposeAsync() ?? ValueTask.CompletedTask);
		}
		catch ( JSDisconnectedException ) { }
	}
}

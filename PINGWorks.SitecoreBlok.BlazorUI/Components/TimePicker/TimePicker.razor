@namespace PINGWorks.SitecoreBlok.BlazorUI

@inject PopoverService Pops

<div data-slot="time-picker" class="@CssClass" @ref="Trigger" @attributes="AdditionalAttributes">
	<Button Variant="ButtonVariant.Outline" ColorScheme="ButtonColor.Neutral" OnClick="Toggle" Disabled="@Disabled"
			aria-label="@TriggerAriaLabel"
			ClassName="@( $"w-fit justify-between gap-2 whitespace-nowrap font-normal {( Value.HasValue ? "" : "text-muted-foreground" )}" )">
		@( Value.HasValue ? Format( Value.Value ) : Placeholder )
		<Icon Svg="@IconSvg.ClockOutline" ClassName="size-4 text-muted-foreground" aria-hidden="true" />
	</Button>

	<Popover Id="@Id" OnClose="Close" Role="dialog" AriaLabel="@PanelAriaLabel"
			 ClassName="w-auto p-4 rounded-md border border-border bg-popover text-popover-foreground shadow-md">
		<TimePickerPanel Value="@Value" ValueChanged="OnTimeChanged" OnDone="ClosePopup"
						 HourLabel="@HourLabel" MinuteLabel="@MinuteLabel" PeriodLabel="@PeriodLabel"
						 ClearText="@ClearText" DoneText="@DoneText" />
	</Popover>
</div>

@code {
	private readonly string Id = Guid.NewGuid().ToString();

	[Parameter] public string? ClassName { get; set; }
	[Parameter( CaptureUnmatchedValues = true )] public Dictionary<string, object>? AdditionalAttributes { get; set; }

	[Parameter] public TimeSpan? Value { get; set; }
	[Parameter] public EventCallback<TimeSpan?> ValueChanged { get; set; }
	[Parameter] public bool Disabled { get; set; }
	[Parameter] public string Placeholder { get; set; } = "Pick a time";

	/// <summary>Accessible name for the popup. Default: <c>Choose time</c>.</summary>
	[Parameter] public string PanelAriaLabel { get; set; } = "Choose time";

	[Parameter] public string HourLabel { get; set; } = "Hour";
	[Parameter] public string MinuteLabel { get; set; } = "Minute";
	[Parameter] public string PeriodLabel { get; set; } = "Period";
	[Parameter] public string ClearText { get; set; } = "Clear";
	[Parameter] public string DoneText { get; set; } = "Done";

	private ElementReference? Trigger;
	private bool IsOpen;

	/// <summary>Accessible name for the trigger. Null while a formatted time is displayed on it.</summary>
	private string? TriggerAriaLabel
		=> Value.HasValue ? null : Placeholder;

	private string CssClass => CssClassBuilder.Start( "relative inline-block" )
										.With( ClassName )
										.Build();

	/// <summary>Renders a time as 12-hour <c>hh:mm AM</c>.</summary>
	private static string Format( TimeSpan time )
	{
		var hour = time.Hours % 12;

		return $"{( hour == 0 ? 12 : hour ):D2}:{time.Minutes:D2} {( time.Hours >= 12 ? "PM" : "AM" )}";
	}

	private async Task Toggle()
	{
		if ( Disabled )
			return;

		if ( IsOpen )
			await ClosePopup();
		else
		{
			IsOpen = true;
			await Pops.Show( Id, Trigger );
		}
	}

	private void Close()
		=> IsOpen = false;

	private async Task ClosePopup()
	{
		IsOpen = false;
		await Pops.Hide( Id );
	}

	/// <summary>Applies a new time. The popup stays open; only Clear and Done dismiss it.</summary>
	private async Task OnTimeChanged( TimeSpan? value )
	{
		Value = value;

		if ( ValueChanged.HasDelegate )
			await ValueChanged.InvokeAsync( Value );
	}
}

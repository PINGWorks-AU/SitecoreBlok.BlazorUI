@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="card-footer" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "flex items-center [.border-t]:pt-6" )
										.With( ClassName )
										.Build();
}

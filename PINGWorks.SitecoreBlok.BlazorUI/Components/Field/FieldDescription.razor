@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="field-description" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "text-sm text-muted-foreground -mt-1" )
										.With( ClassName )
										.Build();
}

@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="field-group" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "flex flex-col gap-3 mt-5" )
										.With( ClassName )
										.Build();
}

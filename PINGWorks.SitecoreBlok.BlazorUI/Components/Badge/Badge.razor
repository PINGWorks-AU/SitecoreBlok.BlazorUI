@namespace PINGWorks.SitecoreBlok.BlazorUI

<span data-slot="badge" class="@CssClass" @attributes="AdditionalAttributes">
	@ChildContent
</span>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }
	[Parameter( CaptureUnmatchedValues = true )] public Dictionary<string, object>? AdditionalAttributes { get; set; }

	[Parameter] public BadgeSize Size { get; set; } = BadgeSize.Md;
	[Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Default;
	[Parameter] public BadgeColor ColorScheme { get; set; } = BadgeColor.Neutral;

	private string CssClass => CssClassBuilder.Start( "inline-flex items-center justify-center w-fit whitespace-nowrap shrink-0 [&>svg]:size-3 gap-1 [&>svg]:pointer-events-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive transition-[color,box-shadow] overflow-hidden" )
										.With( "px-2", !CssClassBuilder.ContainsAny( ClassName, "px-", "p-" ) )
										.With( "rounded", !CssClassBuilder.ContainsAny( ClassName, "rounded" ) )
										.With( "font-normal", Variant is BadgeVariant.Default )
										.With( "uppercase font-bold", Variant is BadgeVariant.Bold )
										.With( "text-sm", Size is BadgeSize.Sm )
										.With( "h-4", Size is BadgeSize.Sm && !CssClassBuilder.ContainsAny( ClassName, "h-" ) )
										.With( "text-md", Size is BadgeSize.Md )
										.With( "h-5", Size is BadgeSize.Md && !CssClassBuilder.ContainsAny( ClassName, "h-" ) )
										.With( "text-md", Size is BadgeSize.Lg )
										.With( "h-6", Size is BadgeSize.Lg && !CssClassBuilder.ContainsAny( ClassName, "h-" ) )
										.With( "bg-neutral-bg text-neutral-fg", ColorScheme is BadgeColor.Neutral )
										.With( "bg-primary-bg text-primary-fg", ColorScheme is BadgeColor.Primary )
										.With( "bg-danger-bg text-danger-fg", ColorScheme is BadgeColor.Danger )
										.With( "bg-success-bg text-success-fg", ColorScheme is BadgeColor.Success )
										.With( "bg-warning-bg text-warning-fg", ColorScheme is BadgeColor.Warning )
										.With( "bg-yellow-100 text-yellow-800 dark:bg-yellow-800 dark:text-yellow-200", ColorScheme is BadgeColor.Yellow )
										.With( "bg-teal-100 text-teal-800 dark:bg-teal-800 dark:text-teal-200", ColorScheme is BadgeColor.Teal )
										.With( "bg-cyan-100 text-cyan-800 dark:bg-cyan-800 dark:text-cyan-200", ColorScheme is BadgeColor.Cyan )
										.With( "bg-blue-100 text-blue-800 dark:bg-blue-800 dark:text-blue-200", ColorScheme is BadgeColor.Blue )
										.With( "bg-pink-100 text-pink-800 dark:bg-pink-800 dark:text-pink-200", ColorScheme is BadgeColor.Pink )
										.With( ClassName )
										.Build();
}

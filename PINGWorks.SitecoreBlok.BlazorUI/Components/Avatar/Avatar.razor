@namespace PINGWorks.SitecoreBlok.BlazorUI

<span data-slot="avatar" class="@CssClass" @attributes="AdditionalAttributes">
	<CascadingValue Value="this">
		@ChildContent
	</CascadingValue>
</span>

@code {
	[Parameter] public string? ClassName { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter( CaptureUnmatchedValues = true )] public Dictionary<string, object>? AdditionalAttributes { get; set; }

	internal AvatarImageStatus ImageStatus { get; private set; } = AvatarImageStatus.Idle;

	internal async Task SetImageStatus( AvatarImageStatus status )
	{
		if ( ImageStatus == status ) return;

		ImageStatus = status;

		await InvokeAsync( StateHasChanged );
	}

	private string CssClass => CssClassBuilder.Start( "relative flex size-8 shrink-0 overflow-hidden rounded-full" )
											.With( ClassName )
											.Build();
}

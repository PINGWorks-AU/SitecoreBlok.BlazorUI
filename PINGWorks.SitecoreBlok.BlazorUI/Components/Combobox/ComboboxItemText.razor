@namespace PINGWorks.SitecoreBlok.BlazorUI

<div data-slot="combobox-item-text" class="@CssClass">
	@ChildContent
</div>

@code {
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? ClassName { get; set; }

	private string CssClass => CssClassBuilder.Start( "flex min-w-0 flex-1 flex-col gap-0.5" )
											.With( ClassName )
											.Build();
}
